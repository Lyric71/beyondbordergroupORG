---
import Layout from '../layouts/Layout.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'AI native, both sides of the wall';
const description =
  'BearingBridge runs AI native: cross-border marketing between China and the West, AI consulting, and AIGC production. Two model ecosystems, one group.';

const linkedinUrl = 'https://www.linkedin.com/in/cyril-d-68835729/';

const beats = ['We advise on it.', 'We use it every day.', 'We live on it.', 'We grow on it with our clients.'];

const stats = [
  {
    number: '87%',
    label: 'of marketers use generative AI as of Q1 2026, up from 51% two years earlier',
    source: 'Salesforce State of Marketing 2026',
  },
  {
    number: '70%',
    label: 'cut in advertising production time and cost at Nestlé, scaling AI digital twins',
    source: 'Nvidia, 2026',
  },
  {
    number: '602M',
    label: 'generative AI users in China by December 2025, up 141.7% in one year',
    source: 'CNNIC, February 2026',
  },
  {
    number: '60 to 90%',
    label: 'cheaper: what open Chinese models can run versus leading Western ones',
    source: 'OpenRouter data via CNBC, July 2026',
  },
];

const shifts = [
  {
    title: 'More with less',
    body: "A small senior team with a full AI stack now does what used to take departments: research, positioning, copy in the client's languages, design systems, video, working code. We do not bill hours for work machines finish in minutes. Scopes and retainers are priced on outcomes and volume, not headcount.",
  },
  {
    title: 'Faster',
    body: 'Work that took a quarter now takes weeks, and the weeks are turning into days. Production is rarely the bottleneck now. Approval is. So we rebuilt our review loops along with our production, on a single weekly cadence wherever a client lets us.',
  },
  {
    title: 'More audiences',
    body: 'When the cost of one more variant collapses, markets that never justified the budget suddenly do. More languages. More platforms and formats than the old budget ever covered. A mid-size brand can now run a multi-market program that used to require a holding company.',
  },
];

const practices = [
  {
    title: 'AI Services',
    href: pathFor('ai-services', locale),
    body: 'The stack itself: AI consulting, our Intelligence platform, AIGC production, and LinkedIn B2B, from strategy through production.',
  },
  {
    title: 'Cross-Border Marketing',
    href: pathFor('cross-border-marketing', locale),
    body: 'The stack under market pressure: five agencies carrying brands between China and the West, in both directions, every day.',
  },
  {
    title: 'Products',
    href: pathFor('products', locale),
    body: 'The stack with our own money at stake: media and software we own and operate.',
  },
];
---

<Layout locale={locale} route="the-group" title={title} description={description}>
  <!-- 1 · Hero + 2 · Engine: one continuous black opening -->
  <section class="group-hero">
    <div class="container group-hero__intro">
      <span class="eyebrow eyebrow--on-dark eyebrow--rule">The group</span>
      <h1 class="group-hero__title balance">AI changed the agency job.<br />We rebuilt the group around it.</h1>
      <p class="group-hero__lead">
        AI is changing the way everything gets made: strategy, content, media, websites, commerce. An
        agency that treats it as a side project is quoting yesterday's prices for yesterday's work.
      </p>
    </div>
  </section>

  <section class="group-engine" id="engine">
    <div class="container">
      <h2 class="group-engine__display balance" data-reveal>AI is now our core engine.</h2>
      <div class="group-engine__grid">
        {beats.map((beat, i) => (
          <div class="group-engine__card" style={`--card-i: ${i}`} data-reveal>
            <p>{beat}</p>
          </div>
        ))}
      </div>
      <p class="group-engine__support" data-reveal>
        We have no AI department, because we have no non-AI department. Every brief in this group, from a
        Tmall flagship launch to a LinkedIn program, runs through the same stack we sell.
      </p>
    </div>
  </section>

  <!-- 3 · Proof strip: open editorial numbers, no boxes -->
  <section class="section" id="proof">
    <div class="container">
      <div class="proof-head" data-reveal>
        <h2 class="balance">The job has already changed</h2>
        <p class="lead">
          Nobody argues anymore about whether AI belongs in marketing. The biggest advertisers are
          building the capability in-house and repricing the work. The open question is what an agency
          does with the hours it gives back.
        </p>
      </div>
      <div class="proof-strip" data-reveal>
        {stats.map((s) => (
          <div class="proof-stat">
            <span class="proof-stat__number">{s.number}</span>
            <p class="proof-stat__label">{s.label}</p>
            <p class="proof-stat__source">{s.source}</p>
          </div>
        ))}
      </div>
      <blockquote class="proof-quote" data-reveal>
        Unilever now produces brand imagery twice as fast at half the cost using AI and digital twins.
        <footer class="proof-quote__source">Nvidia, 2026</footer>
      </blockquote>
    </div>
  </section>

  <!-- 4 · Three shifts: hairline columns, emphasized kicker -->
  <section class="section section--alt" id="shifts">
    <div class="container">
      <h2 class="balance" data-reveal>What changed for us</h2>
      <div class="shifts" data-reveal>
        {shifts.map((shift) => (
          <div class="shifts__col">
            <h3>{shift.title}</h3>
            <p>{shift.body}</p>
          </div>
        ))}
      </div>
      <p class="shifts-kicker" data-reveal>
        Localization used to be the expensive part of entering China or leaving it. Now the expensive part
        is judgment: which platform, which claim, which price, which partner. That is the part we sell, and
        the part we do not hand to a machine.
      </p>
    </div>
  </section>

  <!-- 5 · Both sides of the wall: image-led dark interlude -->
  <section class="wall-section" id="wall">
    <div class="container">
      <h2 class="wall-title balance" data-reveal>Both sides of the wall</h2>
      <div class="wall-stage" data-reveal>
        <img
          class="wall-stage__img"
          src="/images/the-group-wall.webp"
          alt="Two glowing cities divided by a dark wall, one lit blue and one lit red, joined by a single bridge of light."
          width="1050"
          height="620"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="wall-split" data-reveal>
        <div class="wall-panel wall-panel--west">
          <span class="wall-panel__label">West</span>
          <ul class="wall-panel__list">
            <li>GPT</li>
            <li>Claude</li>
            <li>Gemini</li>
          </ul>
        </div>
        <div class="wall-panel__rule" aria-hidden="true"></div>
        <div class="wall-panel wall-panel--china">
          <span class="wall-panel__label">China</span>
          <ul class="wall-panel__list">
            <li>Qwen</li>
            <li>DeepSeek</li>
            <li>Doubao</li>
            <li>Kimi</li>
          </ul>
        </div>
      </div>
      <div class="wall-after" data-reveal>
        <p class="lead">
          Two AI ecosystems are growing up on either side of the wall. Our AI teams benchmark them against
          each other on real tasks, month after month, because the ranking does not hold still. We hold no
          allegiance to either side. We pick whatever wins the task at a price the market can carry. The
          same neutrality applies to our advice. We take Western brands into China and Chinese brands into
          the West, and we sit on both sides of the wall while we do it.
        </p>
        <a class="arrow-link arrow-link--light" href={pathFor('bridge', locale)}>The longer version of this argument is on the bridge.</a>
      </div>
    </div>
  </section>

  <!-- 6 · Three practices, one stack: index rows -->
  <section class="section" id="practices">
    <div class="container">
      <header class="section-header" data-reveal>
        <h2 class="balance">None of this is theory. Here is where it runs.</h2>
      </header>
      <div class="practice-rows" data-reveal>
        {practices.map((p) => (
          <a class="practice-row" href={p.href}>
            <h3 class="practice-row__title">{p.title}</h3>
            <p class="practice-row__body">{p.body}</p>
            <span class="practice-row__disc" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </span>
          </a>
        ))}
      </div>
      <p class="practices-closer" data-reveal>
        Whatever we recommend to a client has already run on our own business. If it breaks, it breaks on
        us first.
      </p>
      <a class="arrow-link" href={pathFor('how-we-work', locale)} data-reveal>The mechanics are on how we work.</a>
    </div>
  </section>

  <!-- 7 · The operator -->
  <section class="section section--alt" id="operator">
    <div class="container">
      <div class="split split--media-first operator-split" data-reveal>
        <div>
          <a class="operator-frame" href={linkedinUrl} target="_blank" rel="noreferrer" aria-label="Cyril Drouin on LinkedIn">
            <img
              src="/Team/CyrilDrouin.jpg"
              alt="Cyril Drouin, founder of BearingBridge."
              width="1905"
              height="2560"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
        <div>
          <h2 class="balance">The operator</h2>
          <p class="lead">
            BearingBridge is founded and led by Cyril Drouin. Digital, eCommerce, and brand, across Europe
            and North Asia. Former Chief Digital and eCommerce Officer, Publicis Groupe North Asia. Founder
            of BysoftChina. He rebuilt this group around AI because he has watched every previous platform
            shift punish the agencies that moved last.
          </p>
          <a class="arrow-link" href={linkedinUrl} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 · Where we are -->
  <section class="footprint" id="footprint">
    <div class="container center" data-reveal>
      <h2 class="footprint__heading">Where we are</h2>
      <p class="footprint__cities balance">
        Shanghai · Hong Kong · Singapore · Paris · Hangzhou, with in-market reps in the US, UK, Germany,
        and France.
      </p>
      <p class="footprint__langs">
        We work in English, French, Spanish, German, and Chinese, on a working day that overlaps China and
        Europe.
      </p>
    </div>
  </section>

  <!-- 9 · CTA -->
  <section class="section section--alt" id="cta">
    <div class="container container--narrow center" data-reveal>
      <h2 class="balance">Start with the practice you need.</h2>
      <p class="lead" style="margin-inline: auto;">
        Thirty minutes on a call. We will point you to the right practice and the right team inside it, and
        we reply within one working day, Shanghai or Paris time.
      </p>
      <div class="group-cta__row">
        <a class="pill-cta" href={pathFor('contact', locale)}>
          Book a call
          <span class="pill-cta__disc" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hallmark · redesign in-system · macrostructure: marquee-open + stat-strip · theme: site tokens (BearingBridge) */

  /* ---------- 1 · Hero: deep black with the two-sides glow ---------- */
  .group-hero {
    position: relative;
    background:
      radial-gradient(620px 460px at 10% -12%, rgba(38, 154, 218, 0.2), transparent 65%),
      radial-gradient(680px 500px at 94% 20%, rgba(200, 16, 46, 0.13), transparent 65%),
      #050505;
    color: #fff;
    padding-top: calc(var(--space-9, 7.5rem) + 24px);
    padding-bottom: var(--space-7, 4rem);
    overflow: hidden;
  }
  .group-hero__title {
    color: #fff;
    font-size: clamp(2.5rem, 5.4vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 650;
    margin: 0 0 var(--space-5);
  }
  .group-hero__lead {
    max-width: 58ch;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .group-hero__intro > * {
      opacity: 0;
      transform: translateY(26px);
      animation: group-rise 0.9s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }
    .group-hero__intro > *:nth-child(1) { animation-delay: 0.05s; }
    .group-hero__intro > *:nth-child(2) { animation-delay: 0.16s; }
    .group-hero__intro > *:nth-child(3) { animation-delay: 0.27s; }
  }
  @keyframes group-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---------- 2 · Engine: glass panels continuing the black band ---------- */
  .group-engine {
    background: #050505;
    color: #fff;
    padding: var(--space-6) 0 var(--space-9);
  }
  .group-engine__display {
    color: #fff;
    font-size: clamp(1.9rem, 3vw + 0.4rem, 3rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
  .group-engine__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .group-engine__card {
    padding: 6px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09);
    transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1), box-shadow 0.6s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .group-engine__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18), 0 26px 50px -30px rgba(0, 0, 0, 0.9);
  }
  .group-engine__card p {
    margin: 0;
    min-height: 108px;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    border-radius: 17px;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .group-engine__support {
    margin-top: var(--space-5);
    max-width: 66ch;
    color: rgba(255, 255, 255, 0.62);
  }
  @media (max-width: 900px) {
    .group-engine__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .group-engine__grid { grid-template-columns: 1fr; }
    .group-engine__card p { min-height: 0; }
  }

  /* ---------- 3 · Proof strip: open numbers over hairlines ---------- */
  .proof-head { max-width: 760px; margin-bottom: var(--space-7); }
  .proof-head h2 { margin-bottom: var(--space-4); }
  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
  }
  .proof-stat {
    border-top: 2px solid var(--bbg-ink);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .proof-stat__number {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 3.4vw + 0.5rem, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--bbg-ink);
    white-space: nowrap;
  }
  .proof-stat__label {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--bbg-text);
    max-width: 26ch;
  }
  .proof-stat__source {
    margin: 0;
    margin-top: auto;
    font-size: var(--fs-label);
    letter-spacing: 0.02em;
    color: var(--bbg-text-muted);
  }
  .proof-quote {
    display: none;
    margin: var(--space-7) 0 0;
    max-width: 56ch;
  }
  .proof-quote__source {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    font-style: normal;
    color: var(--bbg-text-muted);
  }
  @media (min-width: 1024px) {
    .proof-quote { display: block; }
  }
  @media (max-width: 1023px) {
    .proof-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .proof-strip { grid-template-columns: 1fr; }
    .proof-stat__number { font-size: 2.6rem; }
  }

  /* ---------- 4 · Three shifts: hairline columns ---------- */
  .shifts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .shifts__col h3 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-3);
  }
  .shifts__col p {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--bbg-text);
  }
  @media (min-width: 901px) {
    .shifts__col + .shifts__col {
      border-left: 1px solid var(--bbg-border);
      padding-left: var(--space-6);
    }
  }
  .shifts-kicker {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px solid var(--bbg-ink);
    max-width: 76ch;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    font-weight: 500;
    color: var(--bbg-ink);
  }
  @media (max-width: 900px) {
    .shifts { grid-template-columns: 1fr; gap: var(--space-5); }
    .shifts__col + .shifts__col {
      border-top: 1px solid var(--bbg-border);
      padding-top: var(--space-5);
    }
  }

  /* ---------- 5 · The wall: dark interlude ---------- */
  .wall-section {
    background: #050505;
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-9) 0;
  }
  .wall-title {
    color: #fff;
    margin-bottom: var(--space-6);
  }
  .wall-stage {
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .wall-stage__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .wall-split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: 0 var(--space-4);
  }
  .wall-panel__label {
    display: block;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }
  .wall-panel--west { text-align: right; }
  .wall-panel--west .wall-panel__label { color: #7cc4ec; }
  .wall-panel--china .wall-panel__label { color: #ef8b9b; }
  .wall-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .wall-panel__rule {
    width: 2px;
    border-radius: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.85), transparent);
  }
  .wall-after {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    align-items: end;
    margin-top: var(--space-7);
  }
  .wall-after .lead { max-width: 62ch; color: rgba(255, 255, 255, 0.78); }
  @media (max-width: 900px) {
    .wall-split { grid-template-columns: 1fr; gap: var(--space-4); padding: 0; }
    .wall-panel--west { text-align: left; }
    .wall-panel__rule { width: 100%; height: 2px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.85), transparent); }
    .wall-after { grid-template-columns: 1fr; align-items: start; }
  }

  /* ---------- Arrow links ---------- */
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--bbg-blue);
  }
  .arrow-link::after {
    content: "→";
    transition: transform var(--dur) var(--ease);
  }
  .arrow-link:hover::after { transform: translateX(4px); }
  .arrow-link--light { color: #7cc4ec; justify-self: end; }
  .arrow-link--light:hover { color: #a8d8f3; }
  @media (max-width: 900px) {
    .arrow-link--light { justify-self: start; }
  }

  /* ---------- 6 · Practices: index rows ---------- */
  .practice-rows {
    border-top: 1px solid var(--bbg-border);
  }
  .practice-row {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr auto;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--bbg-border);
    color: var(--bbg-text);
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .practice-row:hover { background: var(--bbg-surface); }
  .practice-row__title {
    margin: 0;
    font-size: var(--fs-h3);
    color: var(--bbg-ink);
    transition: color var(--dur) var(--ease);
  }
  .practice-row:hover .practice-row__title { color: var(--bbg-blue); }
  .practice-row__body {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--bbg-text);
    max-width: 56ch;
  }
  .practice-row__disc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--bbg-surface);
    border: 1px solid var(--bbg-border);
    color: var(--bbg-ink);
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .practice-row:hover .practice-row__disc {
    transform: translateX(4px);
    background: var(--bbg-blue);
    border-color: var(--bbg-blue);
    color: #fff;
  }
  @media (max-width: 800px) {
    .practice-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'title disc' 'body body';
      gap: var(--space-3);
      padding: var(--space-4) 0;
    }
    .practice-row__title { grid-area: title; }
    .practice-row__body { grid-area: body; }
    .practice-row__disc { grid-area: disc; }
  }
  .practices-closer {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    max-width: 62ch;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    font-weight: 500;
    color: var(--bbg-ink);
  }

