---
import Layout from '../layouts/Layout.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'AI native, both sides of the wall';
const description =
  'BearingBridge runs AI native: cross-border marketing between China and the West, AI consulting, and AIGC production. Two model ecosystems, one group.';

const linkedinUrl = 'https://www.linkedin.com/in/cyril-d-68835729/';

const stats = [
  {
    number: '87%',
    label: 'of marketers use generative AI as of Q1 2026, up from 51% two years earlier',
    source: 'Salesforce State of Marketing 2026',
    span: 'wide',
  },
  {
    number: '70%',
    label: 'cut in advertising production time and cost at Nestlé, scaling AI digital twins',
    source: 'Nvidia, 2026',
    span: 'narrow',
  },
  {
    number: '602M',
    label: 'generative AI users in China by December 2025, up 141.7% in one year',
    source: 'CNNIC, February 2026',
    span: 'narrow',
  },
  {
    number: '60 to 90%',
    label: 'cheaper: what open Chinese models can run versus leading Western ones',
    source: 'OpenRouter data via CNBC, July 2026',
    span: 'wide',
  },
];

const shifts = [
  {
    title: 'More with less',
    body: "A small senior team with a full AI stack now does what used to take departments: research, positioning, copy in the client's languages, design systems, video, working code. We do not bill hours for work machines finish in minutes. Scopes and retainers are priced on outcomes and volume, not headcount.",
  },
  {
    title: 'Faster',
    body: 'Work that took a quarter now takes weeks, and the weeks are turning into days. Production is rarely the bottleneck now. Approval is. So we rebuilt our review loops along with our production, on a single weekly cadence wherever a client lets us.',
  },
  {
    title: 'More audiences',
    body: 'When the cost of one more variant collapses, markets that never justified the budget suddenly do. More languages. More platforms and formats than the old budget ever covered. A mid-size brand can now run a multi-market program that used to require a holding company.',
  },
];

const practices = [
  {
    title: 'AI Services',
    href: pathFor('ai-services', locale),
    body: 'The stack itself: AI consulting, our Intelligence platform, AIGC production, and LinkedIn B2B, from strategy through production.',
  },
  {
    title: 'Cross-Border Marketing',
    href: pathFor('cross-border-marketing', locale),
    body: 'The stack under market pressure: five agencies carrying brands between China and the West, in both directions, every day.',
  },
  {
    title: 'Products',
    href: pathFor('products', locale),
    body: 'The stack with our own money at stake: media and software we own and operate.',
  },
];
---

<Layout locale={locale} route="the-group" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <span class="min-tag min-tag--blue" data-reveal>The group</span>
        <h1 class="min-hero__title" data-reveal style="--i: 1">AI changed the agency job. We rebuilt the group around it.</h1>
        <p class="min-hero__lead" data-reveal style="--i: 2">
          AI is changing the way everything gets made: strategy, content, media, websites, commerce. An
          agency that treats it as a side project is quoting yesterday's prices for yesterday's work.
        </p>
      </div>
    </section>

    <!-- 2 · The engine -->
    <section class="min-sec" id="engine">
      <div class="min-wrap">
        <div class="min-split min-split--reverse group-engine__head" data-reveal>
          <h2 class="min-h2">AI is now our core engine.</h2>
          <figure class="min-photo min-photo--wide">
            <img
              src="/images/photo-ai-coding.webp"
              alt="A developer's monitor showing an AI coding assistant writing and testing code."
              width="1050"
              height="620"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
        <div class="min-grid-4">
          <div class="min-card group-beat" data-reveal>
            <span class="group-beat__mark group-beat__mark--blue" aria-hidden="true"></span>
            <p>We advise on it.</p>
          </div>
          <div class="min-card group-beat" data-reveal style="--i: 1">
            <span class="group-beat__mark group-beat__mark--green" aria-hidden="true"></span>
            <p>We use it every day.</p>
          </div>
          <div class="min-card group-beat" data-reveal style="--i: 2">
            <span class="group-beat__mark group-beat__mark--yellow" aria-hidden="true"></span>
            <p>We live on it.</p>
          </div>
          <div class="min-card group-beat" data-reveal style="--i: 3">
            <span class="group-beat__mark group-beat__mark--red" aria-hidden="true"></span>
            <p>We grow on it with our clients.</p>
          </div>
        </div>
        <p class="min-muted group-support" data-reveal>
          We have no AI department, because we have no non-AI department. Every brief in this group, from a
          Tmall flagship launch to a LinkedIn program, runs through the same stack we sell.
        </p>
      </div>
    </section>

    <!-- 3 · Proof strip -->
    <section class="min-sec min-sec--ruled" id="proof">
      <div class="min-wrap">
        <div data-reveal>
          <span class="min-tag min-tag--yellow">The job has already changed</span>
          <p class="min-lead">
            Nobody argues anymore about whether AI belongs in marketing. The biggest advertisers are
            building the capability in-house and repricing the work. The open question is what an agency
            does with the hours it gives back.
          </p>
        </div>
        <div class="group-stats">
          {stats.map((s, i) => (
            <div class={`min-card min-stat group-stat--${s.span}`} data-reveal style={`--i: ${i}`}>
              <span class="min-stat__number">{s.number}</span>
              <p class="min-stat__label">{s.label}</p>
              <p class="min-stat__source">{s.source}</p>
            </div>
          ))}
        </div>
        <blockquote class="min-serif-quote group-quote" data-reveal>
          Unilever now produces brand imagery twice as fast at half the cost using AI and digital twins.
          <footer class="min-meta group-quote__source">Nvidia, 2026</footer>
        </blockquote>
      </div>
    </section>

    <!-- 4 · Three shifts -->
    <section class="min-sec min-sec--ruled" id="shifts">
      <div class="min-wrap">
        <span class="min-tag min-tag--green" data-reveal>What changed for us</span>
        <div class="min-grid-3">
          {shifts.map((shift, i) => (
            <div class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{shift.title}</h3>
              <p class="min-small">{shift.body}</p>
            </div>
          ))}
        </div>
        <p class="min-kicker" data-reveal>
          Localization used to be the expensive part of entering China or leaving it. Now the expensive
          part is judgment: which platform, which claim, which price, which partner. That is the part we
          sell, and the part we do not hand to a machine.
        </p>
      </div>
    </section>

    <!-- 5 · Both sides of the wall -->
    <section class="min-sec min-sec--ruled" id="wall">
      <div class="min-wrap">
        <span class="min-tag min-tag--blue" data-reveal>Both sides of the wall</span>
        <figure class="min-photo min-photo--wide group-wall__photo" data-reveal>
          <img
            src="/images/photo-wall.webp"
            alt="The Great Wall of China winding over misty ridges at golden hour."
            width="1050"
            height="620"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="group-wall" data-reveal>
          <div class="group-wall__side group-wall__side--west">
            <span class="min-tag min-tag--blue">West</span>
            <ul class="group-wall__list">
              <li>GPT</li>
              <li>Claude</li>
              <li>Gemini</li>
            </ul>
          </div>
          <div class="group-wall__rule" aria-hidden="true"></div>
          <div class="group-wall__side">
            <span class="min-tag min-tag--red">China</span>
            <ul class="group-wall__list">
              <li>Qwen</li>
              <li>DeepSeek</li>
              <li>Doubao</li>
              <li>Kimi</li>
            </ul>
          </div>
        </div>
        <p class="min-body group-wall__body" data-reveal>
          Two AI ecosystems are growing up on either side of the wall. Our AI teams benchmark them against
          each other on real tasks, month after month, because the ranking does not hold still. We hold no
          allegiance to either side. We pick whatever wins the task at a price the market can carry. The
          same neutrality applies to our advice. We take Western brands into China and Chinese brands into
          the West, and we sit on both sides of the wall while we do it.
        </p>
        <a class="min-link" href={pathFor('bridge', locale)} data-reveal>The longer version of this argument is on the bridge.</a>
      </div>
    </section>

    <!-- 6 · Three practices, one stack -->
    <section class="min-sec min-sec--ruled" id="practices">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>None of this is theory. Here is where it runs.</h2>
        <div class="min-index" data-reveal>
          {practices.map((p) => (
            <a class="min-index__row" href={p.href}>
              <h3 class="min-index__title">{p.title}</h3>
              <p class="min-index__body">{p.body}</p>
              <span class="min-index__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <p class="min-kicker group-closer" data-reveal>
          Whatever we recommend to a client has already run on our own business. If it breaks, it breaks
          on us first.
        </p>
        <a class="min-link" href={pathFor('how-we-work', locale)} data-reveal>The mechanics are on how we work.</a>
      </div>
    </section>

    <!-- 7 · The operator -->
    <section class="min-sec min-sec--ruled" id="operator">
      <div class="min-wrap">
        <div class="group-operator" data-reveal>
          <a class="min-photo min-photo--tall group-operator__photo" href={linkedinUrl} target="_blank" rel="noreferrer" aria-label="Cyril Drouin on LinkedIn">
            <img
              src="/Team/CyrilDrouin.jpg"
              alt="Cyril Drouin, founder of BearingBridge."
              width="1905"
              height="2560"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div>
            <span class="min-tag min-tag--yellow">The operator</span>
            <p class="min-body group-operator__bio">
              BearingBridge is founded and led by Cyril Drouin. Digital, eCommerce, and brand, across
              Europe and North Asia. Former Chief Digital and eCommerce Officer, Publicis Groupe North
              Asia. Founder of BysoftChina. He rebuilt this group around AI because he has watched every
              previous platform shift punish the agencies that moved last.
            </p>
            <a class="min-btn" href={linkedinUrl} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · Where we are -->
    <section class="min-sec min-sec--ruled" id="footprint">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <span class="min-tag min-tag--green">Where we are</span>
        <p class="group-cities">
          Shanghai · Hong Kong · Singapore · Paris · Hangzhou, with in-market reps in the US, UK, Germany,
          and France.
        </p>
        <p class="min-muted group-langs">
          We work in English, French, Spanish, German, and Chinese, on a working day that overlaps China
          and Europe.
        </p>
      </div>
    </section>

    <!-- 9 · CTA -->
    <section class="min-sec min-sec--ruled" id="cta">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 group-cta__title">Start with the practice you need.</h2>
        <p class="min-body group-cta__body">
          Thirty minutes on a call. We will point you to the right practice and the right team inside it,
          and we reply within one working day, Shanghai or Paris time.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .group-engine__head { margin-bottom: var(--space-5); align-items: center; }
  .group-engine__head .min-h2 { margin-bottom: 0; }
  .group-engine__head .min-photo { max-width: 440px; justify-self: end; width: 100%; }
  @media (max-width: 900px) {
    .group-engine__head .min-photo { justify-self: start; max-width: 100%; }
  }

  .group-beat { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); }
  .group-beat p {
    margin: 0;
    font-weight: 550;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .group-beat__mark { width: 12px; height: 12px; border-radius: 3px; }
  .group-beat__mark--blue { background: #a8d5f0; }
  .group-beat__mark--green { background: #b5cfb3; }
  .group-beat__mark--yellow { background: #ecd9a0; }
  .group-beat__mark--red { background: #f0c1c3; }
  .group-support { margin-top: var(--space-4); }

  .group-stats {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .group-stat--wide { grid-column: span 7; }
  .group-stat--narrow { grid-column: span 5; }
  @media (max-width: 900px) {
    .group-stats { display: flex; flex-direction: column; }
  }
  .group-quote { margin-top: var(--space-6); display: none; }
  .group-quote__source { margin-top: var(--space-2); }
  @media (min-width: 1024px) {
    .group-quote { display: block; }
  }

  .group-wall__photo {
    max-width: 760px;
    margin: var(--space-2) auto var(--space-5);
  }
  .group-wall {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-6);
    max-width: 680px;
    margin: 0 auto var(--space-5);
  }
  .group-wall__side--west { text-align: right; }
  .group-wall__list {
    list-style: none;
    margin: var(--space-1, 0.25rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .group-wall__rule { width: 1px; background: var(--line); }
  .group-wall__body { margin: 0 0 var(--space-4); }
  @media (max-width: 700px) {
    .group-wall { grid-template-columns: 1fr; gap: var(--space-4); }
    .group-wall__side--west { text-align: left; }
    .group-wall__rule { width: 100%; height: 1px; }
  }

  .group-closer { margin-top: var(--space-5); margin-bottom: var(--space-4); }

  .group-operator {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  .group-operator__photo img { object-position: center top; }
  .group-operator__bio { margin: 0 0 var(--space-4); }
  @media (max-width: 800px) {
    .group-operator { grid-template-columns: 1fr; gap: var(--space-4); }
    .group-operator__photo { max-width: 260px; }
  }

  .group-cities {
    margin: 0 auto var(--space-3);
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.4vw, 1.95rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 32ch;
  }
  .group-langs { margin-inline: auto; max-width: 58ch; }

  .group-cta__title { margin-inline: auto; }
  .group-cta__body { margin: 0 auto var(--space-5); }
</style>
