---
import Layout from '../../layouts/Layout.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const title = 'Intelligence: see AI at work';
const description = 'AI modules and agents running on real tasks, every cost visible as it runs. Marketing, Sales, and Project Management ready today. Your function next.';

const modules = [
  {
    name: 'Marketing',
    body: 'Content from roadmap to live page, with the company knowledge built in, so a launch can go live in every market language the same morning.',
  },
  {
    name: 'Sales',
    body: 'Campaigns that know what has already run and which features to push. Hundreds of ad variants, tested instead of debated, with spend visible live.',
  },
  {
    name: 'Project Management',
    body: 'Delivery status assembled from the tools your teams use. Monday status writes itself, and the meeting covers only what slipped.',
  },
];
---

<Layout locale={locale} route="ai-services/intelligence" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <span class="min-tag min-tag--blue" data-reveal>Intelligence, a BearingBridge platform</span>
        <h1 class="min-hero__title" data-reveal style="--i: 1">See AI at work. Before you commit to it.</h1>
        <p class="min-hero__lead" data-reveal style="--i: 2">
          A slide deck tells you what AI might do. A working platform shows you. Intelligence is the set of
          modules and agents we have already built, doing actual work, with the cost visible on screen the
          whole time. Unlike the general chatbots you already pay for, they arrive knowing your function and
          plug into the systems you run today: ERP, CRM, helpdesk, ad accounts. It is built for teams taking
          AI seriously.
        </p>
        <div class="min-ctas intel-hero__ctas" data-reveal style="--i: 3">
          <a class="min-btn" href={pathFor('contact', locale)}>Ask for a walkthrough</a>
          <a class="min-btn min-btn--ghost" href="https://intelligence.bearingbridge.ai" target="_blank" rel="noreferrer">Open the platform ↗</a>
        </div>
      </div>
    </section>

    <!-- 2 · Platform visual -->
    <section class="min-sec">
      <div class="min-wrap">
        <figure class="intel-shot" data-reveal>
          <div class="min-photo">
            <img
              src="/images/intelligence-platform.webp"
              alt="The Intelligence platform running a task, with the live cost counter on screen."
              loading="lazy"
              decoding="async"
              width="1050"
              height="620"
            />
          </div>
          <figcaption class="min-muted intel-shot__caption">The platform, as it runs today.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3 · Modules -->
    <section class="min-sec min-sec--ruled" id="modules">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Running today.</h2>
          <p class="min-lead">
            Start where a win would be felt fastest. For most companies that is Marketing or Sales. Each
            module works out of the box, or we tailor it to your data and tools.
          </p>
        </div>

        <div class="min-grid-3 intel-modules">
          {modules.map((m, i) => (
            <div class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{m.name}</h3>
              <p class="min-small">{m.body}</p>
            </div>
          ))}
        </div>

        <p class="min-muted intel-modules__more" data-reveal>
          And if your function is not on that list, the same foundation gets wired into the systems your team
          already opens every morning. Your data stays yours, and residency is decided with you up front.
        </p>
      </div>
    </section>

    <!-- 4 · Cost -->
    <section class="min-sec min-sec--ruled" id="cost">
      <div class="min-wrap">
        <div class="min-split" data-reveal>
          <figure class="min-photo min-photo--wide">
            <img
              src="/images/photo-intelligence.webp"
              alt="Hands typing on a laptop at a warm wooden desk."
              width="1050"
              height="620"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <h2 class="min-h2">Every cost on screen.</h2>
            <p class="min-body min-split__body">
              There is no estimate deck and no invoice surprise at quarter end. You watch each run and what it
              costs, live, which is how we think AI should be bought.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 intel-cta__title">Start with one module.</h2>
        <p class="min-body intel-cta__body">
          Pick the function where the pain is loudest. We show you the module running on a real task. The
          platform lives at intelligence.bearingbridge.ai. If it holds up, the next step is the same module
          on your data, scoped and priced in writing before anything is built. Intelligence is a
          BearingBridge product. Tailoring runs through <a href={pathFor('ai-services', locale)}>BearingBridge AI</a>,
          the consulting team that built and operates it.
        </p>
        <div class="min-ctas intel-cta__btns">
          <a class="min-btn min-btn--ghost" href="https://intelligence.bearingbridge.ai" target="_blank" rel="noreferrer">Open the platform ↗</a>
          <a class="min-btn" href={pathFor('contact', locale)}>Ask for a walkthrough</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .intel-hero__ctas { margin-top: var(--space-5); }

  .intel-shot {
    margin: 0 auto;
    max-width: 920px;
  }
  .intel-shot__caption { margin-top: var(--space-3); }

  .intel-modules { margin-top: var(--space-5); }
  .intel-modules__more { margin-top: var(--space-4); max-width: 68ch; }

  .intel-cta__title { margin-inline: auto; }
  .intel-cta__body { margin: 0 auto var(--space-5); }
  .intel-cta__body a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: 1px solid var(--line);
    transition: border-color 200ms ease;
  }
  .intel-cta__body a:hover { border-color: var(--ink); }
  .intel-cta__btns { justify-content: center; }
</style>
