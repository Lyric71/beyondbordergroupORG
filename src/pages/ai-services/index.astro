---
import Layout from '../../layouts/Layout.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const title = 'AI consulting and production';
const description = 'AI consulting and training on evidence, not hype. Intelligence, our platform where you watch AI work. Western and Chinese models, benchmarked.';
---

<Layout locale={locale} route="ai-services" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="min-hero__grid">
          <div>
            <h1 class="min-hero__title" data-reveal>AI, applied. Not admired.</h1>
            <p class="min-hero__lead" data-reveal style="--i: 1">
              Built for companies that want AI earning its keep, from mid-size teams to groups selling across
              beauty, automotive, food and beverage, and industrial goods.
            </p>
            <p class="min-hero__lead ai-hero__second" data-reveal style="--i: 2">
              Three teams and one platform, sharing one stance: evidence over hype. We measure before we
              recommend. We benchmark Western and Chinese models side by side, then put the result into
              production on your data. And we run <a href={pathFor('products', locale)}>our own products</a> on
              this same stack, in public.
            </p>
          </div>
          <figure class="min-photo min-photo--cover" data-reveal style="--i: 1">
            <img
              src="/images/photo-practice-ai.webp"
              alt="Three colleagues reviewing work on a laptop in a bright office."
              width="1050"
              height="620"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- 2 · Stance -->
    <section class="min-sec" id="stance">
      <div class="min-wrap min-narrow" data-reveal>
        <h2 class="min-h2">Both sides of the wall.</h2>
        <p class="min-body">
          The AI world split in two, one ecosystem on each side of China's Great Firewall. Most consultancies
          know the Western stack. Few know the Chinese one. The models on each side are built and priced
          differently, and they answer to different rules. The right choice depends on your data and your
          markets. We benchmark GPT and Claude against Qwen and DeepSeek on the actual task, then recommend
          on the merits, not on which side we happen to know. Data residency is part of the answer, not an
          afterthought.
        </p>
      </div>
    </section>

    <!-- 3 · Teams -->
    <section class="min-sec min-sec--ruled" id="teams">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>Three teams. One platform.</h2>

        <div class="min-grid-2 ai-cards">
          <a class="min-card ai-card" href={pathFor('ai-services/intelligence', locale)} data-reveal>
            <span class="min-tag min-tag--yellow">The platform</span>
            <span class="ai-card__name">
              <img class="ai-card__icon" src="/AgencyLogos/intelligence-icon.png" alt="" width="96" height="96" loading="lazy" decoding="async" />
              Intelligence
            </span>
            <h3 class="min-h3">See AI at work before you commit.</h3>
            <p class="min-small">
              Our platform, and the fastest way to see what we mean by evidence. Working AI modules, real
              tasks, every cost on screen. Three functions ready today.
            </p>
            <span class="min-link ai-card__cta">Discover Intelligence</span>
          </a>

          <div class="min-card ai-card" data-reveal style="--i: 1">
            <span class="min-tag min-tag--blue">Consulting</span>
            <img class="ai-card__logo" src="/AgencyLogos/BearingBridgeAI-horizontal.svg" alt="BearingBridge AI" loading="lazy" decoding="async" />
            <h3 class="min-h3">Consulting and implementation.</h3>
            <p class="min-small">
              Strategy through adoption, plus training for leadership and builders, on dated baselines and
              metrics agreed in writing before anyone builds. Our AZIMUTH method works like navigation: take
              a bearing, prove it, then scale. When the evidence says stop, we say stop.
            </p>
            <a class="ai-card__ext" href="https://www.bearingbridge.ai/method" target="_blank" rel="noreferrer">See the method ↗</a>
            <a class="min-btn min-btn--ghost ai-card__btn" href="https://www.bearingbridge.ai" target="_blank" rel="noreferrer">bearingbridge.ai ↗</a>
          </div>

          <a class="min-card ai-card" href="https://hubstudio.ai" target="_blank" rel="noreferrer" data-reveal style="--i: 2">
            <span class="min-tag min-tag--green">Production</span>
            <img class="ai-card__logo" src="/AgencyLogos/hubStudio%20(2).png" alt="HubStudio" loading="lazy" decoding="async" />
            <h3 class="min-h3">Content production at scale.</h3>
            <p class="min-small">
              Half studio, half AI lab. Images, video, and the words around them, produced at volume without
              losing the brand's voice.
            </p>
            <span class="min-btn min-btn--ghost ai-card__btn">hubstudio.ai ↗</span>
          </a>

          <a class="min-card ai-card" href="https://nuvora.studio" target="_blank" rel="noreferrer" data-reveal style="--i: 3">
            <span class="min-tag min-tag--red">B2B pipeline</span>
            <img class="ai-card__logo" src="/AgencyLogos/Nuvora%20PNG.png" alt="Nuvora Studio" loading="lazy" decoding="async" />
            <h3 class="min-h3">LinkedIn-only B2B.</h3>
            <p class="min-small">
              Strategy, content, ads. One channel, done properly, run on an AI-driven engine, so a real
              pipeline comes out the other end.
            </p>
            <span class="min-btn min-btn--ghost ai-card__btn">nuvora.studio ↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 4 · CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 ai-cta__title">Talk to us about AI.</h2>
        <p class="min-body ai-cta__body">
          A conversation with the senior team about your markets, your data, and where AI would actually pay
          back for you. Engagements start small: a scoped pilot with a dated baseline and a written price.
          And if the honest answer is that AI is not your next move, we will say so.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
        <p class="min-muted ai-cta__email">Prefer email? <a href="mailto:hello@bearingbridge.com">hello@bearingbridge.com</a></p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .ai-hero__second { margin-top: var(--space-3); }
  .ai-hero__second a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-cards { align-items: stretch; }
  .ai-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .ai-card .min-tag { margin-bottom: 0; }
  .ai-card .min-h3 { margin-bottom: 0; }
  .ai-card__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ai-card__icon { width: 28px; height: 28px; border-radius: 6px; }
  .ai-card__logo {
    height: 40px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    object-position: left center;
    display: block;
  }
  .ai-card__ext {
    width: fit-content;
    font-size: 0.9rem;
    font-weight: 550;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    transition: border-color 200ms ease;
  }
  .ai-card__ext:hover { color: var(--ink); border-color: var(--ink); }
  .ai-card__cta { margin-top: auto; align-self: flex-start; }
  .ai-card__btn { margin-top: auto; align-self: flex-start; }

  .ai-cta__title { margin-inline: auto; }
  .ai-cta__body { margin: 0 auto var(--space-5); }
  .ai-cta__email { margin-top: var(--space-4); }
  .ai-cta__email a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: 1px solid var(--line);
    transition: border-color 200ms ease;
  }
  .ai-cta__email a:hover { border-color: var(--ink); }
</style>
