---
import Layout from '../layouts/Layout.astro';
import AgencyLogo from '../components/AgencyLogo.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'China cross-border marketing';
const description = 'A cross-border marketing agency group: five specialists carrying brands between China and the West, both ways. Brand, channels, web, partners, sales.';

const agencies = [
  {
    name: 'TheChinaPath',
    tagline: 'Full-service China entry. Branding through to eCommerce.',
    route: 'agencies/bearingbridge' as const,
  },
  {
    name: 'BeyondBridge',
    tagline: 'The full pipeline for Chinese brands going overseas.',
    route: 'agencies/beyondbridge' as const,
  },
  {
    name: 'ChinaWebFoundry',
    tagline: 'Websites built for the Chinese web. Baidu, ICP, AI engines.',
    route: 'agencies/chinawebfoundry' as const,
  },
  {
    name: 'TheRedScroll',
    tagline: 'Chinese social media. WeChat, Douyin, RedNote, Weibo.',
    route: 'agencies/theredscroll' as const,
  },
  {
    name: 'Compass',
    tagline: 'The right distributor or TP, vetted before you meet them. A private database of China distributors, Tmall TPs, Douyin Partners.',
    route: 'agencies/compass' as const,
  },
];
---

<Layout locale={locale} route="cross-border-marketing" title={title} description={description}>
  <section class="hero-statement">
    <video
      class="hero-statement__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/Video/greatWall%20AI%20video.mp4" type="video/mp4" />
    </video>
    <div class="hero-statement__scrim" aria-hidden="true"></div>
    <div class="hero-statement__rail">
      <aside class="rail" aria-label="Five agencies in the practice">
        <header class="rail__head">
          <span class="rail__head-tag">The practice</span>
        </header>

        <div class="rail__chapter">
          <div class="rail__chapter-head">
            <span class="rail__chapter-label">Lead agencies</span>
            <span class="rail__chapter-rule" aria-hidden="true"></span>
          </div>
          <ol class="rail__list">
            <li class="rail__row" style="--row-i: 0;">
              <a class="rail__link" href={pathFor('agencies/bearingbridge', locale)}>
                <span class="rail__logo"><img src="/images/thechinapath-horizontal.png" alt="" /></span>
                <span class="rail__body">
                  <span class="rail__name">TheChinaPath</span>
                  <span class="rail__tagline">Full-service West to China</span>
                </span>
                <span class="rail__stripe rail__stripe--w" aria-hidden="true"></span>
              </a>
            </li>
            <li class="rail__row" style="--row-i: 1;">
              <a class="rail__link" href={pathFor('agencies/beyondbridge', locale)}>
                <span class="rail__logo"><img src="/AgencyLogos/BeyondBridge-%20Logo-EN-4K-Transparent.png" alt="" /></span>
                <span class="rail__body">
                  <span class="rail__name">BeyondBridge</span>
                  <span class="rail__tagline">Full-service China to West</span>
                </span>
                <span class="rail__stripe rail__stripe--e" aria-hidden="true"></span>
              </a>
            </li>
          </ol>
        </div>

        <div class="rail__chapter">
          <div class="rail__chapter-head">
            <span class="rail__chapter-label">Specialists</span>
            <span class="rail__chapter-rule" aria-hidden="true"></span>
          </div>
          <ol class="rail__list">
            <li class="rail__row" style="--row-i: 2;">
              <a class="rail__link" href={pathFor('agencies/chinawebfoundry', locale)}>
                <span class="rail__logo"><img src="/AgencyLogos/Logo-ChinaWebFoundry-transparent.png" alt="" /></span>
                <span class="rail__body">
                  <span class="rail__name">ChinaWebFoundry</span>
                  <span class="rail__tagline">Built for Chinese web</span>
                </span>
                <span class="rail__stripe rail__stripe--both" aria-hidden="true"></span>
              </a>
            </li>
            <li class="rail__row" style="--row-i: 3;">
              <a class="rail__link" href={pathFor('agencies/theredscroll', locale)}>
                <span class="rail__logo"><img src="/AgencyLogos/TheredScroll%20PNG.png" alt="" /></span>
                <span class="rail__body">
                  <span class="rail__name">TheRedScroll</span>
                  <span class="rail__tagline">Chinese social media</span>
                </span>
                <span class="rail__stripe rail__stripe--both" aria-hidden="true"></span>
              </a>
            </li>
            <li class="rail__row" style="--row-i: 4;">
              <a class="rail__link" href={pathFor('agencies/compass', locale)}>
                <span class="rail__logo"><img src="/AgencyLogos/Logo%20Compass%20-%20Horizontal.svg" alt="" /></span>
                <span class="rail__body">
                  <span class="rail__name">Compass</span>
                  <span class="rail__tagline">Vetted China partners</span>
                </span>
                <span class="rail__stripe rail__stripe--both" aria-hidden="true"></span>
              </a>
            </li>
          </ol>
        </div>
      </aside>
    </div>
    <div class="container hero-statement__container">
      <div class="hero-statement__content">
        <span class="eyebrow">Cross-Border Marketing</span>
        <h1 class="hero-statement__title balance">We build and grow brands, products, and services across China and the West. Both ways.</h1>
        <p class="hero-statement__lead">
          Five specialist agencies, built around one thesis. The gap between China and the West was never a
          translation problem. It's brand, channels, infrastructure, and sales. And it runs in both directions,
          every day.
        </p>
        <p class="hero-statement__lead hero-statement__lead--secondary">
          We have run this for brands in beauty and dermo-cosmetics, automotive and EV, food and beverage,
          hospitality, home and lifestyle, and digital health.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#the-stack">Find the right agency</a>
          <a class="btn btn--ghost" href={pathFor('contact', locale)}>Talk to us</a>
        </div>
        <p class="hero-statement__cite">Run from Shanghai and Hangzhou, with the Western side handled from Paris and by in-market reps.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="two-flows">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Two flows</span>
        <h2 class="balance">Start from the side you're standing on.</h2>
      </header>

      <div class="bridge-panel">
        <span class="bridge-panel__spine" aria-hidden="true">
          <span class="bridge-panel__spine-line"></span>
          <span class="bridge-panel__spine-mark">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 16h22" />
              <path d="M22 11l5 5-5 5" />
              <path d="M10 21l-5-5 5-5" />
            </svg>
          </span>
        </span>

        <a class="bridge-panel__side bridge-panel__side--inbound" href={`${pathFor('two-flows', locale)}#inbound`}>
          <span class="bridge-panel__direction">
            <span class="bridge-panel__arrow" aria-hidden="true">→</span>
            West to China · Inbound
          </span>
          <h3 class="bridge-panel__title">Bringing Western brands into China.</h3>
          <p class="bridge-panel__body">
            Brand, WeChat, RedNote, Douyin, Tmall, JD, Baidu, KOLs, distribution. From a single landing page
            to the full stack.
          </p>
          <span class="bridge-panel__by">TheChinaPath · TheRedScroll · ChinaWebFoundry · Compass</span>
          <span class="bridge-panel__cta">
            Jump to inbound
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </span>
        </a>

        <a class="bridge-panel__side bridge-panel__side--outbound" href={`${pathFor('two-flows', locale)}#outbound`}>
          <span class="bridge-panel__direction">
            <span class="bridge-panel__arrow" aria-hidden="true">←</span>
            China to the West · Outbound
          </span>
          <h3 class="bridge-panel__title">Taking Chinese brands overseas.</h3>
          <p class="bridge-panel__body">
            A brand for Western buyers, a website built for Western eyes, SEO, GEO, Google Ads, and named
            sales reps in the right time zone.
          </p>
          <span class="bridge-panel__by">BeyondBridge</span>
          <span class="bridge-panel__cta">
            Jump to outbound
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </span>
        </a>
      </div>

      <div class="btn-row" style="margin-top: var(--space-6); justify-content: center;">
        <a class="btn btn--primary" href={pathFor('two-flows', locale)}>Open the full Two-flows page</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">The stack</span>
        <p class="transition-line">
          If you cannot tell which side you are standing on, pick the flow first. The agency follows.
          And if what you need is AI, content volume, or LinkedIn, that is
          <a href={pathFor('ai-services', locale)}>AI Services</a>.
        </p>
        <h2 class="balance" id="the-stack">Five specialists. One practice.</h2>
        <p class="lead">
          Every agency here takes clients directly. Start with the one your project needs; the others join
          if and when the work grows.
        </p>
      </header>
      <div class="grid-3">
        {agencies.map((a) => (
          <a class="card" href={pathFor(a.route, locale)}>
            <AgencyLogo route={a.route} name={a.name} class="agency-card-logo" />
            <p>{a.tagline}</p>
            <span class="btn btn--ghost" style="margin-top: auto;">Open</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">The logic</span>
        <h2 class="balance">Two leads. Three specialists.</h2>
        <p class="lead">
          Two lead agencies, one per direction, each running the full project. Three specialists that slot
          into either direction when the work calls for their piece: social, web, partners.
        </p>
      </header>
      <div class="matrix-grid" role="table" aria-label="Agencies by direction and layer">
        <div class="matrix-grid__head" role="row">
          <div class="matrix-grid__corner" aria-hidden="true"></div>
          <div class="matrix-grid__direction matrix-grid__direction--west" role="columnheader">
            <span class="matrix-grid__arrow" aria-hidden="true">→</span>
            <span class="matrix-grid__direction-label">West to China</span>
          </div>
          <div class="matrix-grid__direction matrix-grid__direction--east" role="columnheader">
            <span class="matrix-grid__arrow" aria-hidden="true">←</span>
            <span class="matrix-grid__direction-label">China to the West</span>
          </div>
        </div>

        <div class="matrix-grid__row" role="row">
          <div class="matrix-grid__layer" role="rowheader">
            <span class="matrix-grid__layer-name">Full-service</span>
          </div>
          <div class="matrix-cell matrix-cell--lead" role="cell">
            <span class="matrix-cell__tag">Lead agency</span>
            <span class="matrix-cell__name">TheChinaPath</span>
            <a class="matrix-cell__site" href="https://thechinapath.com" target="_blank" rel="noreferrer">thechinapath.com <span aria-hidden="true">↗</span></a>
          </div>
          <div class="matrix-cell matrix-cell--lead" role="cell">
            <span class="matrix-cell__tag">Lead agency</span>
            <span class="matrix-cell__name">BeyondBridge</span>
            <a class="matrix-cell__site" href="https://beyondbridge.ai" target="_blank" rel="noreferrer">beyondbridge.ai <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="matrix-grid__row matrix-grid__row--both" role="row">
          <div class="matrix-grid__layer" role="rowheader">
            <span class="matrix-grid__layer-name">Social media</span>
          </div>
          <div class="matrix-cell matrix-cell--both" role="cell">
            <span class="matrix-cell__name">TheRedScroll</span>
            <span class="matrix-cell__note">WeChat, Douyin, RedNote, Weibo. For Western or Chinese clients.</span>
            <a class="matrix-cell__site" href="https://theredscroll.com" target="_blank" rel="noreferrer">theredscroll.com <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="matrix-grid__row matrix-grid__row--both" role="row">
          <div class="matrix-grid__layer" role="rowheader">
            <span class="matrix-grid__layer-name">Web infrastructure</span>
          </div>
          <div class="matrix-cell matrix-cell--both" role="cell">
            <span class="matrix-cell__name">ChinaWebFoundry</span>
            <span class="matrix-cell__note">Baidu-ready, ICP, Chinese AI engines. For Western or Chinese clients.</span>
            <a class="matrix-cell__site" href="https://chinawebfoundry.com" target="_blank" rel="noreferrer">chinawebfoundry.com <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="matrix-grid__row matrix-grid__row--both" role="row">
          <div class="matrix-grid__layer" role="rowheader">
            <span class="matrix-grid__layer-name">Partner sourcing</span>
          </div>
          <div class="matrix-cell matrix-cell--both" role="cell">
            <span class="matrix-cell__name">Compass</span>
            <span class="matrix-cell__note">Vetted China distributors, Tmall TPs, Douyin Partners.</span>
            <a class="matrix-cell__site" href="https://compass.bearingbridge.com" target="_blank" rel="noreferrer">compass.bearingbridge.com <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="matrix-grid__row matrix-grid__row--span" role="row">
          <div class="matrix-grid__layer" role="rowheader">
            <span class="matrix-grid__layer-name">Beyond this practice</span>
          </div>
          <div class="matrix-cell matrix-cell--span matrix-cell--ai" role="cell">
            <span class="matrix-cell__bridge" aria-hidden="true">
              <span class="matrix-cell__bridge-dot"></span>
              <span class="matrix-cell__bridge-line"></span>
              <span class="matrix-cell__bridge-dot"></span>
            </span>
            <span class="matrix-cell__name">Looking for AI adoption, content at scale, or LinkedIn B2B?</span>
            <span class="matrix-cell__note">Those live in our AI Services practice now, and they plug into any cross-border project.</span>
            <a class="matrix-cell__site" href={pathFor('ai-services', locale)}>Open AI Services <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div style="margin-top: var(--space-6);">
        <a class="btn btn--ghost" href={pathFor('how-we-work', locale)}>How we work</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow center">
      <h2 class="balance">Tell us which way you are going.</h2>
      <p class="lead" style="margin-inline: auto;">
        Thirty minutes on a call about your market, your channels, your timeline. You leave knowing which
        agency to start with, or whether it takes more than one. We contract from Shanghai or Hong Kong,
        fapiao included when you need one. The named work, from Camper to Marriott to Langnese, sits on the
        agency sites.
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: var(--space-5);">
        <a class="btn btn--primary" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-statement__lead--secondary {
    margin-top: var(--space-3);
    font-size: 0.95em;
    opacity: 0.85;
  }

  .transition-line {
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
    max-width: 62ch;
  }
  .transition-line a {
    color: var(--bbg-blue);
    font-weight: 600;
    text-decoration: none;
  }
  .transition-line a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- The Stack: consistent logo sizing ---------- */
  .card :global(.agency-card-logo) {
    width: 100%;
    height: 56px;
    max-height: 56px;
    object-fit: contain;
    object-position: left center;
    margin-bottom: var(--space-3);
    background: transparent;
    display: block;
    filter: none;
  }

  /* ---------- Modern matrix grid ---------- */
  .matrix-grid {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .matrix-grid__head,
  .matrix-grid__row {
    display: grid;
    grid-template-columns: minmax(160px, 200px) 1fr 1fr;
    gap: var(--space-4);
    align-items: stretch;
  }
  .matrix-grid__direction {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-ink);
    position: relative;
  }
  .matrix-grid__direction::after {
    content: '';
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 0;
    height: 2px;
    border-radius: 2px;
  }
  .matrix-grid__direction--west::after { background: linear-gradient(90deg, var(--bbg-blue), transparent); }
  .matrix-grid__direction--east::after { background: linear-gradient(90deg, transparent, #c8102e); }
  .matrix-grid__direction--east { justify-content: flex-end; flex-direction: row-reverse; }
  .matrix-grid__arrow {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--bbg-blue);
  }
  .matrix-grid__direction--east .matrix-grid__arrow { color: #c8102e; }
  .matrix-grid__layer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    align-self: center;
  }
  .matrix-grid__layer-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--bbg-ink);
  }
  .matrix-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: 12px;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .matrix-cell:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -16px rgba(15, 23, 42, 0.18);
    border-color: var(--bbg-border-strong);
  }
  .matrix-cell--lead {
    background: linear-gradient(180deg, #ffffff 0%, var(--bbg-surface) 100%);
    border-color: rgba(38, 154, 218, 0.25);
  }
  .matrix-cell--lead::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 3px;
    background: linear-gradient(180deg, var(--bbg-blue), #c8102e);
    border-radius: 0 3px 3px 0;
  }
  .matrix-grid__row--both .matrix-cell--both {
    grid-column: 2 / -1;
    background: linear-gradient(90deg, rgba(38, 154, 218, 0.06) 0%, rgba(255, 255, 255, 0.5) 50%, rgba(200, 16, 46, 0.06) 100%);
    border-color: rgba(15, 23, 42, 0.10);
    padding: var(--space-3) var(--space-5);
  }
  .matrix-grid__row--both .matrix-cell--both::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 3px;
    background: linear-gradient(180deg, var(--bbg-blue) 0%, #c8102e 100%);
    border-radius: 0 3px 3px 0;
  }
  .matrix-grid__row--both .matrix-cell--both .matrix-cell__note {
    color: var(--bbg-text-muted);
    font-size: var(--fs-small);
  }
  .matrix-cell__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bbg-blue);
  }
  .matrix-cell__name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--bbg-ink);
  }
  .matrix-cell__site {
    width: fit-content;
    margin-top: 6px;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--bbg-blue);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: opacity 0.2s var(--ease);
  }
  .matrix-cell__site:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .matrix-grid__row--span .matrix-cell__site {
    color: rgba(255, 255, 255, 0.88);
  }
  .matrix-grid__row--span .matrix-cell--span {
    grid-column: 2 / -1;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border-color: transparent;
    color: white;
    align-items: center;
    text-align: center;
    padding: var(--space-5);
    overflow: hidden;
  }
  .matrix-grid__row--span .matrix-cell--span::after {
    content: '';
    position: absolute;
    inset: -50%;
    background:
      radial-gradient(circle at 30% 50%, rgba(38, 154, 218, 0.15), transparent 40%),
      radial-gradient(circle at 70% 50%, rgba(200, 16, 46, 0.15), transparent 40%);
    pointer-events: none;
  }
  .matrix-grid__row--span .matrix-cell--span > * { position: relative; z-index: 1; }
  .matrix-grid__row--span .matrix-cell__name { color: white; font-size: 1.25rem; }
  .matrix-grid__row--span .matrix-cell__note {
    color: rgba(255,255,255,0.7);
    font-size: var(--fs-small);
    margin-top: 2px;
  }
  .matrix-cell__bridge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-2);
  }
  .matrix-cell__bridge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--bbg-blue);
    box-shadow: 0 0 12px rgba(38, 154, 218, 0.7);
    animation: bridge-pulse 2.5s ease-in-out infinite;
  }
  .matrix-cell__bridge-dot:last-child {
    background: #c8102e;
    box-shadow: 0 0 12px rgba(200, 16, 46, 0.7);
    animation-delay: 1.25s;
  }
  .matrix-cell__bridge-line {
    width: 64px; height: 2px;
    background: linear-gradient(90deg, var(--bbg-blue), #c8102e);
    border-radius: 2px;
  }
  .matrix-grid__row--span .matrix-cell--ai {
    background: linear-gradient(135deg, #131d33 0%, #1f2e4d 100%);
  }
  .matrix-grid__row--span .matrix-cell--ai::after {
    background:
      radial-gradient(circle at 30% 50%, rgba(194, 146, 47, 0.18), transparent 40%),
      radial-gradient(circle at 70% 50%, rgba(224, 179, 94, 0.16), transparent 40%);
  }
  .matrix-cell--ai .matrix-cell__bridge-dot {
    background: #c2922f;
    box-shadow: 0 0 12px rgba(194, 146, 47, 0.7);
  }
  .matrix-cell--ai .matrix-cell__bridge-dot:last-child {
    background: #e0b35e;
    box-shadow: 0 0 12px rgba(224, 179, 94, 0.7);
    animation-delay: 1.25s;
  }
  .matrix-cell--ai .matrix-cell__bridge-line {
    background: linear-gradient(90deg, #c2922f, #e0b35e);
  }
  @keyframes bridge-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }
  @media (max-width: 767px) {
    .matrix-grid__head { display: none; }
