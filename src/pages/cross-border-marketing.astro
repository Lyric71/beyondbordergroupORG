---
import Layout from '../layouts/Layout.astro';
import AgencyLogo from '../components/AgencyLogo.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'China cross-border marketing';
const description = 'A cross-border marketing agency group: five specialists carrying brands between China and the West, both ways. Brand, channels, web, partners, sales.';

const agencies = [
  {
    name: 'TheChinaPath',
    tagline: 'Full-service China entry. Branding through to eCommerce.',
    route: 'agencies/bearingbridge' as const,
  },
  {
    name: 'BeyondBridge',
    tagline: 'The full pipeline for Chinese brands going overseas.',
    route: 'agencies/beyondbridge' as const,
  },
  {
    name: 'ChinaWebFoundry',
    tagline: 'Websites built for the Chinese web. Baidu, ICP, AI engines.',
    route: 'agencies/chinawebfoundry' as const,
  },
  {
    name: 'TheRedScroll',
    tagline: 'Chinese social media. WeChat, Douyin, RedNote, Weibo.',
    route: 'agencies/theredscroll' as const,
  },
  {
    name: 'Compass',
    tagline: 'The right distributor or TP, vetted before you meet them. A private database of China distributors, Tmall TPs, Douyin Partners.',
    route: 'agencies/compass' as const,
  },
];
---

<Layout locale={locale} route="cross-border-marketing" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <h1 class="min-hero__title" data-reveal>We carry brands between China and the West. Both ways.</h1>
        <p class="min-hero__lead" data-reveal style="--i: 1">
          Five specialist agencies, built around one thesis. The gap between China and the West was never a
          translation problem. It's brand, channels, infrastructure, and sales. And it runs in both directions,
          every day.
        </p>
        <div class="min-ctas cb-hero__ctas" data-reveal style="--i: 2">
          <a class="min-btn" href="#the-stack">Find your agency</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>

    <!-- 2 · The practice rail -->
    <section class="min-sec">
      <div class="min-wrap">
        <div class="min-split cb-intro" data-reveal>
          <aside class="cb-rail" aria-label="Five agencies in the practice">
            <span class="min-tag min-tag--red">The practice</span>

            <div class="cb-rail__chapter">
              <p class="min-meta cb-rail__label">Lead agencies</p>
              <ol class="cb-rail__list">
                <li>
                  <a class="cb-rail__link" href={pathFor('agencies/bearingbridge', locale)}>
                    <span class="cb-rail__logo"><img src="/images/thechinapath-horizontal.png" alt="" loading="lazy" decoding="async" /></span>
                    <span class="cb-rail__body">
                      <span class="cb-rail__name">TheChinaPath</span>
                      <span class="cb-rail__tagline">Full-service West to China</span>
                    </span>
                  </a>
                </li>
                <li>
                  <a class="cb-rail__link" href={pathFor('agencies/beyondbridge', locale)}>
                    <span class="cb-rail__logo"><img src="/AgencyLogos/BeyondBridge-%20Logo-EN-4K-Transparent.png" alt="" loading="lazy" decoding="async" /></span>
                    <span class="cb-rail__body">
                      <span class="cb-rail__name">BeyondBridge</span>
                      <span class="cb-rail__tagline">Full-service China to West</span>
                    </span>
                  </a>
                </li>
              </ol>
            </div>

            <div class="cb-rail__chapter">
              <p class="min-meta cb-rail__label">Specialists</p>
              <ol class="cb-rail__list">
                <li>
                  <a class="cb-rail__link" href={pathFor('agencies/chinawebfoundry', locale)}>
                    <span class="cb-rail__logo"><img src="/AgencyLogos/Logo-ChinaWebFoundry-transparent.png" alt="" loading="lazy" decoding="async" /></span>
                    <span class="cb-rail__body">
                      <span class="cb-rail__name">ChinaWebFoundry</span>
                      <span class="cb-rail__tagline">Built for Chinese web</span>
                    </span>
                  </a>
                </li>
                <li>
                  <a class="cb-rail__link" href={pathFor('agencies/theredscroll', locale)}>
                    <span class="cb-rail__logo"><img src="/AgencyLogos/TheredScroll%20PNG.png" alt="" loading="lazy" decoding="async" /></span>
                    <span class="cb-rail__body">
                      <span class="cb-rail__name">TheRedScroll</span>
                      <span class="cb-rail__tagline">Chinese social media</span>
                    </span>
                  </a>
                </li>
                <li>
                  <a class="cb-rail__link" href={pathFor('agencies/compass', locale)}>
                    <span class="cb-rail__logo"><img src="/AgencyLogos/Logo%20Compass%20-%20Horizontal.svg" alt="" loading="lazy" decoding="async" /></span>
                    <span class="cb-rail__body">
                      <span class="cb-rail__name">Compass</span>
                      <span class="cb-rail__tagline">Vetted China partners</span>
                    </span>
                  </a>
                </li>
              </ol>
            </div>
          </aside>

          <figure class="min-photo cb-video" aria-hidden="true">
            <video autoplay muted loop playsinline preload="auto">
              <source src="/Video/greatWall%20AI%20video.mp4" type="video/mp4" />
            </video>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3 · Two flows -->
    <section class="min-sec min-sec--ruled" id="two-flows">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>Start from the side you're standing on.</h2>

        <div class="min-grid-2 cb-flows">
          <a class="min-card cb-flow" href={`${pathFor('two-flows', locale)}#inbound`} data-reveal>
            <span class="min-meta cb-flow__dir"><span aria-hidden="true">→</span> West to China, Inbound</span>
            <h3 class="min-h3">Bringing Western brands into China.</h3>
            <p class="min-small">
              Brand, WeChat, RedNote, Douyin, Tmall, JD, Baidu, KOLs, distribution. From a single landing page
              to the full stack.
            </p>
            <p class="min-muted">TheChinaPath, TheRedScroll, ChinaWebFoundry, Compass</p>
            <span class="min-link cb-flow__cta">Jump to inbound</span>
          </a>

          <a class="min-card cb-flow" href={`${pathFor('two-flows', locale)}#outbound`} data-reveal style="--i: 1">
            <span class="min-meta cb-flow__dir"><span aria-hidden="true">←</span> China to the West, Outbound</span>
            <h3 class="min-h3">Taking Chinese brands overseas.</h3>
            <p class="min-small">
              A brand for Western buyers, a website built for Western eyes, SEO, GEO, Google Ads, and named
              sales reps in the right time zone.
            </p>
            <p class="min-muted">BeyondBridge</p>
            <span class="min-link cb-flow__cta">Jump to outbound</span>
          </a>
        </div>

        <div class="min-ctas cb-flows__more" data-reveal>
          <a class="min-btn min-btn--ghost" href={pathFor('two-flows', locale)}>Open Two flows</a>
        </div>
      </div>
    </section>

    <!-- 4 · The stack -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split min-split--reverse cb-stack__head" data-reveal>
          <div>
            <h2 class="min-h2" id="the-stack">Five specialists. One practice.</h2>
            <p class="min-lead">
              Every agency here takes clients directly. Start with the one your project needs; the others join
              if and when the work grows.
            </p>
          </div>
          <figure class="min-photo min-photo--wide">
            <img
              src="/images/photo-practice-cb.webp"
              alt="Container port cranes at golden hour."
              width="1050"
              height="620"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        <div class="min-index" data-reveal>
          {agencies.map((a) => (
            <a class="min-index__row" href={pathFor(a.route, locale)}>
              <AgencyLogo route={a.route} name={a.name} class="cb-index__logo" />
              <p class="min-index__body">{a.tagline}</p>
              <span class="min-link cb-index__open">Open</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5 · Two leads, three specialists -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Two leads. Three specialists.</h2>
          <p class="min-lead">
            Two lead agencies, one per direction, each running the full project. Three specialists that slot
            into either direction when the work calls for their piece: social, web, partners.
          </p>
        </div>

        <div class="cb-matrix" role="table" aria-label="Agencies by direction and layer" data-reveal style="--i: 1">
          <div class="cb-matrix__head" role="row">
            <div aria-hidden="true"></div>
            <div class="cb-matrix__dir" role="columnheader">
              <span aria-hidden="true">→</span>
              <span>West to China</span>
            </div>
            <div class="cb-matrix__dir cb-matrix__dir--east" role="columnheader">
              <span aria-hidden="true">←</span>
              <span>China to the West</span>
            </div>
          </div>

          <div class="cb-matrix__row" role="row">
            <div class="cb-matrix__layer" role="rowheader">Full-service</div>
            <div class="min-card cb-matrix__cell" role="cell">
              <span class="min-tag min-tag--blue">Lead agency</span>
              <span class="cb-matrix__name">TheChinaPath</span>
              <a class="cb-matrix__site" href="https://thechinapath.com" target="_blank" rel="noreferrer">thechinapath.com <span aria-hidden="true">↗</span></a>
            </div>
            <div class="min-card cb-matrix__cell" role="cell">
              <span class="min-tag min-tag--red">Lead agency</span>
              <span class="cb-matrix__name">BeyondBridge</span>
              <a class="cb-matrix__site" href="https://beyondbridge.ai" target="_blank" rel="noreferrer">beyondbridge.ai <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="cb-matrix__row" role="row">
            <div class="cb-matrix__layer" role="rowheader">Social media</div>
            <div class="min-card cb-matrix__cell cb-matrix__cell--span" role="cell">
              <span class="cb-matrix__name">TheRedScroll</span>
              <span class="min-muted">WeChat, Douyin, RedNote, Weibo. For Western or Chinese clients.</span>
              <a class="cb-matrix__site" href="https://theredscroll.com" target="_blank" rel="noreferrer">theredscroll.com <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="cb-matrix__row" role="row">
            <div class="cb-matrix__layer" role="rowheader">Web infrastructure</div>
            <div class="min-card cb-matrix__cell cb-matrix__cell--span" role="cell">
              <span class="cb-matrix__name">ChinaWebFoundry</span>
              <span class="min-muted">Baidu-ready, ICP, Chinese AI engines. For Western or Chinese clients.</span>
              <a class="cb-matrix__site" href="https://chinawebfoundry.com" target="_blank" rel="noreferrer">chinawebfoundry.com <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="cb-matrix__row" role="row">
            <div class="cb-matrix__layer" role="rowheader">Partner sourcing</div>
            <div class="min-card cb-matrix__cell cb-matrix__cell--span" role="cell">
              <span class="cb-matrix__name">Compass</span>
              <span class="min-muted">Vetted China distributors, Tmall TPs, Douyin Partners.</span>
              <a class="cb-matrix__site" href="https://compass.bearingbridge.com" target="_blank" rel="noreferrer">compass.bearingbridge.com <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="cb-matrix__row" role="row">
            <div class="cb-matrix__layer" role="rowheader">Beyond this practice</div>
            <div class="min-card cb-matrix__cell cb-matrix__cell--span cb-matrix__cell--ai" role="cell">
              <span class="cb-matrix__name">Looking for AI adoption, content at scale, or LinkedIn B2B?</span>
              <span class="min-muted">Those live in our AI Services practice now, and they plug into any cross-border project.</span>
              <a class="cb-matrix__site" href={pathFor('ai-services', locale)}>Open AI Services <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>

        <div class="cb-how" data-reveal>
          <a class="min-btn min-btn--ghost" href={pathFor('how-we-work', locale)}>How we work</a>
        </div>
      </div>
    </section>

    <!-- 6 · CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 cb-cta__title">Tell us which way you are going.</h2>
        <p class="min-body cb-cta__body">
          Thirty minutes on a call about your market, your channels, your timeline. You leave knowing which
          agency to start with, or whether it takes more than one. We contract from Shanghai or Hong Kong,
          fapiao included when you need one. The named work, from Camper to Marriott to Langnese, sits on the
          agency sites.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .cb-hero__ctas { margin-top: var(--space-5); }

  /* ---------- Practice rail + video split ---------- */
  .cb-intro { align-items: stretch; }
  .cb-rail {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: var(--space-4) var(--space-5);
  }
  .cb-rail__label { margin: var(--space-4) 0 var(--space-2); }
  .cb-rail__list { list-style: none; margin: 0; padding: 0; }
  .cb-rail__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2);
    margin: 0 calc(-1 * var(--space-2));
    border-radius: 8px;
    text-decoration: none;
    transition: background 200ms ease;
  }
  .cb-rail__link:hover { background: var(--surface-2); }
  .cb-rail__logo { width: 92px; flex: none; display: flex; align-items: center; }
  .cb-rail__logo img { display: block; max-height: 26px; max-width: 100%; width: auto; object-fit: contain; }
  .cb-rail__name { display: block; font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .cb-rail__tagline { display: block; font-size: 0.82rem; line-height: 1.45; color: var(--muted); }
  .cb-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
    filter: saturate(0.85);
  }

  /* ---------- Two flows ---------- */
  .cb-flow { gap: var(--space-3); }
  .cb-flow .min-h3 { margin-bottom: 0; }
  .cb-flow__dir { display: inline-flex; align-items: center; gap: 0.4rem; }
  .cb-flow__cta { margin-top: auto; align-self: flex-start; }
  .cb-flows__more { margin-top: var(--space-5); justify-content: center; }

  /* ---------- The stack ---------- */
  .cb-stack__head { margin-bottom: var(--space-5); align-items: center; }
  .cb-stack__head .min-photo { max-width: 440px; justify-self: end; width: 100%; }
  @media (max-width: 900px) {
    .cb-stack__head .min-photo { justify-self: start; max-width: 100%; }
  }
  .min-index__row :global(.cb-index__logo) {
    width: auto;
    height: 40px;
    max-width: 180px;
    object-fit: contain;
    object-position: left center;
    display: block;
  }
  .cb-index__open { justify-self: end; }

  /* ---------- Matrix ---------- */
  .cb-matrix { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .cb-matrix__head,
  .cb-matrix__row {
    display: grid;
    grid-template-columns: minmax(150px, 190px) 1fr 1fr;
    gap: var(--space-3);
    align-items: stretch;
  }
  .cb-matrix__dir {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cb-matrix__dir--east { justify-content: flex-end; }
  .cb-matrix__layer {
    align-self: center;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .cb-matrix__cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: var(--space-4);
  }
  .cb-matrix__cell .min-tag { margin-bottom: 0.15rem; }
  .cb-matrix__cell--span { grid-column: 2 / -1; }
  .cb-matrix__cell--ai { background: var(--surface-2); }
  .cb-matrix__name { font-weight: 600; color: var(--ink); }
  .cb-matrix__site {
    width: fit-content;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    transition: border-color 200ms ease;
  }
  .cb-matrix__site:hover { color: var(--ink); border-color: var(--ink); }
  @media (max-width: 767px) {
    .cb-matrix__head { display: none; }
    .cb-matrix__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--line);
    }
    .cb-matrix__row:last-child { border-bottom: none; padding-bottom: 0; }
    .cb-matrix__cell--span { grid-column: 1 / -1; }
  }
  .cb-how { margin-top: var(--space-5); }

  .cb-cta__title { margin-inline: auto; }
  .cb-cta__body { margin: 0 auto var(--space-5); }
</style>
