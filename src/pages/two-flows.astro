---
import Layout from '../layouts/Layout.astro';
import AgencyLogo from '../components/AgencyLogo.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'Two flows';
const description = 'One bridge, two directions. The full inbound stack to enter or scale in China, and the full outbound pipeline for Chinese brands going overseas.';

const inboundReq = [
  {
    h: 'Brand that reads as quality to a Chinese audience',
    body: 'Trust signals up front. Certifications, partner logos, third-party validation. What looks cluttered in the West reads as serious in China.',
    pill: 'Density signals quality',
  },
  {
    h: 'Channels Chinese consumers actually use',
    body: 'WeChat for trust. RedNote for the shortlist. Douyin for discovery. Weibo for reach. Each one needs its own format and its own team.',
    pill: 'Four stacks, not one',
  },
  {
    h: 'Web infrastructure built behind the Firewall',
    body: 'ICP-licensed hosting on Aliyun, Tencent or Huawei. A site Baidu can index. Mobile-first by force, not by trend.',
    pill: 'Mobile first, always',
  },
  {
    h: 'Search visibility in the engines Chinese buyers use',
    body: 'Baidu owns search here. Google barely registers. Under-35s are skipping search entirely for AI: DeepSeek, Doubao, Kimi, Yuanbao.',
    pill: 'Baidu leads, Google barely registers',
  },
  {
    h: 'Commerce where the buying actually happens',
    body: 'Tmall, JD, Douyin Shop, RED, plus social commerce on WeChat. eCommerce and social are the same surface, not separate funnels.',
    pill: 'Social = commerce',
  },
];

const inboundAgencies = [
  {
    name: 'TheChinaPath',
    role: 'The full-service operator',
    body: 'Twenty years on the ground. Branding, eCommerce, distribution. One accountable team.',
    route: 'agencies/bearingbridge' as const,
  },
  {
    name: 'TheRedScroll',
    role: 'The social media specialist',
    body: 'WeChat, Douyin, RedNote, Weibo, plus 14 more. Fixed scope, fixed price, two-week onboarding.',
    route: 'agencies/theredscroll' as const,
  },
  {
    name: 'ChinaWebFoundry',
    role: 'The web infrastructure specialist',
    body: 'ICP-licensed hosting, Baidu SEO, mobile-first UX, GEO for Chinese AI engines.',
    route: 'agencies/chinawebfoundry' as const,
  },
  {
    name: 'Compass',
    role: 'The distributor and TP database',
    body: 'A private database of vetted China distributors, Tmall TPs, and Douyin partners.',
    route: 'agencies/compass' as const,
  },
];

const outboundReq = [
  {
    h: 'A brand Western buyers recognise',
    body: 'Not translated from China. Names that work, claims that do not read off, a visual identity that lands in Frankfurt and Chicago without an asterisk.',
    pill: 'Built, not translated',
  },
  {
    h: 'A website built for Western eyes',
    body: 'Clean. Spacious. One action per page. Hosted outside China. Fast: three seconds costs you over half your visitors.',
    pill: 'Slow pages lose the visit',
  },
  {
    h: 'Search visibility in Western engines',
    body: 'Google rankings, plus citations in ChatGPT, Perplexity and Gemini. Competitors already own the answers.',
    pill: 'Google + ChatGPT + AI',
  },
  {
    h: 'Page-one search ads',
    body: 'Google Ads while SEO compounds. Western landing pages, not translated ones. Right keywords, right geography.',
    pill: 'Page one, day one',
  },
  {
    h: 'Sales reps in the right time zone',
    body: 'A buyer in Germany writes at 10am Berlin. Shenzhen is asleep. By morning, three competitors already replied.',
    pill: 'First reply wins',
  },
];

const inboundChips = ['WeChat', 'RedNote', 'Douyin', 'Weibo', 'Tmall', 'JD', 'Baidu', 'DeepSeek'];
const outboundChips = ['LinkedIn', 'Google', 'ChatGPT', 'Perplexity', 'Gemini', 'US', 'UK', 'DE', 'FR'];
---

<Layout locale={locale} route="two-flows" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <h1 class="min-hero__title" data-reveal>One bridge. Two flows.</h1>
        <p class="min-hero__lead" data-reveal style="--i: 1">
          Whichever way you are going, we have already done the work on both sides. Pick the side of the bridge you are coming from.
        </p>
        <div class="flows-jumps" data-reveal style="--i: 2">
          <a class="min-card flows-jump" href="#inbound">
            <span class="flows-jump__name">Inbound</span>
            <span class="min-muted">West to China</span>
          </a>
          <a class="min-card flows-jump" href="#outbound">
            <span class="flows-jump__name">Outbound</span>
            <span class="min-muted">China to the West</span>
          </a>
        </div>
        <figure class="min-photo min-photo--wide flows-hero__photo" data-reveal style="--i: 3">
          <img
            src="/images/photo-flows.webp"
            alt="A cargo ship leaving harbor, seen from above."
            width="1050"
            height="620"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · Inbound entry -->
    <section class="min-sec" id="inbound">
      <div class="min-wrap">
        <span class="min-tag min-tag--blue" data-reveal>Inbound: West to China</span>
        <h2 class="min-h2" data-reveal style="--i: 1">
          You have a brand. China has 1.1 billion internet users. Closing that gap is not a translation job.
        </h2>
        <p class="min-lead" data-reveal style="--i: 2">
          The Chinese internet runs on its own stack. Different platforms, different search engines, different
          infrastructure, different content density, different buyer signals. We have been working inside it for
          twenty years.
        </p>
        <div class="flows-chips" data-reveal style="--i: 3">
          {inboundChips.map((c) => <span class="min-pill">{c}</span>)}
        </div>
      </div>
    </section>

    <!-- 3 · Inbound requirements -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Five surfaces. One Chinese internet.</h2>
          <p class="min-lead">A landing in China is five different jobs running at once. Each surface has its own logic, its own tempo, and its own tax for getting it wrong.</p>
        </div>
        <ol class="min-grid-3 flows-req-list" role="list">
          {inboundReq.map((r, i) => (
            <li class="min-card flows-req" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{r.h}</h3>
              <p class="min-small">{r.body}</p>
              <span class="min-pill flows-req__pill">{r.pill}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4 · Inbound agencies -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Pick the whole stack, or pick the piece.</h2>
          <p class="min-lead">Four independent teams cover the inbound stack end to end. Hire one. Hire two. Hire all four. They share a spine.</p>
        </div>
        <div class="min-grid-4 flows-agencies">
          {inboundAgencies.map((a, i) => (
            <a class="min-card flows-agency" href={pathFor(a.route, locale)} data-reveal style={`--i: ${i}`}>
              <span class="flows-agency__logo">
                <AgencyLogo route={a.route} name={a.name} class="agency-card-logo" />
              </span>
              <span class="min-meta">{a.role}</span>
              <h3 class="min-h3">{a.name}</h3>
              <p class="min-small">{a.body}</p>
              <span class="min-link flows-card__cta">Visit</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5 · Inbound openings -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Six typical openings.</h2>
          <p class="min-lead">Most projects start as one sentence. Pick the one closest to yours.</p>
        </div>
        <div class="min-grid-3 flows-openings">
          <a class="min-card flows-opening" href={pathFor('agencies/chinawebfoundry', locale)} data-reveal style="--i: 0">
            <p class="flows-opening__quote">I just need a Chinese website that actually works.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">ChinaWebFoundry</span>
              <span class="min-small">Six-week migration. ICP filed. Baidu-indexable.</span>
            </div>
          </a>
          <a class="min-card flows-opening" href={pathFor('agencies/theredscroll', locale)} data-reveal style="--i: 1">
            <p class="flows-opening__quote">I need to be on RedNote and Douyin in 90 days.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">TheRedScroll</span>
              <span class="min-small">Two-week onboarding. First content live in a fortnight.</span>
            </div>
          </a>
          <a class="min-card flows-opening" href={pathFor('agencies/bearingbridge', locale)} data-reveal style="--i: 2">
            <p class="flows-opening__quote">I need everything: brand, channels, eCommerce, KOLs.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">TheChinaPath</span>
              <span class="min-small">Full-service entry. Twenty-year playbook.</span>
            </div>
          </a>
          <a class="min-card flows-opening" href={pathFor('agencies/compass', locale)} data-reveal style="--i: 3">
            <p class="flows-opening__quote">We need a distributor in China asap.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">Compass</span>
              <span class="min-small">A vetted shortlist of distributors and TPs in days, not months.</span>
            </div>
          </a>
          <a class="min-card flows-opening" href={pathFor('ai-services', locale)} data-reveal style="--i: 4">
            <p class="flows-opening__quote">Our content does not resonate with Chinese audiences.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">AI Services, HubStudio</span>
              <span class="min-small">Content rebuilt for Chinese readers, at the volume the channels demand.</span>
            </div>
          </a>
          <a class="min-card flows-opening" href={pathFor('contact', locale)} data-reveal style="--i: 5">
            <p class="flows-opening__quote">I am not sure where to start.</p>
            <div class="flows-opening__answer">
              <span class="flows-opening__by">Book a call</span>
              <span class="min-small">Thirty minutes. We tell you which agency, and what 90 days look like.</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- 6 · Outbound entry -->
    <section class="min-sec min-sec--ruled" id="outbound">
      <div class="min-wrap">
        <span class="min-tag min-tag--red" data-reveal>Outbound: China to the West</span>
        <h2 class="min-h2" data-reveal style="--i: 1">
          Great product. Great price. Great factory. No pipeline overseas.
        </h2>
        <p class="min-lead" data-reveal style="--i: 2">
          Every Chinese B2B and services company going overseas hits the same wall. The brand was built for
          Chinese buyers. The website reads as cluttered to Western eyes. The LinkedIn page is empty. And nobody
          is answering the inquiry from Berlin at 10am local time. B2B and services are where we focus, and we
          have been building the other side of that bridge for twenty years.
        </p>
        <div class="flows-chips" data-reveal style="--i: 3">
          {outboundChips.map((c) => <span class="min-pill">{c}</span>)}
        </div>
      </div>
    </section>

    <!-- 7 · Outbound requirements -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Five fronts. One overseas pipeline.</h2>
          <p class="min-lead">A landing overseas is five different jobs running at once. Each surface has its own logic, its own tempo, and its own tax for getting it wrong.</p>
        </div>
        <ol class="min-grid-3 flows-req-list" role="list">
          {outboundReq.map((r, i) => (
            <li class="min-card flows-req" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{r.h}</h3>
              <p class="min-small">{r.body}</p>
              <span class="min-pill flows-req__pill">{r.pill}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8 · Outbound packages -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Pick the tier. Add the next one when the project asks.</h2>
          <p class="min-lead">Built for Chinese B2B and services companies going overseas. Three tiers that stack on each other. Each tier includes everything below.</p>
        </div>

        <div class="min-grid-3 flows-pkgs">
          <a class="min-card flows-pkg" href={pathFor('agencies/beyondbridge', locale)} data-reveal style="--i: 0">
            <div class="flows-pkg__head">
              <span class="flows-pkg__tier">Starter</span>
              <span class="min-meta">Presence</span>
            </div>
            <h3 class="min-h3">Brand + LinkedIn + website</h3>
            <p class="min-small">The minimum to look credible to a Western B2B buyer. For services companies going overseas for the first time.</p>
            <ul class="flows-pkg__features">
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Brand strategy for Western buyers</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>LinkedIn page and exec posting</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Western-facing website</li>
            </ul>
            <span class="min-link flows-card__cta">Start with Starter</span>
          </a>

          <a class="min-card flows-pkg" href={pathFor('agencies/beyondbridge', locale)} data-reveal style="--i: 1">
            <div class="flows-pkg__head">
              <span class="flows-pkg__tier">Growth</span>
              <span class="min-meta">Visibility</span>
            </div>
            <h3 class="min-h3">Starter + SEO/GEO + Google Ads</h3>
            <p class="min-small">Presence and traffic. B2B buyers find you on Google, on ChatGPT, and through paid search.</p>
            <ul class="flows-pkg__features">
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Everything in Starter</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>SEO and GEO for Western AI engines</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Google Ads from day one</li>
            </ul>
            <span class="min-link flows-card__cta">Choose Growth</span>
          </a>

          <a class="min-card flows-pkg" href={pathFor('agencies/beyondbridge', locale)} data-reveal style="--i: 2">
            <span class="min-tag min-tag--yellow flows-pkg__badge" aria-hidden="true">Full pipeline</span>
            <div class="flows-pkg__head">
              <span class="flows-pkg__tier">Full Pipeline</span>
              <span class="min-meta">Revenue</span>
            </div>
            <h3 class="min-h3">Growth + the external sales force</h3>
            <p class="min-small">Every inbound lead qualified, called, and handed to your team ready to close.</p>
            <ul class="flows-pkg__features">
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Everything in Growth</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>Named in-market reps</li>
              <li><span class="flows-pkg__check" aria-hidden="true">&#10003;</span>US, UK, DE, FR coverage</li>
            </ul>
            <span class="min-link flows-card__cta">Go Full Pipeline</span>
          </a>
        </div>

        <div class="min-ctas flows-pkg__visit" data-reveal>
          <a class="min-btn min-btn--ghost" href={pathFor('agencies/beyondbridge', locale)}>Visit BeyondBridge</a>
        </div>
      </div>
    </section>

    <!-- 9 · Outbound openings -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Seven typical openings.</h2>
          <p class="min-lead">On the outbound side, the first sentence usually sounds like one of these.</p>
        </div>
        <div class="min-index flows-openings-list" data-reveal>
          <a class="min-index__row" href={pathFor('agencies/beyondbridge', locale)}>
            <h3 class="min-index__title">&#8220;We have a trade show in Germany in three months and nothing online that looks credible.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">Starter package.</span> Ninety days to brand, LinkedIn, and a Western-facing website.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
          <a class="min-index__row" href={pathFor('agencies/beyondbridge', locale)}>
            <h3 class="min-index__title">&#8220;We have presence but no inbound.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">Growth package.</span> SEO, GEO, and Google Ads layered on the Starter foundation.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
          <a class="min-index__row" href={pathFor('agencies/beyondbridge', locale)}>
            <h3 class="min-index__title">&#8220;We have inbound. Nobody in Europe to handle it.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">Full Pipeline.</span> Add the in-market sales force. Named reps in the US, UK, DE, FR.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
          <a class="min-index__row" href={pathFor('ai-services', locale)}>
            <h3 class="min-index__title">&#8220;Our LinkedIn is empty and our execs do not post.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">AI Services, Nuvora Studio.</span> LinkedIn-only B2B specialist. Strategy, content, ads, exec posting.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
          <a class="min-index__row" href={pathFor('agencies/beyondbridge', locale)}>
            <h3 class="min-index__title">&#8220;Our pitch sounds translated.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">BeyondBridge brand.</span> A brand built for Western B2B buyers, not transposed from Chinese.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
          <a class="min-index__row" href={pathFor('agencies/beyondbridge', locale)}>
            <h3 class="min-index__title">&#8220;Western buyers cannot find us on Google or in ChatGPT.&#8221;</h3>
            <p class="min-index__body"><span class="flows-opening__by">SEO and GEO.</span> Rank on Google. Get cited by ChatGPT, Perplexity and Gemini.</p>
            <span class="min-index__arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <a class="min-card flows-band" href={pathFor('contact', locale)} data-reveal>
          <p class="flows-opening__quote">&#8220;We are not sure where to start.&#8221;</p>
          <div class="flows-opening__answer flows-band__answer">
            <span class="flows-opening__by">Book a call</span>
            <span class="min-small">Thirty minutes. We tell you which tier, and what 90 days look like.</span>
          </div>
        </a>
      </div>
    </section>

    <!-- 10 · Compounding -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow" data-reveal>
        <h2 class="min-h2">Rankings compound. Relationships compound. Authority compounds.</h2>
        <p class="min-lead flows-compound__lead">
          Every month without Western presence is deals lost to competitors who got there first. Every quarter
          without pipeline is budget burned on trade shows, translators, and cold outreach going nowhere. Every
          year you wait, the cost of catching up doubles. The Chinese companies winning overseas right now started
          two years ago.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </section>

    <!-- 11 · Production engine -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split" data-reveal>
          <div>
            <h2 class="min-h2">A production engine the agencies share. Both flows.</h2>
            <p class="min-body min-split__body">
              Every engagement on this page, inbound or outbound, plugs into HubStudio's content production
              engine. That is what keeps content cost competitive at the volumes both sides demand: three to
              five RedNote posts a week and daily Douyin video on the China side; weekly LinkedIn drops,
              monthly campaign refreshes and asset libraries on the overseas side. Without an AI-native
              content engine behind it, the math does not work, in either direction.
            </p>
            <a class="min-btn min-btn--ghost" href={pathFor('agencies/hubstudio', locale)}>Visit HubStudio</a>
          </div>
          <figure class="min-photo min-photo--tall flows-aigc">
            <img
              src="/images/AIGC-For-Brands.webp"
              alt="HubStudio content production for both inbound and outbound brands"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .flows-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .flows-jump {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    min-width: 180px;
  }
  .flows-jump__name {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .flows-hero__photo { margin-top: var(--space-6); }

  .flows-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-4);
  }

  .flows-req-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .flows-req { display: flex; flex-direction: column; gap: var(--space-3); }
  .flows-req .min-h3 { margin: 0; }
  .flows-req__pill { margin-top: auto; align-self: flex-start; }

  .flows-agencies { margin-top: var(--space-5); }
  .flows-agency__logo { display: flex; align-items: center; height: 32px; }
  .flows-agency__logo :global(.agency-card-logo) { height: 26px; width: auto; max-width: 140px; }
  .flows-agency .min-h3 { margin: 0; }
  .flows-card__cta { margin-top: auto; align-self: flex-start; }

  .flows-openings { margin-top: var(--space-5); }
  .flows-opening { display: flex; flex-direction: column; gap: var(--space-3); }
  .flows-opening__quote {
    margin: 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .flows-opening__answer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .flows-opening__by {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .flows-pkgs { margin-top: var(--space-5); }
  .flows-pkg__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .flows-pkg__tier {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .flows-pkg .min-h3 { margin: 0; }
  .flows-pkg__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .flows-pkg__features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--body);
  }
