---
import Layout from '../layouts/Layout.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'Media and software we operate';
const description = 'Media and software BearingBridge owns and operates, built on the same AI stack we sell to clients. Public proof that it works.';
---

<Layout locale={locale} route="products" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="min-hero__grid">
          <div>
            <h1 class="min-hero__title" data-reveal>We build products. And we run them.</h1>
            <p class="min-hero__lead" data-reveal style="--i: 1">
              Consulting proves itself slowly. Products prove themselves in public. This is where we run the
              group's AI stack, with our own money at stake. Operating businesses teaches what advising them
              never will.
            </p>
          </div>
          <figure class="min-photo min-photo--cover" data-reveal style="--i: 1">
            <img
              src="/images/photo-practice-products.webp"
              alt="A small dog on a couch next to a person with a laptop."
              width="1050"
              height="620"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- 2 · Portfolio -->
    <section class="min-sec" id="portfolio">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>Live today, next in build.</h2>

        <div class="min-grid-2 product-grid">
          <div class="min-card product-card" id="bbchien" data-reveal>
            <figure class="min-photo">
              <img
                class="product-card__shot"
                src="/images/bbchien-home.webp"
                alt="The BBChien homepage."
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="product-card__meta">
              <img class="product-card__logo" src="/AgencyLogos/bbchien-lockup-color.svg" alt="BBChien" width="460" height="128" loading="lazy" decoding="async" />
              <span class="min-meta">media · France · live</span>
            </div>
            <h3 class="min-h3">An independent French media on dogs.</h3>
            <p class="min-small product-card__body">
              A media site for French dog owners: a complete breed library, sourced practical guides,
              interactive tools, and a professional directory. We built it and run it on our
              <a href={pathFor('ai-services', locale)}>AI content and publishing stack</a>, and it is
              financed without animal-brand money. Live at bbchien.fr today.
            </p>
            <a class="min-btn min-btn--ghost product-card__btn" href="https://bbchien.fr" target="_blank" rel="noreferrer">bbchien.fr ↗</a>
          </div>

          <div class="min-card product-card" id="deuceladder" data-reveal style="--i: 1">
            <figure class="min-photo">
              <img
                class="product-card__shot"
                src="/images/deuceladder-placeholder.webp"
                alt="DeuceLadder, in build"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="product-card__meta">
              <span class="product-card__name">DeuceLadder</span>
              <span class="min-meta">software · in build</span>
            </div>
            <h3 class="min-h3">The next one over the bridge.</h3>
            <p class="min-small product-card__body">In build now, on the same stack.</p>
            <span class="min-muted product-card__launch">deuceladder.com opens at launch</span>
          </div>
        </div>

        <p class="min-muted product-more" data-reveal>
          The portfolio keeps growing. We are always building something, and we are open to conversations
          about co-building or acquiring. <a href={pathFor('contact', locale)}>Book a call</a>
        </p>
      </div>
    </section>

    <!-- 3 · The reason -->
    <section class="min-sec min-sec--ruled" id="reason">
      <div class="min-wrap">
        <div class="min-narrow" data-reveal>
          <div>
            <h2 class="min-h2">The stack, with skin in the game.</h2>
            <p class="min-body min-split__body">
              Client work shows what the stack can do on someone else's budget. These products show what it does
              on ours: real traffic, real costs, and no way to hide when something breaks.
            </p>
            <blockquote class="min-serif-quote">What survives here is what we recommend there.</blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 product-cta__title">Talk products.</h2>
        <p class="min-body product-cta__body">
          To co-build or acquire, or just to see how the stack runs a real business, write to
          <a href="mailto:hello@bearingbridge.com">hello@bearingbridge.com</a>. If you came for the services
          side, that is <a href={pathFor('ai-services', locale)}>AI Services</a> and
          <a href={pathFor('cross-border-marketing', locale)}>Cross-Border Marketing</a>.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .product-grid { align-items: stretch; }
  .product-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .product-card .min-h3 { margin-bottom: 0; }
  .product-card__shot { aspect-ratio: 1408 / 832; }
  .product-card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .product-card__logo { height: 26px; width: auto; }
  .product-card__name {
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .product-card__body a,
  .product-more a,
  .product-cta__body a {
    color: var(--ink);
    font-weight: 600;
    border-bottom: 1px solid var(--line);
    transition: border-color 200ms ease;
  }
  .product-card__body a:hover,
  .product-more a:hover,
  .product-cta__body a:hover { border-color: var(--ink); }
  .product-card__btn { margin-top: auto; align-self: flex-start; }
  .product-card__launch { margin-top: auto; }
  .product-more { margin-top: var(--space-5); max-width: 68ch; }

  .product-cta__title { margin-inline: auto; }
  .product-cta__body { margin: 0 auto var(--space-5); }
</style>
