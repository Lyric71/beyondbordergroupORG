---
import Layout from '../layouts/Layout.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'The bridge';
const description = "The gap between China and the West is not language. It is brand, channel, infrastructure, search, and sales. A specialist group built around that.";

const gaps = [
  {
    title: 'Brand',
    west: 'Quality reads as restraint. One ask, lots of room around it.',
    china: 'Quality reads as proof. Awards, partners, signals up front.',
    summary: 'Both sides read the other as wrong.',
  },
  {
    title: 'Content',
    west: 'Buyers read before they decide. Long-form earns the meeting.',
    china: 'Buyers watch before they decide. Short video earns the click.',
    summary: 'Format is the message.',
  },
  {
    title: 'Channel',
    west: 'B2B starts on LinkedIn. B2C starts on Instagram, TikTok, YouTube.',
    china: 'B2B starts on WeChat and Maimai. B2C starts on RedNote and Douyin.',
    summary: 'B2B and B2C run on different networks, on both sides.',
  },
  {
    title: 'Commerce',
    west: 'Open rails. Own site, then Amazon, then distributors.',
    china: 'Platform rails. Tmall, JD, Douyin, WeChat, distributors. Each its own economy.',
    summary: 'Different storefronts, different rules.',
  },
  {
    title: 'Web',
    west: 'Open web. Hosted anywhere, indexed by Google.',
    china: 'Walled web. Hosted in country, ICP-licensed, indexed by Baidu.',
    summary: 'Two indexes, two infrastructures.',
  },
  {
    title: 'Search',
    west: 'Western models, Western sources. ChatGPT, Perplexity, Gemini.',
    china: 'Chinese models, Chinese sources. DeepSeek, Doubao, Kimi.',
    summary: 'AI is the first stop, and it is already split.',
  },
];
---

<Layout locale={locale} route="bridge" title={title} description={description}>
  <div class="min">
    <!-- 1 · Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <h1 class="min-hero__title" data-reveal>
          The bridge between China and the West, built by people who have worked both sides.
        </h1>
        <figure class="min-photo min-photo--wide bridge-hero__photo" data-reveal style="--i: 1">
          <img
            src="/images/photo-bridge.webp"
            alt="A modern bridge over water at dawn."
            width="1050"
            height="620"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · The six gaps -->
    <section class="min-sec" id="gaps">
      <div class="min-wrap">
        <div data-reveal>
          <h2 class="min-h2">Not a language gap. Six gaps underneath it.</h2>
          <p class="min-lead">
            A name that works in Shanghai can fall flat in Frankfurt. A translated tagline reads off, in either direction.
          </p>
        </div>
        <div class="min-grid-3 bridge-gaps">
          {gaps.map((g, i) => (
            <article class="min-card bridge-gap" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{g.title}</h3>
              <div class="bridge-gap__side">
                <span class="min-tag min-tag--blue">West</span>
                <p class="min-small">{g.west}</p>
              </div>
              <div class="bridge-gap__side">
                <span class="min-tag min-tag--red">China</span>
                <p class="min-small">{g.china}</p>
              </div>
              <p class="min-muted bridge-gap__summary">{g.summary}</p>
            </article>
          ))}
        </div>
        <p class="min-kicker" data-reveal>
          Each side needs its own specialist team. The group is built around that fact.
        </p>
      </div>
    </section>

    <!-- 3 · The full chain -->
    <section class="min-sec min-sec--ruled" id="chain">
      <div class="min-wrap">
        <div class="min-split" data-reveal>
          <figure class="min-photo min-photo--tall bridge-team">
            <img
              src="/images/china-office.webp"
              alt="The China office team at work."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <h2 class="min-h2">Most agencies solve one piece. We run the full chain, in pieces.</h2>
            <p class="min-body bridge-chain__p">
              A generalist agency that does both usually does both badly. The org chart says yes. The execution
              says no.
            </p>
            <p class="min-body bridge-chain__p">
              The clients are different too. A Shanghai brief is not a Frankfurt brief. The references shift,
              the channels shift, the working hours shift. Each side needs its own kind of specialist.
            </p>
            <p class="min-body bridge-chain__p">
              You do not always need the whole stack. Sometimes you just need a Chinese website, or a LinkedIn
              engine. Buying it as a one-off ships faster than a generalist retainer.
            </p>
            <p class="min-body bridge-chain__p">
              The pieces are stronger together than apart. The same content production engine feeds RedNote
              posts and Google Ads pages. Specialists who share a spine beat specialists who do not.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · Two flows CTA -->
    <section class="min-sec min-sec--ruled" id="two-flows">
      <div class="min-wrap min-narrow" data-reveal>
        <h2 class="min-h2">Two flows, same spine.</h2>
        <p class="min-lead bridge-cta__lead">
          Enter China or go overseas. The shape of the work is mirrored. The team in front of you is not.
        </p>
        <a class="min-btn" href={pathFor('two-flows', locale)}>Open Two flows</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bridge-hero__photo { margin-top: var(--space-6); }

  .bridge-gaps { margin-top: var(--space-5); }
  .bridge-gap { display: flex; flex-direction: column; gap: var(--space-3); }
  .bridge-gap .min-h3 { margin: 0; }
  .bridge-gap__side { display: flex; flex-direction: column; gap: 0.35rem; }
  .bridge-gap__side .min-tag { margin-bottom: 0; align-self: flex-start; }
  .bridge-gap__summary {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .bridge-team { max-width: 440px; width: 100%; }
  .bridge-chain__p { margin: 0 0 var(--space-3); }
  .bridge-chain__p:last-child { margin-bottom: 0; }

  .bridge-cta__lead { margin: 0 0 var(--space-5); }
</style>
