---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/bearingbridge' as const;

type ServiceKey = 'enter' | 'grow' | 'learn';
const services: Array<{
  key: ServiceKey;
  title: string;
  intro: string;
  image: string;
  tag: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'enter',
    title: 'Enter China',
    intro: 'The roadmap, the build, and the doors that open the market.',
    image: '/images/bbg-enter-doorway.webp',
    tag: 'min-tag--blue',
    items: [
      { name: 'Market Entry Consulting', body: 'The roadmap to enter China, from positioning to platform choice to budget.' },
      { name: 'Branding & Localisation', body: 'Chinese name, visual identity, packaging and tone of voice adapted for the local market.' },
      { name: 'Cross-Border eCommerce Setup', body: 'Tmall Global, JD Worldwide and Douyin store opening, no Chinese entity required.' },
      { name: 'Distribution', body: 'Sourcing, vetting and contracting the right distributors for offline and wholesale channels.' },
    ],
  },
  {
    key: 'grow',
    title: 'Grow in China',
    intro: 'Daily operations on every channel that moves the needle.',
    image: '/images/bbg-grow-flatlay.webp',
    tag: 'min-tag--red',
    items: [
      { name: 'Cross-Border eCommerce Operations', body: 'Daily store management, customer service, promotions and campaigns on Tmall, JD and Douyin.' },
      { name: 'Social Commerce', body: 'Xiaohongshu, Douyin and WeChat content, KOL and live-streaming to drive sales.' },
      { name: 'Media', body: 'Paid media planning and buying across Chinese platforms, performance and brand.' },
      { name: 'Website', body: 'Chinese website design, build and hosting inside the Great Firewall, with ICP filing.' },
      { name: 'PR and Press Relations', body: 'Chinese media outreach, press releases and crisis communications.' },
      { name: 'Offline Events and Exhibitions', body: 'Trade shows, pop-ups, brand activations and retail events on the ground.' },
    ],
  },
  {
    key: 'learn',
    title: 'Learn China',
    intro: 'Trainings, expeditions, and research that build real fluency.',
    image: '/images/bbg-learn-desk.webp',
    tag: 'min-tag--yellow',
    items: [
      { name: 'Masterclass', body: 'Half-day and full-day training sessions on China platforms, consumers and trends, in your office or ours.' },
      { name: 'Learning Expeditions', body: 'Multi-day immersive trips to Shanghai and Shenzhen for executive teams.' },
      { name: 'Insights', body: 'Market reports, consumer research and trend briefings on demand.' },
    ],
  },
];

const visitUrl = 'https://thechinapath.com';
const visitLabel = 'Visit thechinapath.com';
---

<Layout
  locale={locale}
  route={route}
  title="TheChinaPath. Enter China, grow in China, learn China."
  description="Fifteen years helping brands enter, grow, and learn China. Full-service: market entry, eCommerce, social commerce, media, PR, masterclasses."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="tcp-hero">
          <div>
            <span class="min-chip tcp-hero__logo" data-reveal>
              <AgencyLogo slug="bearingbridge" name="TheChinaPath" />
            </span>
            <span class="min-tag min-tag--red tcp-hero__eyebrow" data-reveal style="--i: 1">
              15 years on the ground in Shanghai, Hong Kong and Paris
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              We help brands <em>Enter China</em>, <em>Grow in China</em>, and <em>Learn China</em>.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">We consult, and we run what we recommend. No templates. No recycled decks. Just the work.</p>
            <div class="min-ctas tcp-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide tcp-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/thechinapath-home.webp" alt="thechinapath.com homepage" width="1600" height="1000" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="min-sec" id="track">
      <div class="min-wrap">
        <div class="tcp-track" data-reveal>
          <span class="tcp-track__num" aria-hidden="true">15</span>
          <div>
            <h2 class="min-h2">Fifteen years inside China's commerce ecosystem.</h2>
            <p class="min-body">
              We know what works because we have done it. We know what fails because we have seen it. Through Tmall launches, Douyin storms, ICP rewrites, and every algorithm shift in between.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Three lanes. One team.<br />
            End to end.
          </h2>
          <p class="min-lead tcp-services__lead">From the first market study to the next live-stream campaign on Douyin. Pick the lane that fits your moment, or run all three.</p>
        </header>

        {services.map((s, i) => (
          <div class={`min-split ${i % 2 === 1 ? 'min-split--reverse' : ''} tcp-lane`} data-reveal>
            {i % 2 === 1 ? (
              <>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta tcp-lane__count">{s.items.length} services</p>
                  <p class="min-body tcp-lane__intro">{s.intro}</p>
                  <ul class="tcp-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="min-photo min-photo--tall tcp-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
              </>
            ) : (
              <>
                <figure class="min-photo min-photo--tall tcp-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta tcp-lane__count">{s.items.length} services</p>
                  <p class="min-body tcp-lane__intro">{s.intro}</p>
                  <ul class="tcp-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- How we operate -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <h2 class="min-h2" data-reveal>
          China moves fast.<br />
          Platforms change every quarter.<br />
          Consumers change every week.
        </h2>
        <p class="min-kicker" data-reveal style="--i: 1">We consult, and we run what we recommend. The work is the deliverable.</p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 tcp-cta__title">Enter, grow, learn China.<br />With a team that has done it.</h2>
        <div class="min-ctas tcp-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .tcp-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .tcp-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .tcp-hero__logo {
    display: inline-flex;
    margin-bottom: var(--space-4);
  }
  .tcp-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .tcp-hero__eyebrow { display: inline-block; }
  .tcp-hero__ctas { margin-top: var(--space-2); }
  .tcp-hero__shot { display: block; }
  .tcp-hero__shot img { aspect-ratio: 16 / 10; object-position: center top; }

  .tcp-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .tcp-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .tcp-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .tcp-track .min-body { margin: 0; }

  .tcp-services__lead { margin-bottom: var(--space-6); }
  .tcp-lane { align-items: start; }
  .tcp-lane + .tcp-lane { margin-top: var(--space-7); }
  .tcp-lane__count { margin: 0 0 var(--space-3); }
  .tcp-lane__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .tcp-lane__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .tcp-lane__list strong { color: var(--ink); font-weight: 600; }
  .tcp-lane__photo { max-width: 440px; width: 100%; }
  .tcp-lane__photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .tcp-lane__photo { max-width: 100%; }
    .tcp-lane__photo img { aspect-ratio: 16 / 9; }
  }

  .tcp-cta__title { margin-inline: auto; }
  .tcp-cta__actions { justify-content: center; }
</style>
