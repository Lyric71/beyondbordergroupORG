---
import Layout from '../../layouts/Layout.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/bearingbridge' as const;

type ServiceKey = 'enter' | 'grow' | 'learn';
const services: Array<{
  key: ServiceKey;
  title: string;
  intro: string;
  image: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'enter',
    title: 'Enter China',
    intro: 'The roadmap, the build, and the doors that open the market.',
    image: '/images/bbg-enter-doorway.webp',
    items: [
      { name: 'Market Entry Consulting', body: 'The roadmap to enter China, from positioning to platform choice to budget.' },
      { name: 'Branding & Localisation', body: 'Chinese name, visual identity, packaging and tone of voice adapted for the local market.' },
      { name: 'Cross-Border eCommerce Setup', body: 'Tmall Global, JD Worldwide and Douyin store opening, no Chinese entity required.' },
      { name: 'Distribution', body: 'Sourcing, vetting and contracting the right distributors for offline and wholesale channels.' },
    ],
  },
  {
    key: 'grow',
    title: 'Grow in China',
    intro: 'Daily operations on every channel that moves the needle.',
    image: '/images/bbg-grow-flatlay.webp',
    items: [
      { name: 'Cross-Border eCommerce Operations', body: 'Daily store management, customer service, promotions and campaigns on Tmall, JD and Douyin.' },
      { name: 'Social Commerce', body: 'Xiaohongshu, Douyin and WeChat content, KOL and live-streaming to drive sales.' },
      { name: 'Media', body: 'Paid media planning and buying across Chinese platforms, performance and brand.' },
      { name: 'Website', body: 'Chinese website design, build and hosting inside the Great Firewall, with ICP filing.' },
      { name: 'PR and Press Relations', body: 'Chinese media outreach, press releases and crisis communications.' },
      { name: 'Offline Events and Exhibitions', body: 'Trade shows, pop-ups, brand activations and retail events on the ground.' },
    ],
  },
  {
    key: 'learn',
    title: 'Learn China',
    intro: 'Trainings, expeditions, and research that build real fluency.',
    image: '/images/bbg-learn-desk.webp',
    items: [
      { name: 'Masterclass', body: 'Half-day and full-day training sessions on China platforms, consumers and trends, in your office or ours.' },
      { name: 'Learning Expeditions', body: 'Multi-day immersive trips to Shanghai and Shenzhen for executive teams.' },
      { name: 'Insights', body: 'Market reports, consumer research and trend briefings on demand.' },
    ],
  },
];

const visitUrl = 'https://thechinapath.com';
const visitLabel = 'Visit thechinapath.com';
---

<Layout
  locale={locale}
  route={route}
  title="TheChinaPath. Enter China, grow in China, learn China."
  description="Fifteen years helping brands enter, grow, and learn China. Full-service: market entry, eCommerce, social commerce, media, PR, masterclasses."
>
  <!-- ====================================================================== -->
  <!-- HERO: cinematic dark, full-bleed atmosphere, parallax browser preview  -->
  <!-- ====================================================================== -->
  <section class="bbg-hero" data-hero>
    <div class="bbg-hero__bg" aria-hidden="true">
      <img src="/images/bbg-shanghai-twilight.webp" alt="" class="bbg-hero__bg-img" />
      <div class="bbg-hero__bg-scrim"></div>
      <div class="bbg-hero__bg-grain"></div>
      <div class="bbg-hero__bg-grid"></div>
    </div>

    <div class="container bbg-hero__main">
      <div class="bbg-hero__content">
        <img src="/images/thechinapath-horizontal.png" alt="TheChinaPath" class="bbg-hero__logo" width="160" height="69" loading="eager" decoding="async" />

        <span class="bbg-hero__eyebrow">
          15 years on the ground in Shanghai, Hong Kong and Paris
        </span>

        <h1 class="bbg-hero__title">
          <span class="bbg-hero__line" data-anim="word">We help brands</span>
          <span class="bbg-hero__line" data-anim="word">
            <em class="bbg-hero__phrase">Enter China</em>,
          </span>
          <span class="bbg-hero__line" data-anim="word">
            <em class="bbg-hero__phrase">Grow in China</em>,
          </span>
          <span class="bbg-hero__line" data-anim="word">
            and <em class="bbg-hero__phrase">Learn China</em>.
          </span>
        </h1>

        <p class="bbg-hero__lead" data-anim="fade">We consult, and we run what we recommend. No templates. No recycled decks. Just the work.</p>

        <div class="bbg-hero__cta-row" data-anim="fade">
          <a class="pill-cta" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}
            <span class="pill-cta__disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></span>
          </a>
          <a class="pill-ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>

      <div class="bbg-hero__preview" data-tilt>
        <div class="bbg-hero__preview-frame">
          <div class="bbg-bezel">
          <a class="browser-link" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel}>
            <div class="browser">
              <div class="browser__viewport">
                <img src="/images/thechinapath-home.webp" alt="thechinapath.com homepage" class="browser__shot" width="1600" height="1000" loading="eager" decoding="async" />
                <span class="browser__visit" aria-hidden="true">
                  <span>Visit site</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l10-10M7 7h10v10"/></svg>
                </span>
              </div>
            </div>
          </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- TRACK RECORD: editorial number + marquee of clients                    -->
  <!-- ====================================================================== -->
  <section class="bbg-track" id="track">
    <div class="container">
      <div class="bbg-track__grid">
        <div class="bbg-track__numeral" aria-hidden="true">
          <span class="bbg-track__num" data-count="15">0</span>
          <span class="bbg-track__num-shadow">15</span>
        </div>
        <div class="bbg-track__copy">
          <h2 class="bbg-track__title balance">Fifteen years inside China's commerce ecosystem.</h2>
          <p class="bbg-track__lead">
            We know what works because we have done it. We know what fails because we have seen it. Through Tmall launches, Douyin storms, ICP rewrites, and every algorithm shift in between.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- SERVICES: tabbed editorial panels with image + service list            -->
  <!-- ====================================================================== -->
  <section class="bbg-services" id="services">
    <div class="container">
      <header class="bbg-services__header">
        <h2 class="bbg-services__title">
          Three lanes. <em>One team.</em><br />
          End to end.
        </h2>
        <p class="bbg-services__lead">From the first market study to the next live-stream campaign on Douyin. Pick the lane that fits your moment, or run all three.</p>
      </header>

      <div class="bbg-services__bezel">
      <div class="bbg-services__shell" data-tabs>
        <div class="bbg-services__nav" role="tablist" aria-label="Service lanes">
          {services.map((s, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              class={`bbg-services__tab bbg-services__tab--${s.key} ${i === 0 ? 'is-active' : ''}`}
              data-tab={s.key}
              id={`bbg-tab-${s.key}`}
              aria-controls={`bbg-panel-${s.key}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="bbg-services__tab-pip" aria-hidden="true"></span>
              <span class="bbg-services__tab-label">{s.title}</span>
              <span class="bbg-services__tab-count">{s.items.length} services</span>
            </button>
          ))}
          <span class="bbg-services__tab-indicator" aria-hidden="true"></span>
        </div>

        <div class="bbg-services__panels">
          {services.map((s, i) => (
            <div
              class={`bbg-services__panel bbg-services__panel--${s.key} ${i === 0 ? 'is-active' : ''}`}
              role="tabpanel"
              id={`bbg-panel-${s.key}`}
              aria-labelledby={`bbg-tab-${s.key}`}
              data-panel={s.key}
              hidden={i !== 0}
            >
              <div class="bbg-services__panel-grid">
                <div class="bbg-services__panel-image">
                  <div class="bbg-services__panel-frame">
                    <img src={s.image} alt={`${s.title} editorial`} loading="lazy" decoding="async" />
                    <div class={`bbg-services__panel-tag bbg-services__panel-tag--${s.key}`}>
                      <span>{s.title}</span>
                    </div>
                  </div>
                  <div class={`bbg-services__panel-stamp bbg-services__panel-stamp--${s.key}`} aria-hidden="true">
                    {s.key === 'enter' && '入'}
                    {s.key === 'grow' && '长'}
                    {s.key === 'learn' && '学'}
                  </div>
                </div>

                <div class="bbg-services__panel-content">
                  <p class="bbg-services__panel-intro">{s.intro}</p>
                  <ul class="bbg-services__list">
                    {s.items.map((it) => (
                      <li class="bbg-services__item">
                        <span class={`bbg-services__item-pip bbg-services__item-pip--${s.key}`} aria-hidden="true"></span>
                        <span class="bbg-services__item-text">
                          <span class="bbg-services__item-name">{it.name}.</span>
                          <span class="bbg-services__item-body">{it.body}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- HOW WE OPERATE: editorial dark statement with line reveal              -->
  <!-- ====================================================================== -->
  <section class="bbg-operate">
    <div class="bbg-operate__bg" aria-hidden="true"></div>
    <div class="container bbg-operate__container">
      <h2 class="bbg-operate__title">
        <span class="bbg-operate__line" data-line>China moves fast.</span>
        <span class="bbg-operate__line" data-line>Platforms change every quarter.</span>
        <span class="bbg-operate__line" data-line>Consumers change every week.</span>
      </h2>
      <div class="bbg-operate__statement" data-line>
        <p class="bbg-operate__emphasis">We consult, and we run what we recommend. The work is the deliverable.</p>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- FINAL CTA: cinematic full-bleed                                        -->
  <!-- ====================================================================== -->
  <section class="bbg-cta">
    <div class="bbg-cta__bg" aria-hidden="true">
      <img src="/images/bbg-shanghai-twilight.webp" alt="" />
      <div class="bbg-cta__bg-scrim"></div>
    </div>
    <div class="container bbg-cta__content">
      <h2 class="bbg-cta__title balance">Enter, grow, learn China.<br />With a team that has done it.</h2>
      <div class="bbg-cta__actions">
        <a class="pill-cta" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}
          <span class="pill-cta__disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></span>
        </a>
        <a class="pill-ghost" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===================================================================== */
  /* HERO                                                                   */
  /* ===================================================================== */
  .bbg-hero {
    position: relative;
    min-height: 88dvh;
    padding: clamp(2.5rem, 5vh, 4rem) 0 clamp(3rem, 6vh, 5rem);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #0c1220;
  }

  .bbg-hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .bbg-hero__bg-img {
    position: absolute;
    inset: -8% -4% -4% -4%;
    width: 108%;
    height: 112%;
    object-fit: cover;
    object-position: center 40%;
    transform: scale(1.04);
    filter: saturate(0.85) contrast(1.05) brightness(0.78);
  }
  .bbg-hero__bg-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, rgba(8, 12, 24, 0.86) 0%, rgba(8, 12, 24, 0.62) 38%, rgba(8, 12, 24, 0.30) 65%, rgba(8, 12, 24, 0.55) 100%),
      linear-gradient(180deg, rgba(8, 12, 24, 0.55) 0%, rgba(8, 12, 24, 0.05) 30%, rgba(8, 12, 24, 0.0) 60%, rgba(8, 12, 24, 0.85) 100%);
  }
  .bbg-hero__bg-grain {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1200px 600px at 20% 30%, rgba(38,154,218,0.18), transparent 65%),
      radial-gradient(900px 500px at 90% 80%, rgba(200,16,46,0.14), transparent 70%);
    mix-blend-mode: screen;
  }
  .bbg-hero__bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 80%);
    opacity: 0.7;
  }

  .bbg-hero__main {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .bbg-hero__content { min-width: 0; max-width: 36rem; }
  .bbg-hero__logo {
    display: block;
    width: auto;
    height: 36px;
    filter: brightness(0) invert(1) drop-shadow(0 2px 12px rgba(0,0,0,0.4));
    margin-bottom: var(--space-5);
    opacity: 0;
    animation: bbgFadeIn 700ms cubic-bezier(0.2,0.8,0.2,1) 0.1s forwards;
  }

  .bbg-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    margin-bottom: var(--space-4);
    opacity: 0;
    animation: bbgFadeIn 700ms cubic-bezier(0.2,0.8,0.2,1) 0.2s forwards;
  }

  .bbg-hero__title {
    font-size: clamp(2.5rem, 5vw + 0.5rem, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: #fff;
    margin: 0 0 var(--space-5);
    max-width: 14ch;
    text-wrap: balance;
  }
  .bbg-hero__line {
    display: block;
    overflow: hidden;
  }
  .bbg-hero__line[data-anim="word"] {
    transform: translateY(110%);
    opacity: 0;
    animation: bbgWordIn 880ms cubic-bezier(0.2, 0.9, 0.2, 1) forwards;
  }
  .bbg-hero__line[data-anim="word"]:nth-child(1) { animation-delay: 0.30s; }
  .bbg-hero__line[data-anim="word"]:nth-child(2) { animation-delay: 0.42s; }
  .bbg-hero__line[data-anim="word"]:nth-child(3) { animation-delay: 0.54s; }
  .bbg-hero__line[data-anim="word"]:nth-child(4) { animation-delay: 0.66s; }
  @keyframes bbgWordIn {
    from { transform: translateY(110%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .bbg-hero__phrase {
    font-style: normal;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    position: relative;
    background-image: linear-gradient(120deg, #ff7a8a 0%, #c8102e 60%, #ff7a8a 100%);
  }

  .bbg-hero__lead {
    max-width: 44ch;
    font-size: clamp(1.05rem, 0.6vw + 0.95rem, 1.2rem);
    color: rgba(255,255,255,0.82);
    margin: 0 0 var(--space-5);
    opacity: 0;
    animation: bbgFadeIn 700ms cubic-bezier(0.2,0.8,0.2,1) 0.85s forwards;
  }

  .bbg-hero__cta-row {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    opacity: 0;
    animation: bbgFadeIn 700ms cubic-bezier(0.2,0.8,0.2,1) 1s forwards;
  }

  /* Shared pills, page accent */
  .pill-cta {
    background: #c8102e;
    box-shadow: 0 16px 36px -12px rgba(200,16,46,0.45);
  }
  .pill-cta:hover { background: #a00d25; }

  /* Browser preview with parallax tilt */
  .bbg-hero__preview {
    position: relative;
    perspective: 1600px;
    min-width: 0;
    opacity: 0;
    animation: bbgFadeIn 900ms cubic-bezier(0.2,0.8,0.2,1) 0.5s forwards;
  }
  .bbg-hero__preview-frame {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateY(var(--tilt-x, -3deg)) rotateX(var(--tilt-y, 2deg));
    transition: transform 600ms cubic-bezier(0.2,0.8,0.2,1);
  }
  .bbg-bezel {
    padding: 6px;
    border-radius: 28px;
    background: rgba(255,255,255,0.06);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.1),
      0 40px 80px -28px rgba(0,0,0,0.55),
      0 12px 28px -8px rgba(0,0,0,0.35);
    transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .bbg-bezel:hover { transform: translateY(-4px); }
  .browser-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    border-radius: 22px;
  }
  .browser-link:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .browser-link:hover .browser__visit { opacity: 1; transform: translateY(0); }
  .browser {
    position: relative;
    background: #ffffff;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.12);
    transform: translateZ(0);
  }
  .browser__visit {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border-radius: 999px;
    background: rgba(15,23,42,0.85);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 240ms ease, transform 240ms cubic-bezier(0.2,0.8,0.2,1);
    pointer-events: none;
  }
  .browser__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #f7f9fb;
    overflow: hidden;
  }
  .browser__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  @keyframes bbgFadeIn { to { opacity: 1; } }

  @media (max-width: 1023px) {
    .bbg-hero__main { grid-template-columns: 1fr; gap: var(--space-7); }
    .bbg-hero__title { max-width: none; }
  }

  /* ===================================================================== */
  /* TRACK RECORD                                                           */
  /* ===================================================================== */
  .bbg-track {
    padding: clamp(5rem, 10vh, 8rem) 0 clamp(4rem, 8vh, 6rem);
    background: linear-gradient(180deg, #ffffff 0%, var(--bbg-paper) 100%);
    position: relative;
  }
  .bbg-track__grid {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-bottom: var(--space-8);
  }
  @media (max-width: 1023px) { .bbg-track__grid { grid-template-columns: 1fr; gap: var(--space-6); } }

  .bbg-track__numeral {
    position: relative;
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--bbg-ink);
  }
  .bbg-track__num {
    position: relative;
    z-index: 2;
    display: inline-block;
    font-size: clamp(7rem, 18vw, 16rem);
    background: linear-gradient(180deg, var(--bbg-ink) 0%, #3a3f4f 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .bbg-track__num-shadow {
    position: absolute;
    top: 4px; left: 5px;
    font-size: clamp(7rem, 18vw, 16rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(38,154,218,0.18);
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }
  .bbg-track__copy { max-width: 56ch; }
  .bbg-track__title { font-size: clamp(1.6rem, 2.4vw + 0.6rem, 2.4rem); line-height: 1.15; margin: 0 0 var(--space-4); }
  .bbg-track__lead { font-size: var(--fs-lead); color: var(--bbg-text); }

  /* ===================================================================== */
  /* SERVICES                                                               */
  /* ===================================================================== */
  .bbg-services {
    padding: clamp(5rem, 10vh, 8rem) 0;
    background: var(--bbg-white);
    position: relative;
  }

  .bbg-services__header {
    max-width: 60ch;
    margin: 0 0 var(--space-7);
  }
  .bbg-services__title {
    font-size: clamp(2rem, 3.6vw + 0.5rem, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: var(--space-3) 0 var(--space-4);
  }
  .bbg-services__title em {
    font-style: normal;
    color: #c8102e;
  }
  .bbg-services__lead { color: var(--bbg-text); font-size: var(--fs-lead); max-width: 60ch; }

  .bbg-services__bezel {
    padding: 6px;
    border-radius: 28px;
    background: rgba(10,20,30,0.04);
    box-shadow: 0 0 0 1px rgba(10,20,30,0.05);
  }
  .bbg-services__shell {
    position: relative;
    background: var(--bbg-paper);
    border-radius: 22px;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: 0 24px 50px -36px rgba(10,20,30,0.35);
  }

  .bbg-services__nav {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 6px;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: 16px;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
