    overflow: hidden;
  }
  .bbg-operate__bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(1100px 680px at 52% 48%, rgba(200,16,46,0.10), transparent 65%),
      radial-gradient(900px 500px at 0% 100%, rgba(38,154,218,0.18), transparent 60%),
      radial-gradient(800px 500px at 100% 0%, rgba(200,16,46,0.14), transparent 60%);
    pointer-events: none;
    z-index: -1;
  }
  .bbg-operate__container { position: relative; }
  .bbg-operate__title {
    display: flex;
    flex-direction: column;
    gap: 0.05em;
    font-size: clamp(2.2rem, 4.5vw + 0.5rem, 5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: var(--space-4) 0 var(--space-6);
