---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/nuvora-studio' as const;

type ServiceKey = 'build' | 'convert' | 'learn';
const services: Array<{
  key: ServiceKey;
  title: string;
  tag: string;
  intro: string;
  image: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'build',
    title: 'Build',
    tag: 'min-tag--blue',
    intro: 'Show up where buyers, hires, and investors are looking. Every day.',
    image: '/images/nuvora-build.webp',
    items: [
      { name: 'LinkedIn Content', body: 'Planned, written, and published to get your company seen by buyers. Built to drive leads, not just likes.' },
      { name: 'Executive Personal Branding', body: 'LinkedIn presence built for founders, CEOs, and senior leaders. Ghostwriting that sounds like you and earns trust at scale.' },
      { name: 'Employee Advocacy', body: 'Your team, turned into a content engine. Trained, equipped, and posting consistently. Reach multiplied.' },
    ],
  },
  {
    key: 'convert',
    title: 'Convert',
    tag: 'min-tag--green',
    intro: 'Reach the right decision makers and convert attention into pipeline.',
    image: '/images/nuvora-grow.webp',
    items: [
      { name: 'LinkedIn Advertising', body: 'Ad campaigns that bring qualified leads into your pipeline. Targeting, creative, and reporting tied to revenue. No budget burned on the wrong audience.' },
    ],
  },
  {
    key: 'learn',
    title: 'Learn',
    tag: 'min-tag--yellow',
    intro: 'Build the muscle in-house. Strategy first, lock-in never.',
    image: '/images/nuvora-learn.webp',
    items: [
      { name: 'Training and Workshops', body: 'Hands-on sessions for in-house teams. Algorithm, profile, content strategy. Practical from day one.' },
      { name: 'Consulting', body: 'A full audit of your current LinkedIn presence and the roadmap to grow it. Strategy first. Execution second.' },
    ],
  },
];

const visitUrl = 'https://nuvora.studio';
const visitLabel = 'Visit nuvora.studio';
---

<Layout
  locale={locale}
  route={route}
  title="Nuvora Studio: Get More Leads on LinkedIn"
  description="Nuvora Studio grows LinkedIn presence for B2B companies. Content, ads, executive branding, and more. Get qualified leads from decision makers."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="nv-hero">
          <div>
            <span class="min-chip nv-hero__logo" data-reveal>
              <AgencyLogo slug="nuvora-studio" name="Nuvora Studio" />
            </span>
            <span class="min-tag min-tag--blue nv-hero__eyebrow" data-reveal style="--i: 1">
              LinkedIn-only B2B lead generation
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              Your <em>buyers</em> check it. Your <em>hires</em> check it. Your <em>investors</em> check it.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">With over one billion members, LinkedIn is the world's professional record. We grow your presence on it. Every day.</p>
            <div class="min-ctas nv-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide nv-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/nuvora-studio-home.webp" alt="nuvora.studio homepage" width="1600" height="1000" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="min-sec" id="track">
      <div class="min-wrap">
        <div class="nv-track" data-reveal>
          <span class="nv-track__num" aria-hidden="true">1B+</span>
          <div>
            <h2 class="min-h2">One billion members. One platform that decides who gets the meeting.</h2>
            <p class="min-body">
              Empty company pages. Silent executives. Posts that read like press releases. Ad budgets spent on the wrong audience. That's lost pipeline, every week of it. We change that.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Build. Convert. Learn.
          </h2>
          <p class="min-lead nv-services__lead">From the first ghost-written post to a fully running paid pipeline. Pick the lane that fits your moment, or run all three.</p>
        </header>

        {services.map((s, i) => (
          <div class={`min-split ${i % 2 === 1 ? 'min-split--reverse' : ''} nv-lane`} data-reveal>
            {i % 2 === 1 ? (
              <>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta nv-lane__count">{s.items.length} {s.items.length === 1 ? 'service' : 'services'}</p>
                  <p class="min-body nv-lane__intro">{s.intro}</p>
                  <ul class="nv-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="min-photo nv-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
              </>
            ) : (
              <>
                <figure class="min-photo nv-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta nv-lane__count">{s.items.length} {s.items.length === 1 ? 'service' : 'services'}</p>
                  <p class="min-body nv-lane__intro">{s.intro}</p>
                  <ul class="nv-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- How we operate -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <h2 class="min-h2 nv-operate__title" data-reveal>
          LinkedIn is not a side channel.<br />
          Specialists beat generalists.<br />
          Activity is not the goal.
        </h2>
        <div data-reveal style="--i: 1">
          <p class="min-body nv-operate__p">Content earns attention. Ads convert it.</p>
          <p class="min-kicker nv-operate__emphasis">Qualified leads compound. Month after month.</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 nv-cta__title">More leads on LinkedIn.<br />From decision makers in your market.</h2>
        <div class="min-ctas nv-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .nv-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .nv-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .nv-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .nv-hero__logo :global(.agency-logo) { height: 24px; width: auto; }
  .nv-hero__eyebrow { display: inline-block; }
  .nv-hero__ctas { margin-top: var(--space-2); }
  .nv-hero__shot { display: block; }
  .nv-hero__shot img { aspect-ratio: 16 / 10; object-position: center top; }

  .nv-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .nv-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .nv-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(4.5rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: nowrap;
  }
  .nv-track .min-body { margin: 0; }

  .nv-services__lead { margin-bottom: var(--space-6); }
  .nv-lane { align-items: start; }
  .nv-lane + .nv-lane { margin-top: var(--space-7); }
  .nv-lane__count { margin: 0 0 var(--space-3); }
  .nv-lane__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .nv-lane__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .nv-lane__list strong { color: var(--ink); font-weight: 600; }
  .nv-lane__photo { max-width: 440px; width: 100%; }
  .nv-lane__photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .nv-lane__photo { max-width: 100%; }
    .nv-lane__photo img { aspect-ratio: 16 / 9; }
  }

  .nv-operate__title { max-width: none; }
  .nv-operate__p { margin-bottom: var(--space-3); }
  .nv-operate__emphasis { margin-top: var(--space-4); }

  .nv-cta__title { margin-inline: auto; }
  .nv-cta__actions { justify-content: center; }
</style>
