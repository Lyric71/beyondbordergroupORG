---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/bearingbridgeai' as const;

const visitUrl = 'https://www.bearingbridge.ai';
const visitLabel = 'Visit bearingbridge.ai';

const principles = [
  {
    title: 'A third of our answers are no',
    body: 'Roughly one in three use cases we assess gets a no, in writing, before anyone signs anything. A no in week one is worth far more than a yes that quietly falls apart in month four.',
  },
  {
    title: 'We sell no one’s software',
    body: 'No reseller agreements, no vendor incentives. Models get benchmarked at their actual API cost, on your task, and the recommendation rides on the numbers rather than on a partnership.',
  },
  {
    title: 'Your team runs it without us',
    body: 'Engagements are designed for independence. Training and handover sit inside the method, not on a separate invoice. When we walk out, the work keeps running and what we learned stays in the building.',
  },
];

const phases = [
  { name: 'Bearing', q: 'Decide where AI is worth pointing, then commit it to paper.' },
  { name: 'Data', q: 'Find it, clean it, move it to where the work happens.' },
  { name: 'Build', q: 'Whatever the use case calls for, built on your data.' },
  { name: 'Run', q: 'A small, timeboxed pilot on real data, with real users.' },
  { name: 'Fix', q: 'Same measurement as the baseline. Same method, new date.' },
  { name: 'Scale', q: 'Positive return proven, the pilot graduates to production.' },
];

type ServiceKey = 'data' | 'ai' | 'tech' | 'consulting';
const services: Array<{
  key: ServiceKey;
  name: string;
  meta: string;
  tag: string;
  intro: string;
  items: string[];
}> = [
  {
    key: 'data',
    name: 'Data',
    meta: 'The raw material',
    tag: 'min-tag--blue',
    intro: 'An honest audit of what you actually have, before anyone talks about models.',
    items: [
      'Foundations sized to your use cases, not to a reference architecture.',
      'Fragmented sources plugged together: CRMs, documents, sheets, logs.',
      'Governance that holds up across jurisdictions, not just at home.',
    ],
  },
  {
    key: 'ai',
    name: 'AI',
    meta: 'The intelligence layer',
    tag: 'min-tag--red',
    intro: 'Use cases that pay back, prototyped on your own data with a cost per run.',
    items: [
      'Every candidate carries its real API cost before it ships anywhere.',
      'Benchmarked across Western and Chinese models, on the same task.',
      'What misses the metric gets stopped, and we put that in writing too.',
    ],
  },
  {
    key: 'tech',
    name: 'Tech',
    meta: 'The product layer',
    tag: 'min-tag--green',
    intro: 'Custom builds that land inside the systems your team already opens every morning.',
    items: [
      'Integrated into existing tools, not another tab nobody opens.',
      'Built by the same people who ran the pilot, so nothing gets lost in handoff.',
      'Documented and handed over, so your team owns what runs.',
    ],
  },
  {
    key: 'consulting',
    name: 'Consulting',
    meta: 'The practice, end to end',
    tag: 'min-tag--yellow',
    intro: 'Strategy, pilots, and adoption, on dated baselines and metrics agreed in writing.',
    items: [
      'A baseline with a date on it before any build starts.',
      'Leadership and team training, so the judgment stays in-house.',
      'The recommendation to stop, when the evidence says stop.',
    ],
  },
];

const east = ['Qwen', 'DeepSeek', 'ERNIE', 'GLM', 'Kimi', 'Doubao'];
const west = ['GPT', 'Claude', 'Gemini', 'Llama', 'Mistral', 'Grok'];
const modules = ['Marketing', 'Sales', 'Project Management', 'Your Function'];
---

<Layout
  locale={locale}
  route={route}
  title="BearingBridge AI: Data, AI, Tech and Consulting"
  description="BearingBridge is an AI consultancy with one operating rule: evidence over hype. We plug intelligence into the data your organization already produces, then build the product around it. Baselines, metrics, and kill criteria agreed in writing."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="bbai-hero">
          <div>
            <span class="min-chip bbai-hero__logo" data-reveal>
              <AgencyLogo slug="bearingbridgeai" name="BearingBridge AI" />
            </span>
            <span class="min-tag min-tag--yellow bbai-hero__eyebrow" data-reveal style="--i: 1">
              AI · Data · Tech · Consulting
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              We put intelligence inside your data, then build the product <em>around it.</em>
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">
              One operating rule: evidence over hype. We plug into the data you already produce and turn it
              into analysis, content, and decisions your teams act on the same day.
            </p>
            <div class="min-ctas bbai-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-link" href="#method">See the method</a>
            </div>
          </div>
          <figure class="min-photo min-photo--wide bbai-hero__shot" data-reveal style="--i: 2">
            <img
              src="/images/bbai-site-shot.webp"
              alt="The BearingBridge AI website homepage"
              width="1440"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- Operator credibility -->
    <section class="min-sec" id="who">
      <div class="min-wrap">
        <div class="bbai-track" data-reveal>
          <span class="bbai-track__num" aria-hidden="true">25<span class="bbai-track__suffix">yrs</span></span>
          <div>
            <h2 class="min-h2">Twenty-five years building digital and commerce across Asia and Europe. Three industry rebrands, same problem underneath.</h2>
            <p class="min-body">
              Cyril Drouin opened one of China's first eCommerce agencies back in 2003, recommendation
              engines and all, then ran Publicis Commerce and Performance Marketing across China and North
              Asia through the attribution years. AI is the third name for the same job: the data has to be
              right before the model gets to be smart. Data first, AI second.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Most AI projects do not fail loudly. <em>They fail politely.</em>
          </h2>
          <p class="min-lead bbai-block__lead">
            RAND counted it in 2024: eighty percent of AI projects get abandoned or never scale. The pilot
            demos well, the steering committee applauds. Then the numbers never move, nobody wrote down what
            success meant, and the budget quietly migrates to next year's pilot. We built the firm to be the
            opposite of that.
          </p>
        </header>

        <div class="min-grid-3">
          {principles.map((p, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{p.title}</h3>
              <p class="min-small">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Method: AZIMUTH -->
    <section class="min-sec min-sec--ruled" id="method">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">AZIMUTH</h2>
          <p class="min-lead bbai-method__lead">
            An azimuth is the angle between north and where you are heading. Navigators take one before they
            move and check it as they go, because feeling on course and being on course are different facts.
            Six legs, a gate between each. You move on when the evidence has earned it.
          </p>
        </header>

        <ol class="bbai-phases" data-reveal>
          {phases.map((ph) => (
            <li class="bbai-phase">
              <span class="bbai-phase__name">{ph.name}</span>
              <span class="min-small">{ph.q}</span>
            </li>
          ))}
        </ol>

        <p class="min-card bbai-method__horizon" data-reveal>
          <span class="min-meta bbai-method__horizon-label">The contract</span>
          Baseline, metric, kill criterion. All three agreed in writing before anyone builds a thing, so
          that six months later nobody has to argue about what success was supposed to mean.
        </p>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Data, AI, tech, consulting. <em>Start where it hurts.</em></h2>
          <p class="min-lead bbai-block__lead">The raw material, the intelligence layer, the product layer, and the practice that ties them together. Take the whole stack or a single piece.</p>
        </header>

        <div class="min-grid-2">
          {services.map((s, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <span class={`min-tag ${s.tag}`}>{s.name}</span>
              <p class="min-meta bbai-service__meta">{s.meta}</p>
              <p class="min-body bbai-service__intro">{s.intro}</p>
              <ul class="bbai-service__list">
                {s.items.map((it) => (
                  <li class="min-small">{it}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- East + West -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split bbai-ew" data-reveal>
          <div>
            <h2 class="min-h2">We benchmark both sides. <em>On your data.</em></h2>
            <p class="min-body bbai-ew__body">
              We have worked on both stacks, so we recommend a model on the merits, not on which side we
              happen to know. Same task, side by side, at actual API cost, and the results pick the winner.
            </p>
            <p class="min-muted bbai-ew__note">
              One provider is a default. Two is a decision you can defend.
            </p>
          </div>
          <div class="bbai-ew__cols">
            <div class="min-card">
              <span class="min-tag min-tag--red">East</span>
              <ul class="bbai-ew__list">
                {east.map((m) => <li>{m}</li>)}
              </ul>
            </div>
            <div class="min-card">
              <span class="min-tag min-tag--blue">West</span>
              <ul class="bbai-ew__list">
                {west.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <div class="bbai-expertise" data-reveal>
          <span class="min-muted bbai-expertise__label">bearingbridge intelligence, our working platform. Modules already running on real tasks, every cost visible on screen.</span>
          <ul class="bbai-expertise__tags">
            {modules.map((m) => <li class="min-pill">{m}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Editorial standard -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <h2 class="min-h2 bbai-operate__title" data-reveal>
          We measure before we recommend.<br />
          We agree the metric before we build.<br />
          When the evidence says stop, we stop.
        </h2>
        <div data-reveal style="--i: 1">
          <p class="min-body bbai-operate__p">Data was called the new oil. Intelligence is the refined product, and AI is the refinery. Our job is to run the refinery honestly, at a cost you can see, against a target you signed before we started.</p>
          <p class="min-kicker bbai-operate__emphasis">Evidence over hype. That is the whole rule.</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 bbai-cta__title">Start with your bearings.<br />A thirty-minute conversation.</h2>
        <div class="min-ctas bbai-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bbai-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .bbai-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .bbai-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .bbai-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .bbai-hero__eyebrow { display: inline-block; }
  .bbai-hero__ctas { margin-top: var(--space-2); }
  .bbai-hero__shot img { object-position: center top; }

  .bbai-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .bbai-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .bbai-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(4.5rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: nowrap;
  }
  .bbai-track__suffix {
    font-size: 0.35em;
    letter-spacing: -0.01em;
    color: var(--muted);
    margin-left: 0.1em;
  }
  .bbai-track .min-body { margin: 0; }

  .bbai-block__lead { margin-bottom: var(--space-5); }

  .bbai-method__lead { margin-bottom: var(--space-5); }
  .bbai-phases {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .bbai-phase {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: clamp(var(--space-3), 3vw, var(--space-6));
    align-items: baseline;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 600px) {
    .bbai-phase { grid-template-columns: 1fr; gap: 2px; }
  }
  .bbai-phase__name { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .bbai-method__horizon { max-width: 70ch; margin: 0; }
  .bbai-method__horizon-label { display: inline-block; margin-right: 10px; }

  .bbai-service__meta { margin: 0 0 var(--space-3); }
  .bbai-service__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .bbai-service__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .bbai-service__list li {
    position: relative;
    padding-left: 16px;
  }
  .bbai-service__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }

  .bbai-ew { align-items: center; margin-bottom: var(--space-6); }
  .bbai-ew__body { margin-bottom: var(--space-3); }
  .bbai-ew__note { font-style: italic; }
  .bbai-ew__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 500px) {
    .bbai-ew__cols { grid-template-columns: 1fr; }
  }
  .bbai-ew__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-weight: 550;
    color: var(--ink);
  }
  .bbai-expertise { border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .bbai-expertise__label { display: block; margin-bottom: var(--space-3); }
  .bbai-expertise__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bbai-operate__title { max-width: none; }
  .bbai-operate__p { margin-bottom: var(--space-3); }
  .bbai-operate__emphasis { margin-top: var(--space-4); }

  .bbai-cta__title { margin-inline: auto; }
  .bbai-cta__actions { justify-content: center; }
</style>
