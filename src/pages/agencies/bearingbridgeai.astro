---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/bearingbridgeai' as const;

const visitUrl = 'https://www.bearingbridge.ai';
const visitLabel = 'Visit bearingbridge.ai';

const principles = [
  {
    title: 'A third of our answers are no',
    body: 'Roughly one in three use cases we assess gets a no, in writing, before anyone signs anything. A no in week one is worth far more than a yes that quietly falls apart in month four.',
  },
  {
    title: 'We sell no one’s software',
    body: 'No reseller agreements, no vendor incentives. Models get benchmarked at their actual API cost, on your task, and the recommendation rides on the numbers rather than on a partnership.',
  },
  {
    title: 'Your team runs it without us',
    body: 'Engagements are designed for independence. Training and handover sit inside the method, not on a separate invoice. When we walk out, the work keeps running and what we learned stays in the building.',
  },
];

const phases = [
  { name: 'Bearing', q: 'Decide where AI is worth pointing, then commit it to paper.' },
  { name: 'Data', q: 'Find it, clean it, move it to where the work happens.' },
  { name: 'Build', q: 'Whatever the use case calls for, built on your data.' },
  { name: 'Run', q: 'A small, timeboxed pilot on real data, with real users.' },
  { name: 'Fix', q: 'Same measurement as the baseline. Same method, new date.' },
  { name: 'Scale', q: 'Positive return proven, the pilot graduates to production.' },
];

type ServiceKey = 'data' | 'ai' | 'tech' | 'consulting';
const services: Array<{
  key: ServiceKey;
  name: string;
  meta: string;
  stamp: string;
  intro: string;
  items: string[];
}> = [
  {
    key: 'data',
    name: 'Data',
    meta: 'The raw material',
    stamp: '数',
    intro: 'An honest audit of what you actually have, before anyone talks about models.',
    items: [
      'Foundations sized to your use cases, not to a reference architecture.',
      'Fragmented sources plugged together: CRMs, documents, sheets, logs.',
      'Governance that holds up across jurisdictions, not just at home.',
    ],
  },
  {
    key: 'ai',
    name: 'AI',
    meta: 'The intelligence layer',
    stamp: '智',
    intro: 'Use cases that pay back, prototyped on your own data with a cost per run.',
    items: [
      'Every candidate carries its real API cost before it ships anywhere.',
      'Benchmarked across Western and Chinese models, on the same task.',
      'What misses the metric gets stopped, and we put that in writing too.',
    ],
  },
  {
    key: 'tech',
    name: 'Tech',
    meta: 'The product layer',
    stamp: '建',
    intro: 'Custom builds that land inside the systems your team already opens every morning.',
    items: [
      'Integrated into existing tools, not another tab nobody opens.',
      'Built by the same people who ran the pilot, so nothing gets lost in handoff.',
      'Documented and handed over, so your team owns what runs.',
    ],
  },
  {
    key: 'consulting',
    name: 'Consulting',
    meta: 'The practice, end to end',
    stamp: '询',
    intro: 'Strategy, pilots, and adoption, on dated baselines and metrics agreed in writing.',
    items: [
      'A baseline with a date on it before any build starts.',
      'Leadership and team training, so the judgment stays in-house.',
      'The recommendation to stop, when the evidence says stop.',
    ],
  },
];

const east = ['Qwen', 'DeepSeek', 'ERNIE', 'GLM', 'Kimi', 'Doubao'];
const west = ['GPT', 'Claude', 'Gemini', 'Llama', 'Mistral', 'Grok'];
const modules = ['Marketing', 'Sales', 'Project Management', 'Your Function'];
---

<Layout
  locale={locale}
  route={route}
  title="BearingBridge AI: Data, AI, Tech and Consulting"
  description="BearingBridge is an AI consultancy with one operating rule: evidence over hype. We plug intelligence into the data your organization already produces, then build the product around it. Baselines, metrics, and kill criteria agreed in writing."
>
  <!-- ====================================================================== -->
  <!-- HERO                                                                   -->
  <!-- ====================================================================== -->
  <section class="bbai-hero" data-hero>
    <div class="bbai-hero__bg" aria-hidden="true"></div>
    <div class="container bbai-hero__main">
      <div class="bbai-hero__content">
        <span class="bbai-hero__logo-chip">
          <AgencyLogo slug="bearingbridgeai" name="BearingBridge AI" class="bbai-hero__logo" />
        </span>

        <span class="bbai-hero__eyebrow" data-anim="fade">
          AI · Data · Tech · Consulting
        </span>

        <h1 class="bbai-hero__title">
          <span class="bbai-hero__line" data-anim="word">We put intelligence</span>
          <span class="bbai-hero__line" data-anim="word">inside your data, then build</span>
          <span class="bbai-hero__line" data-anim="word">the product <em>around it.</em></span>
        </h1>

        <p class="bbai-hero__lead" data-anim="fade">
          An AI consultancy with one operating rule: evidence over hype. We plug into the data your
          organization already produces and turn it into analysis, content, and decisions your teams can
          act on the same day. We measure before we recommend, and when the evidence says stop, we say stop.
        </p>

        <div class="bbai-hero__cta-row" data-anim="fade">
          <a class="pill-cta" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}
            <span class="pill-cta__disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></span>
          </a>
          <a class="bbai-hero__secondary" href="#method">
            <span>See the method</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <div class="bbai-hero__feature" data-tilt>
        <div class="bbai-hero__feature-frame">
          <div class="bbai-browser">
            <img
              src="/images/bbai-site-shot.webp"
              alt="The BearingBridge AI website homepage"
              class="bbai-browser__img"
              width="1440"
              height="900"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- OPERATOR CREDIBILITY                                                    -->
  <!-- ====================================================================== -->
  <section class="bbai-track" id="who">
    <div class="container">
      <div class="bbai-track__grid">
        <div class="bbai-track__numeral" aria-hidden="true">
          <span class="bbai-track__num" data-count="25">0</span>
          <span class="bbai-track__num-suffix">yrs</span>
        </div>
        <div class="bbai-track__copy">
          <h2 class="bbai-track__title balance">Twenty-five years building digital and commerce across Asia and Europe. Three industry rebrands, same problem underneath.</h2>
          <p class="bbai-track__lead">
            Cyril Drouin opened one of China's first eCommerce agencies back in 2003, recommendation
            engines and all, then ran Publicis Commerce and Performance Marketing across China and North
            Asia through the attribution years. AI is the third name for the same job: the data has to be
            right before the model gets to be smart. Data first, AI second.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- PRINCIPLES                                                             -->
  <!-- ====================================================================== -->
  <section class="bbai-principles-sec">
    <div class="container">
      <header class="bbai-block-head">
        <h2 class="bbai-block-title balance">
          Most AI projects do not fail loudly. <em>They fail politely.</em>
        </h2>
        <p class="bbai-block-lead">
          RAND counted it in 2024: eighty percent of AI projects get abandoned or never scale. The pilot
          demos well, the steering committee applauds. Then the numbers never move, nobody wrote down what
          success meant, and the budget quietly migrates to next year's pilot. We built the firm to be the
          opposite of that.
        </p>
      </header>

      <div class="bbai-principles">
        {principles.map((p) => (
          <article class="bbai-principle">
            <span class="bbai-principle__mark" aria-hidden="true"></span>
            <h3 class="bbai-principle__title">{p.title}</h3>
            <p class="bbai-principle__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- METHOD: AZIMUTH (dark)                                                  -->
  <!-- ====================================================================== -->
  <section class="bbai-method" id="method">
    <div class="bbai-method__bg" aria-hidden="true"></div>
    <div class="container bbai-method__inner">
      <header class="bbai-method__head">
        <h2 class="bbai-method__title">AZIMUTH</h2>
        <p class="bbai-method__lead">
          An azimuth is the angle between north and where you are heading. Navigators take one before they
          move and check it as they go, because feeling on course and being on course are different facts.
          Six legs, a gate between each. You move on when the evidence has earned it.
        </p>
      </header>

      <div class="bbai-phases-tray">
        <ol class="bbai-phases">
          {phases.map((ph) => (
            <li class="bbai-phase">
              <span class="bbai-phase__name">{ph.name}</span>
              <span class="bbai-phase__q">{ph.q}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="bbai-method__horizon">
        <span class="bbai-method__horizon-label">The contract</span>
        Baseline, metric, kill criterion. All three agreed in writing before anyone builds a thing, so
        that six months later nobody has to argue about what success was supposed to mean.
      </p>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- SERVICES (tabbed)                                                       -->
  <!-- ====================================================================== -->
  <section class="bbai-services" id="services">
    <div class="container">
      <header class="bbai-block-head">
        <h2 class="bbai-block-title balance">Data, AI, tech, consulting. <em>Start where it hurts.</em></h2>
        <p class="bbai-block-lead">The raw material, the intelligence layer, the product layer, and the practice that ties them together. Take the whole stack or a single piece.</p>
      </header>

      <div class="bbai-tabs-tray">
      <div class="bbai-tabs" data-tabs>
        <div class="bbai-tabs__nav" role="tablist" aria-label="Engagements">
          {services.map((s, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              class={`bbai-tabs__tab ${i === 0 ? 'is-active' : ''}`}
              data-tab={s.key}
              id={`bbai-tab-${s.key}`}
              aria-controls={`bbai-panel-${s.key}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="bbai-tabs__tab-pip" aria-hidden="true"></span>
              <span class="bbai-tabs__tab-label">{s.name}</span>
            </button>
          ))}
          <span class="bbai-tabs__indicator" aria-hidden="true"></span>
        </div>

        <div class="bbai-tabs__panels">
          {services.map((s, i) => (
            <div
              class={`bbai-tabs__panel ${i === 0 ? 'is-active' : ''}`}
              role="tabpanel"
              id={`bbai-panel-${s.key}`}
              aria-labelledby={`bbai-tab-${s.key}`}
              data-panel={s.key}
              hidden={i !== 0}
            >
              <div class="bbai-tabs__grid">
                <div class="bbai-facet">
                  <span class="bbai-facet__stamp" aria-hidden="true">{s.stamp}</span>
                  <svg class="bbai-facet__rose" viewBox="0 0 200 200" fill="none" aria-hidden="true">
                    <circle cx="100" cy="100" r="78" stroke="currentColor" stroke-width="1" opacity="0.35" />
                    <circle cx="100" cy="100" r="52" stroke="currentColor" stroke-width="1" opacity="0.25" />
                    <path d="M100 16 L112 100 L100 184 L88 100 Z" fill="currentColor" opacity="0.9" />
                    <path d="M16 100 L100 88 L184 100 L100 112 Z" fill="currentColor" opacity="0.35" />
                  </svg>
                  <span class="bbai-facet__name">{s.name}</span>
                  <span class="bbai-facet__meta">{s.meta}</span>
                </div>

                <div class="bbai-tabs__content">
                  <p class="bbai-tabs__intro">{s.intro}</p>
                  <ul class="bbai-tabs__list">
                    {s.items.map((it) => (
                      <li class="bbai-tabs__item">
                        <span class="bbai-tabs__item-pip" aria-hidden="true"></span>
                        <span>{it}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- EAST + WEST                                                            -->
  <!-- ====================================================================== -->
  <section class="bbai-ew-sec">
    <div class="container">
      <div class="bbai-ew">
        <div class="bbai-ew__copy">
          <h2 class="bbai-block-title balance">We benchmark both sides. <em>On your data.</em></h2>
          <p class="bbai-block-lead">
            We have worked on both stacks, so we recommend a model on the merits, not on which side we
            happen to know. Same task, side by side, at actual API cost, and the results pick the winner.
          </p>
          <p class="bbai-ew__note">
            One provider is a default. Two is a decision you can defend.
          </p>
        </div>
        <div class="bbai-ew__cols">
          <div class="bbai-ew__col">
            <span class="bbai-ew__label">East</span>
            <ul class="bbai-ew__list">
              {east.map((m) => <li>{m}</li>)}
            </ul>
          </div>
          <div class="bbai-ew__col">
            <span class="bbai-ew__label">West</span>
            <ul class="bbai-ew__list">
              {west.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <div class="bbai-expertise">
        <span class="bbai-expertise__label">bearingbridge intelligence, our working platform: modules already running on real tasks, with every cost visible on screen</span>
        <ul class="bbai-expertise__tags">
          {modules.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- EDITORIAL STANDARD (dark)                                               -->
  <!-- ====================================================================== -->
  <section class="bbai-operate">
    <div class="bbai-operate__bg" aria-hidden="true"></div>
    <div class="container bbai-operate__inner">
      <h2 class="bbai-operate__title">
        <span class="bbai-operate__line" data-line>We measure before we recommend.</span>
        <span class="bbai-operate__line" data-line>We agree the metric before we build.</span>
        <span class="bbai-operate__line" data-line>When the evidence says stop, we stop.</span>
      </h2>
      <div class="bbai-operate__statement" data-line>
        <p>Data was called the new oil. Intelligence is the refined product, and AI is the refinery. Our job is to run the refinery honestly, at a cost you can see, against a target you signed before we started.</p>
        <p class="bbai-operate__emphasis">Evidence over hype. That is the whole rule.</p>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- FINAL CTA                                                              -->
  <!-- ====================================================================== -->
  <section class="bbai-cta">
    <div class="bbai-cta__bg" aria-hidden="true"></div>
    <div class="container bbai-cta__inner">
      <h2 class="bbai-cta__title balance">Start with your bearings.<br />A thirty-minute conversation.</h2>
      <div class="bbai-cta__actions">
        <a class="pill-cta" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}
          <span class="pill-cta__disc" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></span>
        </a>
        <a class="pill-ghost" href={pathFor('contact', locale)}>Book a call</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===================================================================== */
  /* BearingBridge AI palette (matches bearingbridge.ai)                    */
  /* ===================================================================== */
  .bbai-hero,
  .bbai-track,
  .bbai-principles-sec,
  .bbai-method,
  .bbai-services,
  .bbai-ew-sec,
  .bbai-operate,
  .bbai-cta {
    --paper: #fffdf9;
    --cream: #f3e9d8;
    --cream-soft: #f8f1e5;
    --ink: #16181d;
    --accent: #a63d2f;
    --accent-dark: #8c3023;
    --sea: #32536a;
    --green: #16a34a;
    --line: #e6dcc8;
  }

  /* ===================================================================== */
  /* HERO                                                                   */
  /* ===================================================================== */
  .bbai-hero {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding: clamp(2.5rem, 6vh, 4.5rem) 0 clamp(3rem, 7vh, 5.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .bbai-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(900px 560px at 90% 8%, var(--cream-soft), transparent 62%),
      linear-gradient(180deg, var(--paper) 0%, var(--cream-soft) 100%);
  }
  .bbai-hero__bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(22,24,29,0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22,24,29,0.045) 1px, transparent 1px);
    background-size: 92px 92px;
    mask-image: radial-gradient(ellipse 65% 65% at 35% 40%, #000 25%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 65% 65% at 35% 40%, #000 25%, transparent 78%);
  }
  .bbai-hero__main {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .bbai-hero__content { min-width: 0; max-width: 38rem; }
  .bbai-hero__logo-chip {
    display: inline-grid;
    place-items: center;
    padding: 10px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 10px 26px -16px rgba(22,24,29,0.4);
  }
  .bbai-hero__content :global(.bbai-hero__logo) { height: 28px; width: auto; }
  .bbai-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: var(--space-5) 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sea);
  }
  .bbai-hero__title {
    font-size: clamp(2.4rem, 4.4vw + 0.5rem, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 var(--space-5);
    max-width: 16ch;
  }
  .bbai-hero__line { display: block; overflow: hidden; }
  .bbai-hero__line em {
    font-style: normal;
    color: var(--accent);
  }
  .bbai-hero__lead {
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.22rem);
    color: var(--bbg-text);
    max-width: 50ch;
    margin: 0 0 var(--space-6);
  }
  .bbai-hero__cta-row {
    display: inline-flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  /* Pill CTA, page accent (terracotta) over the global blue default */
  .pill-cta {
    background: #a63d2f;
    box-shadow: 0 16px 34px -12px rgba(166,61,47,0.5);
  }
  .pill-cta:hover { background: #8c3023; }
  .bbai-hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .bbai-hero__secondary svg { transition: transform 180ms ease; }
  .bbai-hero__secondary:hover { color: var(--accent); }
  .bbai-hero__secondary:hover svg { transform: translateX(3px); }

  /* Hero feature: browser-framed site screenshot */
  .bbai-hero__feature {
    position: relative;
    perspective: 1500px;
    min-width: 0;
  }
  .bbai-hero__feature-frame {
    position: relative;
    padding: 6px;
    border-radius: 28px;
    background: rgba(60,40,20,.05);
    box-shadow: 0 0 0 1px rgba(60,40,20,.07);
    transform-style: preserve-3d;
    transform: rotateY(var(--tilt-x, -3deg)) rotateX(var(--tilt-y, 2deg));
    transition: transform 600ms cubic-bezier(0.32,0.72,0,1);
  }
  .bbai-browser {
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 24px 50px -36px rgba(10,20,30,.35),
      0 44px 90px -34px rgba(22,24,29,0.35);
  }
  .bbai-browser__img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1023px) {
    .bbai-hero__main { grid-template-columns: 1fr; gap: var(--space-8); }
    .bbai-hero__title { max-width: none; }
  }

  /* ===================================================================== */
  /* OPERATOR CREDIBILITY                                                   */
  /* ===================================================================== */
  .bbai-track {
    padding: clamp(4rem, 9vh, 7rem) 0;
    background: linear-gradient(180deg, var(--cream-soft) 0%, var(--paper) 100%);
  }
  .bbai-track__grid {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 1023px) { .bbai-track__grid { grid-template-columns: 1fr; gap: var(--space-5); } }
  .bbai-track__numeral {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.1em;
    line-height: 0.85;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }
  .bbai-track__num {
    font-size: clamp(6rem, 15vw, 13rem);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .bbai-track__num-suffix {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 600;
    color: var(--accent);
  }
  .bbai-track__copy { max-width: 56ch; }
  .bbai-track__title {
    font-size: clamp(1.6rem, 2.4vw + 0.6rem, 2.4rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--ink);
    margin: var(--space-3) 0 var(--space-4);
  }
  .bbai-track__lead { font-size: var(--fs-lead); color: var(--bbg-text); }

  /* ===================================================================== */
  /* SHARED BLOCK HEADINGS                                                  */
  /* ===================================================================== */
  .bbai-block-head { max-width: 60ch; margin: 0 0 var(--space-7); }
  .bbai-block-title {
    font-size: clamp(1.7rem, 2.6vw + 0.5rem, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--ink);
    margin: var(--space-3) 0 var(--space-4);
  }
  .bbai-block-title em { font-style: normal; color: var(--accent); }
  .bbai-block-lead { color: var(--bbg-text); font-size: var(--fs-lead); max-width: 58ch; }

  /* ===================================================================== */
