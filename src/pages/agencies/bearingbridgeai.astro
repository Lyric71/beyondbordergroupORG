---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/bearingbridgeai' as const;

const site = 'https://www.bearingbridge.com';
const visitLabel = 'Visit bearingbridge.com';

const reasons = [
  {
    title: 'Practice, not theory',
    body: 'Nobody adopts anything off a deck. Adoption happens when someone runs the thing on their own data and sees what comes back. That is the consulting model the founders walked away from, and it shaped the product.',
  },
  {
    title: 'Capability without the payroll',
    body: 'A twelve-person firm can run an analyst, a content team and a support desk without posting a single job. The work gets done at the size the company already is.',
  },
  {
    title: 'Intelligence first, software second',
    body: 'Most vendors bolt AI onto software they already sold you. Here the intelligence is the product, and it gets judged on what the output is worth against what the run cost.',
  },
];

const assistance = [
  {
    name: 'Ask Intelligence',
    path: '/ask-intelligence',
    body: 'Ask a business question in plain words. It answers from your own data, quotes the real figure with its source, or tells you the data is not there.',
    tag: 'min-tag--blue',
  },
  {
    name: 'Playground',
    path: '/playground',
    body: 'Chat with the models your administrator allows, three side by side, with the price sitting under every answer.',
    tag: 'min-tag--green',
  },
  {
    name: 'Agents',
    path: '/agents',
    body: 'Watchers notice, drafters produce, and nothing ships until a person signs. Every agent carries a job, a schedule, a budget and a scope of data it may read.',
    tag: 'min-tag--yellow',
  },
  {
    name: 'Skills',
    path: '/skills',
    body: 'How a brief gets built, how a campaign is structured, what a decent article actually looks like. The craft of the people who built the product, shipped as the default. You adjust it.',
    tag: 'min-tag--red',
  },
];

const modules = [
  {
    name: 'Business Intelligence',
    group: 'Leadership',
    path: '/business-intelligence',
    body: 'Ask the business a question and get the real number with its source attached. Plus a Monday briefing on what moved, and why it moved.',
  },
  {
    name: 'Sales',
    group: 'Revenue',
    path: '/sales',
    body: 'A pipeline that drafts its own quotes, pins the next step on every deal, and flags the ones that have gone quiet.',
  },
  {
    name: 'Brand Marketing',
    group: 'Growth',
    path: '/marketing',
    body: 'Thirty-seven text formats, an article workspace that runs from brief to branded PDF, and a Creative Studio where images and video are priced before you press run.',
  },
  {
    name: 'Search',
    group: 'Growth',
    path: '/search',
    body: 'Your rank by keyword, market and language, the terms competitors own and you do not, and what ChatGPT, Claude, Gemini and Perplexity say when somebody asks about you.',
  },
  {
    name: 'Social',
    group: 'Growth',
    path: '/social',
    body: 'A calendar you sign off on, and drafts for LinkedIn, X, Instagram and TikTok checked against the real limits of each network before you ever read them.',
  },
  {
    name: 'Ads',
    group: 'Growth',
    path: '/ads',
    body: 'Six steps from a keyword idea to a whole Google Ads campaign. One push builds it in your account, paused, with a watcher left running on it.',
  },
  {
    name: 'Project Management',
    group: 'Operations',
    path: '/project-management',
    body: 'The board where findings turn into work, so an insight does not quietly die inside a report nobody opens.',
  },
  {
    name: 'Assets Library',
    group: 'Operations',
    path: '/assets-library',
    body: 'Every text, image and video the product makes lands here with its prompt and its price. Name a folder in a brief and the AI writes from it.',
  },
  {
    name: 'Validation',
    group: 'Operations',
    path: '/validation',
    body: 'Send an asset to a colleague for a decision. A card lands on their board, mail goes both ways, and no version is ever deleted.',
  },
  {
    name: 'Customer Service',
    group: 'Support',
    path: '/customer-service',
    body: 'A public assistant on your own page. It answers only from what you gave it, says so plainly when it does not know, and runs under a daily budget.',
  },
];

const pricing = [
  {
    title: 'Seats are free',
    body: 'Give an account to everyone who needs one. The number on the invoice does not move when you do. Roles are still enforced.',
  },
  {
    title: 'The price comes first',
    body: 'Every run is quoted against your wallet before or as it runs, and itemised in the ledger afterwards. The machine’s own retries are not billed to you.',
  },
  {
    title: 'Caps and gates',
    body: 'A hard cap per module, an approval gate in front of anything that publishes or spends, and a zero balance that simply stops the AI.',
  },
];

const guarantees = [
  'Companies, brands and users are kept apart in code, not by convention.',
  'Every model call goes through one gateway. The key never reaches a browser.',
  'Your prompts are never used to train anything.',
  'Every run lands in the ledger: who, what, when, which model, what it cost.',
];

const services = [
  'Onboarding',
  'Data integration',
  'Intelligence audit',
  'Training',
  'Managed operations',
  'Custom features',
  'Dedicated hosting',
  'Premium support',
];

const phases = [
  { name: 'Bearing', q: 'Decide where AI is worth pointing, then commit it to paper.' },
  { name: 'Data', q: 'Find it, clean it, move it to where the work happens.' },
  { name: 'Build', q: 'Whatever the use case calls for, built on your data.' },
  { name: 'Run', q: 'A small, timeboxed pilot on real data, with real users.' },
  { name: 'Fix', q: 'Same measurement as the baseline. Same method, new date.' },
  { name: 'Scale', q: 'Positive return proven, the pilot graduates to production.' },
];
---

<Layout
  locale={locale}
  route={route}
  title="BearingBridge AI: the AI business platform"
  description="BearingBridge AI is an AI business platform. Marketing, sales, business intelligence, project management, customer service and IT support delivered as software, with agents that already know the trade. Seats are free, you pay for what the AI runs, and nothing ships until someone signs."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="bbai-hero">
          <div>
            <span class="min-chip bbai-hero__logo" data-reveal>
              <AgencyLogo slug="bearingbridgeai" name="BearingBridge AI" />
            </span>
            <span class="min-tag min-tag--blue bbai-hero__eyebrow" data-reveal style="--i: 1">
              The AI business platform
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              Every team you cannot afford to hire, <em>running inside one app.</em>
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">
              Marketing, sales, business intelligence, project management, customer service and IT support,
              delivered as software. The agents already know the trade, and they are live the day you open
              the account. No recruiters, no agency retainers, nobody new on payroll.
            </p>
            <div class="min-ctas bbai-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={site} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-link" href="#roster">See what it runs</a>
            </div>
            <p class="min-small bbai-hero__note" data-reveal style="--i: 5">
              Free to open, free to keep. You put money in a wallet and spend it on what you consume:
              tokens, storage, data. The balance never expires, and no card is needed to open an account.
            </p>
          </div>
          <figure class="min-photo min-photo--wide bbai-hero__shot" data-reveal style="--i: 2">
            <img
              src="/images/bbai-site-shot.webp"
              alt="The BearingBridge AI homepage at bearingbridge.com"
              width="1440"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- The argument -->
    <section class="min-sec" id="why">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Size was never the same thing as ability.</h2>
          <p class="min-lead bbai-block__lead">
            What a company could reach for was always capped by who it could afford to put on payroll. The
            competitor down the road was rarely smarter. Just staffed. That cap is the thing that moved, and
            BearingBridge was built on the assumption that it moved for good.
          </p>
        </header>

        <div class="min-grid-3">
          {reasons.map((r, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{r.title}</h3>
              <p class="min-small">{r.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- AI assistance -->
    <section class="min-sec min-sec--ruled" id="assistance">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Four ways to put it to work. <em>Every account gets all four.</em></h2>
          <p class="min-lead bbai-block__lead">
            Two you talk to directly, and two that decide how everything else behaves.
          </p>
        </header>

        <div class="min-grid-2">
          {assistance.map((a, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <span class={`min-tag ${a.tag}`}>{a.name}</span>
              <p class="min-small bbai-assist__body">{a.body}</p>
              <a class="min-link" href={`${site}${a.path}`} target="_blank" rel="noreferrer">
                Open {a.name} ↗
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- The roster -->
    <section class="min-sec min-sec--ruled" id="roster">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Ten roles. One workspace. <em>Nobody new on payroll.</em></h2>
          <p class="min-lead bbai-block__lead">
            The same intelligence, the same agents and the same skills, pointed at the jobs a company has to
            get done anyway. Start with the one keeping you up. A module you have not switched on costs
            nothing.
          </p>
        </header>

        <div class="min-index" data-reveal>
          {modules.map((m) => (
            <a class="min-index__row" href={`${site}${m.path}`} target="_blank" rel="noreferrer">
              <div>
                <h3 class="min-index__title">{m.name}</h3>
                <span class="min-meta">{m.group}</span>
              </div>
              <p class="min-index__body">{m.body}</p>
              <span class="min-index__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="min-sec min-sec--ruled" id="pricing">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Seats are free. <em>You pay for what the AI runs.</em></h2>
          <p class="min-lead bbai-block__lead">
            No tiers to decode, no per-seat arithmetic, no annual lock-in. Money sits in a wallet and gets
            spent on tokens, storage and data, and you see the price before anything spends it.
          </p>
        </header>

        <div class="min-grid-3">
          {pricing.map((p, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{p.title}</h3>
              <p class="min-small">{p.body}</p>
            </article>
          ))}
        </div>

        <p class="min-kicker bbai-pricing__kicker" data-reveal>
          Nothing ships until a person signs. That sentence is the product.
        </p>
      </div>
    </section>

    <!-- Security -->
    <section class="min-sec min-sec--ruled" id="security">
      <div class="min-wrap">
        <div class="min-split bbai-sec" data-reveal>
          <div>
            <h2 class="min-h2">Where your data goes, and where it does not.</h2>
            <p class="min-body bbai-sec__body">
              For most companies the standard product ends the conversation. If it does not end yours,
              dedicated hosting puts the whole thing on a single tenant in the region you name, with backups
              that stay there and an uptime number written into the contract. Same product, your own
              instance, provisioned in about two weeks.
            </p>
            <a class="min-link" href={`${site}/security`} target="_blank" rel="noreferrer">
              Read security and data ↗
            </a>
          </div>
          <ul class="bbai-sec__list">
            {guarantees.map((g) => (
              <li class="min-small">{g}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <div class="min-split min-split--reverse bbai-services" data-reveal>
          <div>
            <h2 class="min-h2">The people around the product.</h2>
            <p class="min-body bbai-sec__body">
              Software on its own connects to nothing. A guided session gets your brands, markets and budget
              caps configured, the systems you already run get plugged in and reconciled, and the team is
              trained by role rather than by feature. After that you can keep a named operator on the
              account, or run it yourself. Most do the second one.
            </p>
            <a class="min-link" href={`${site}/services`} target="_blank" rel="noreferrer">
              See all services ↗
            </a>
          </div>
          <ul class="bbai-services__tags">
            {services.map((s) => (
              <li class="min-pill">{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Method: AZIMUTH -->
    <section class="min-sec min-sec--ruled" id="method">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">AZIMUTH</h2>
          <p class="min-lead bbai-method__lead">
            An azimuth is the angle between north and where you are heading. Navigators take one before they
            move and check it as they go, because feeling on course and being on course are different facts.
            Six legs, a gate between each. You move on when the evidence has earned it.
          </p>
        </header>

        <ol class="bbai-phases" data-reveal>
          {phases.map((ph) => (
            <li class="bbai-phase">
              <span class="bbai-phase__name">{ph.name}</span>
              <span class="min-small">{ph.q}</span>
            </li>
          ))}
        </ol>

        <p class="min-card bbai-method__horizon" data-reveal>
          <span class="min-meta bbai-method__horizon-label">The contract</span>
          Baseline, metric, kill criterion. All three agreed in writing before anyone builds a thing, so
          that six months later nobody has to argue about what success was supposed to mean.
        </p>
      </div>
    </section>

    <!-- Voice of the customer -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <blockquote class="min-serif-quote" data-reveal cite={`${site}/testimonials`}>
          We had an agency for search, another for content and a freelancer for the ads. Now Search tells us
          what dog owners are actually asking, the content comes out in our voice, and the campaigns arrive
          built and priced. Two of us run it from one screen. We let the agency go in the spring and only
          finance noticed.
        </blockquote>
        <p class="min-meta bbai-quote__by" data-reveal style="--i: 1">
          Ashley R., founder, dog food and toys brand.
          <a class="min-link" href={`${site}/testimonials`} target="_blank" rel="noreferrer">All testimonials ↗</a>
        </p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 bbai-cta__title">Live in a week.<br />Tell them which job is costing you the most.</h2>
        <p class="min-body bbai-cta__body">
          Ninety minutes gets your brands, markets and budget caps configured. Five days later you are
          running it yourself. Bring your brand materials and your market scope. Leave the prompt library at
          home, the agents come configured for their trade.
        </p>
        <div class="min-ctas bbai-cta__actions">
          <a class="min-btn" href={site} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bbai-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .bbai-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .bbai-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .bbai-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .bbai-hero__eyebrow { display: inline-block; }
  .bbai-hero__ctas { margin-top: var(--space-2); }
  .bbai-hero__note {
    margin-top: var(--space-4);
    padding-left: var(--space-3);
    border-left: 2px solid var(--line);
    max-width: 58ch;
  }
  .bbai-hero__shot img { object-position: center top; }

  .bbai-block__lead { margin-bottom: var(--space-5); }

  .bbai-assist__body { margin-bottom: var(--space-4); }

  .min-index__row .min-meta { display: block; margin-top: 4px; }
  @media (max-width: 720px) {
    .min-index__row { grid-template-columns: 1fr auto; gap: var(--space-2); }
    .min-index__row .min-index__body { grid-column: 1 / -1; }
  }

  .bbai-pricing__kicker { margin-top: var(--space-6); }

  .bbai-sec { align-items: start; }
  .bbai-sec__body { margin-bottom: var(--space-3); }
  .bbai-sec__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }
  .bbai-sec__list li {
    position: relative;
    padding-left: 18px;
  }
  .bbai-sec__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }

  .bbai-services { align-items: center; }
  .bbai-services__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bbai-method__lead { margin-bottom: var(--space-5); }
  .bbai-phases {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .bbai-phase {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: clamp(var(--space-3), 3vw, var(--space-6));
    align-items: baseline;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 600px) {
    .bbai-phase { grid-template-columns: 1fr; gap: 2px; }
  }
  .bbai-phase__name { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .bbai-method__horizon { max-width: 70ch; margin: 0; }
  .bbai-method__horizon-label { display: inline-block; margin-right: 10px; }

  .bbai-quote__by { margin-top: var(--space-4); }
  .bbai-quote__by .min-link { margin-left: 10px; }

  .bbai-cta__title { margin-inline: auto; }
  .bbai-cta__body { margin-inline: auto; max-width: 56ch; }
  .bbai-cta__actions { justify-content: center; }
</style>
