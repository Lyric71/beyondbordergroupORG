---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';

const locale = 'en' as const;
const route = 'agencies/chinawebfoundry' as const;

type PhaseKey = 'plan' | 'build' | 'find' | 'run';

const phases: Array<{
  key: PhaseKey;
  title: string;
  tag: string;
  intro: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'plan',
    title: 'Plan',
    tag: 'min-tag--blue',
    intro: 'Where your site stands today inside China, and what to do about it.',
    items: [
      {
        name: 'Strategy & Audit',
        body: 'We test your current site from real browsers in Beijing, Shanghai and Shenzhen. Every blocked resource, every compliance gap, every Baidu blind spot, documented. You walk away with a roadmap. Two to four weeks, fixed price.',
      },
      {
        name: 'Migration',
        body: "Moving an existing site into China without losing SEO equity or content. ICP Bei'an, DNS cutover, database transfer, parallel staging environment that lets you test from inside the Firewall before you flip the switch.",
      },
    ],
  },
  {
    key: 'build',
    title: 'Build',
    tag: 'min-tag--red',
    intro: 'Design, code and plumbing made for the Chinese internet, not retrofitted to it.',
    items: [
      {
        name: 'UX/UI Design',
        body: 'Design that feels right to a Chinese visitor. Mobile-first. Dense layouts. Chinese typography that reads cleanly across UC Browser and QQ Browser. Payment flows that assume WeChat (微信) and Alipay (支付宝) before they assume Visa.',
      },
      {
        name: 'Technical Integration',
        body: "The plumbing. WeChat login, Alipay and UnionPay (银联) checkout, WooCommerce localized for the mainland, map providers and analytics that aren't Google. If it's blocked, we have a replacement.",
      },
      {
        name: 'Plugins & Extensions',
        body: 'In our own audits, a large share of the most popular WordPress plugins call blocked services somewhere in their chain. Fonts, reCAPTCHA, Maps. We patch what can be saved. We rewrite the rest.',
      },
    ],
  },
  {
    key: 'find',
    title: 'Find',
    tag: 'min-tag--yellow',
    intro: 'Get read on Baidu, get quoted by DeepSeek, get found by people who already live here.',
    items: [
      {
        name: 'Chinese Content',
        body: 'Written for the Chinese reader, not translated at them. Product copy, landing pages, blog articles, zhongcao (种草) campaigns. Written by people who live here.',
      },
      {
        name: 'Baidu SEO',
        body: 'Submission and verification on Baidu Search Resource Platform (百度搜索资源平台). Keyword research with Baidu Index (百度指数) and 5118. Measurement through Baidu Tongji (百度统计). Baidu still carries most of the search traffic that matters in China, and Google barely registers.',
      },
      {
        name: 'GEO China',
        body: 'Generative engine optimization for the Chinese AI stack. DeepSeek, Doubao (豆包), Kimi, Yuanbao (元宝), Baidu AI. We optimize for being quoted, not just ranked. New service, growing fast.',
      },
    ],
  },
  {
    key: 'run',
    title: 'Run',
    tag: 'min-tag--green',
    intro: 'A site is not done at launch. It is done the day someone in Shanghai stops opening it.',
    items: [
      {
        name: 'China Hosting',
        body: "Wrong hosting kills everything else. We deploy on Alibaba Cloud (阿里云), Tencent Cloud (腾讯云) and Huawei Cloud (华为云). Hong Kong bridge hosting available while Bei'an paperwork is processing.",
      },
      {
        name: 'Maintenance & Support',
        body: "A Google Font gets blocked on a random Tuesday and your homepage turns into a mess for everyone in Shanghai. Your team in London doesn't know until someone complains. We monitor from Chinese networks so that conversation never has to happen.",
      },
    ],
  },
];

const engageOptions: Array<{ key: 'project' | 'retainer' | 'audit'; label: string; lead: string; meta: string; tag: string; tagClass: string }> = [
  {
    key: 'project',
    label: 'Project',
    lead: 'Defined scope, fixed timeline.',
    meta: 'Six weeks to four months.',
    tag: 'One build',
    tagClass: 'min-tag--plain',
  },
  {
    key: 'retainer',
    label: 'Retainer',
    lead: 'Ongoing content, SEO, GEO and maintenance.',
    meta: 'Monthly, twelve months or longer. How most of our clients work with us.',
    tag: 'Most common',
    tagClass: 'min-tag--red',
  },
  {
    key: 'audit',
    label: 'Audit',
    lead: 'One-off deep look. Performance, compliance, Baidu and AI search visibility.',
    meta: 'Two to four weeks, fixed price.',
    tag: 'Start here',
    tagClass: 'min-tag--green',
  },
];

const visitUrl = 'https://chinawebfoundry.com';
const visitLabel = 'Visit chinawebfoundry.com';
---

<Layout
  locale={locale}
  route={route}
  title="Websites in China | WordPress, Astro, Hosted Inside"
  description="Shanghai web agency. We design, build, host and run websites in China on WordPress or Astro. ICP licensed, Baidu ready, fast behind the Firewall."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="cwf-hero">
          <div>
            <span class="min-chip cwf-hero__logo" data-reveal>
              <AgencyLogo slug="chinawebfoundry" name="ChinaWebFoundry" />
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 1">
              We build websites that <em>work in China</em>.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 2">
              Not from a slide deck in Paris. Not from a sales pitch in New York.
              From an office in Shanghai, with a team that's been building for the
              Chinese internet for over twenty years now.
            </p>
            <div class="min-ctas cwf-hero__ctas" data-reveal style="--i: 3">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide cwf-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/chinawebfoundry-home.webp" alt="chinawebfoundry.com homepage" width="1422" height="14825" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- Manifesto -->
    <section class="min-sec" id="manifesto">
      <div class="min-wrap">
        <div class="cwf-manifesto" data-reveal>
          <div class="cwf-manifesto__numeral">
            <span class="cwf-manifesto__num" aria-hidden="true">80+</span>
            <span class="min-meta">sites delivered for international and Chinese brands</span>
          </div>
          <h2 class="min-h2 cwf-manifesto__title">The gap between green dashboards in Frankfurt and a homepage that takes seventeen seconds to load in Shanghai. That gap is why we exist.</h2>
        </div>

        <figure class="cwf-story" data-reveal style="--i: 1">
          <blockquote class="min-serif-quote" cite="https://www.chinawebfoundry.com">
            <p>A French luxury group called us last spring. Their global homepage was taking seventeen seconds to load from Shanghai. Their marketing director in Paris had no idea, her dashboard showed green across the board because it was measuring from Frankfurt.</p>
          </blockquote>
          <figcaption class="min-meta cwf-story__cite">A client conversation, Shanghai, 2025</figcaption>

          <div class="cwf-story__body">
            <div>
              <p class="min-body">
                That gap, between what looks fine from outside China and what actually happens inside it, is why we exist.
              </p>
            </div>
            <div>
              <p class="min-body">
                Most websites built for China aren't really built for China. Designed somewhere else, translated, hosted in Singapore, plugins calling out to blocked services nobody flagged. Six months in, technically live and functionally invisible.
              </p>
              <p class="min-kicker cwf-story__emphasis">
                China isn't a patch we apply on top of a global build. China <em>is</em> the build. Someone has to watch the site from inside the country. That's us.
              </p>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Ten services. Four phases.<br />
            One team.
          </h2>
          <p class="min-lead cwf-services__lead">
            Plan first. Then build. Then get found. Then run the thing for as long as it's live. You can take one piece, you can take all ten, most clients start with two or three.
          </p>
        </header>

        <div class="min-grid-2">
          {phases.map((p, i) => (
            <div class="min-card" data-reveal style={`--i: ${i}`}>
              <span class={`min-tag ${p.tag}`}>{p.title}</span>
              <p class="min-meta cwf-phase__count">{p.items.length} services</p>
              <p class="min-body cwf-phase__intro">{p.intro}</p>
              <ul class="cwf-phase__list">
                {p.items.map((it) => (
                  <li class="min-small">
                    <strong>{it.name}.</strong> {it.body}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Technology -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>
          WordPress, Astro or WeChat. Here's how we decide.
        </h2>

        <div class="min-grid-3">
          <article class="min-card cwf-tech" data-reveal>
            <figure class="cwf-tech__banner">
              <img src="/AgencyLogos/tech/wordpress.svg" alt="WordPress logo" loading="lazy" decoding="async" />
            </figure>
            <h3 class="min-h3">Pick WordPress</h3>
            <p class="min-small">
              If your marketing team needs to publish without a developer, or your editorial workflow involves more than three contributors. We harden it for the Firewall and strip out the parts that don't belong in China.
            </p>
            <ul class="cwf-tech__traits">
              <li>Editorial workflow, multi-author.</li>
              <li>Hardened core, China-safe plugins.</li>
              <li>WooCommerce localized for the mainland.</li>
            </ul>
          </article>

          <article class="min-card cwf-tech" data-reveal style="--i: 1">
            <figure class="cwf-tech__banner">
              <img src="/AgencyLogos/tech/astro.svg" alt="Astro logo" loading="lazy" decoding="async" />
            </figure>
            <h3 class="min-h3">Pick Astro</h3>
            <p class="min-small">
              If speed is the priority and your content doesn't change every day. Marketing sites, documentation, landing pages. Static output, near-instant load times, far less to maintain.
            </p>
            <ul class="cwf-tech__traits">
              <li>Static output, near-instant TTFB.</li>
              <li>Documentation, landing, marketing.</li>
              <li>Hosted on Aliyun or Tencent Cloud.</li>
            </ul>
          </article>

          <article class="min-card cwf-tech" data-reveal style="--i: 2">
            <figure class="cwf-tech__banner">
              <img src="/AgencyLogos/tech/wechat.svg" alt="WeChat logo" loading="lazy" decoding="async" />
            </figure>
            <h3 class="min-h3">Pick WeChat</h3>
            <p class="min-small">
              If your audience already lives inside WeChat (微信) and a website on the open web is not where the conversation happens. Official accounts, mini-programs, H5 pages, content built where Chinese users already are.
            </p>
            <ul class="cwf-tech__traits">
              <li>Official Account, content and CRM.</li>
              <li>Mini-program for commerce or service.</li>
              <li>H5 pages for campaigns and KOLs.</li>
            </ul>
          </article>
        </div>

        <p class="min-muted min-center cwf-tech__footnote" data-reveal>If you're not sure, that's what the audit is for.</p>
      </div>
    </section>

    <!-- Engage -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">Three ways to start.</h2>
          <p class="min-lead cwf-engage__lead">
            You can take one piece, you can take all ten. Most clients start with two or three. Pick the entry point that fits your moment.
          </p>
        </header>

        <div class="min-grid-3">
          {engageOptions.map((o, i) => (
            <article class="min-card" data-reveal style={`--i: ${i}`}>
              <span class={`min-tag ${o.tagClass}`}>{o.tag}</span>
              <h3 class="min-h3">{o.label}</h3>
              <p class="min-small cwf-engage__cardlead">{o.lead}</p>
              <p class="min-muted">{o.meta}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 cwf-cta__title">A site that loads in Shanghai.<br />Built by a team that lives there.</h2>
        <div class="min-ctas cwf-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .cwf-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .cwf-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .cwf-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .cwf-hero__logo :global(.agency-logo) { height: 30px; width: auto; }
  .cwf-hero__ctas { margin-top: var(--space-2); }
  .cwf-hero__shot { display: block; }
  .cwf-hero__shot img { aspect-ratio: 16 / 10; object-position: center top; height: auto; }

  .cwf-manifesto {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
    margin-bottom: var(--space-6);
  }
  @media (max-width: 800px) {
    .cwf-manifesto { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .cwf-manifesto__numeral { display: flex; flex-direction: column; gap: var(--space-2); max-width: 220px; }
  .cwf-manifesto__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(4.5rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .cwf-manifesto__title { margin: 0; max-width: 34ch; }

  .cwf-story { margin: 0; border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .cwf-story blockquote { margin: 0 0 var(--space-3); }
  .cwf-story blockquote p { margin: 0; }
  .cwf-story__cite { margin: 0 0 var(--space-5); }
  .cwf-story__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-5), 4vw, var(--space-7));
  }
  @media (max-width: 800px) {
    .cwf-story__body { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .cwf-story__body .min-body { margin-bottom: var(--space-4); }
  .cwf-story__emphasis { margin-top: 0; }

  .cwf-services__lead { margin-bottom: var(--space-5); }
  .cwf-phase__count { margin: 0 0 var(--space-3); }
  .cwf-phase__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .cwf-phase__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .cwf-phase__list strong { color: var(--ink); font-weight: 600; }

  .cwf-tech { display: flex; flex-direction: column; gap: var(--space-3); }
  .cwf-tech__banner {
    margin: 0;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-radius: 8px;
    padding: var(--space-4);
  }
  .cwf-tech__banner img { width: auto; height: 100%; max-width: 60%; max-height: 100%; object-fit: contain; }
  .cwf-tech .min-h3 { margin: 0; }
  .cwf-tech__traits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .cwf-tech__traits li {
    position: relative;
    padding-left: 16px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
  }
  .cwf-tech__traits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .cwf-tech__footnote { margin-top: var(--space-6); }

  .cwf-engage__lead { margin-bottom: var(--space-5); }
  .cwf-engage__cardlead { margin-bottom: var(--space-3); }

  .cwf-cta__title { margin-inline: auto; }
  .cwf-cta__actions { justify-content: center; }
</style>
