---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/theredscroll' as const;

const services = [
  {
    key: 'plan',
    title: 'Plan',
    items: [
      { name: 'Strategy, Campaigns and Analytics', body: 'Market and competitor research, platform selection, content calendar, KPIs tied to business goals, dashboards, and social listening.' },
      { name: 'China Market Entry', body: 'Account setup, verification, e-commerce integration with Tmall, JD and Douyin Shop, Chinese naming and platform-ready asset packs.' },
    ],
  },
  {
    key: 'run',
    title: 'Run',
    items: [
      { name: 'Platform Coverage', body: 'WeChat, Douyin, RedNote and Weibo at the core. Bilibili, Kuaishou, Zhihu, Toutiao and others as transparent add-ons.' },
      { name: 'Content Production', body: 'Human-led strategy. AIGC images and video via HubStudio.ai. Real shoots in China. Native Chinese copy review.' },
      { name: 'Advertising Planning and Buying', body: 'Paid media across WeChat, Douyin, RedNote, Weibo and Baidu. Weekly and monthly reports on CPM, CPC, CPA and ROAS. No markups on ad spend.' },
      { name: 'Influencer Marketing', body: 'Verified engagement data, fake follower detection, niche matching. Briefs, co-creation, posting, live commerce and ROI reports.' },
    ],
  },
  {
    key: 'sustain',
    title: 'Sustain',
    items: [
      { name: 'CRM and Private Domain', body: 'WeCom setup, WeChat CRM, community management, customer service flows and loyalty programs.' },
      { name: 'Training and Consulting', body: 'Masterclasses on WeChat, Douyin, RedNote and Weibo. Workshops on content, influencers and paid media. Strategic consulting.' },
    ],
  },
];

const visitUrl = 'https://theredscroll.com';
const visitLabel = 'Visit theredscroll.com';
---

<Layout
  locale={locale}
  route={route}
  title="China Social Media Agency. Fixed Scope. Fixed Price."
  description="We grow social networks in China for international brands. Fixed scope. Fixed price. Team on the ground in Shanghai and Hong Kong. Book a call."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="trs-hero">
          <div>
            <span class="min-chip trs-hero__logo" data-reveal>
              <AgencyLogo slug="theredscroll" name="TheRedScroll" />
            </span>
            <span class="min-tag min-tag--red trs-hero__eyebrow" data-reveal style="--i: 1">China social media, fixed scope, fixed price</span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              We post on <em>China's platforms</em>. Every day. From the ground.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">China runs on its own platforms. WeChat, Douyin, RedNote, Weibo, and fourteen others. Knowing this from a slide deck is not the same as knowing it from the feed.</p>
            <div class="min-ctas trs-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide trs-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/theredscroll-home.webp" alt="theredscroll.com homepage" width="1408" height="832" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- How we work -->
    <section class="min-sec">
      <div class="min-wrap min-narrow" data-reveal>
        <p class="min-kicker trs-active">Active on WeChat, Douyin, RedNote, Weibo and fourteen more.</p>
        <p class="min-body">Every post, video, campaign and report is defined upfront in a written scope of work. One number per package. No hidden fees, no scope creep. Our team works from Shanghai and Hong Kong, with native speakers, real platform access, and direct lines to Chinese influencers. We built HubStudio.ai to produce visuals, video and copy at a fraction of the old cost. Strategy stays human.</p>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>Plan it. Run it. Sustain it.</h2>
        <div class="min-grid-3">
          {services.map((s, i) => (
            <div class="min-card" data-reveal style={`--i: ${i}`}>
              <h3 class="min-h3">{s.title}</h3>
              <ul class="trs-card__list">
                {s.items.map((it) => (
                  <li class="min-small">
                    <strong>{it.name}.</strong> {it.body}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tiers -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow" data-reveal>
        <p class="min-lead">Three tiers, all priced upfront. Discovery is for brands testing China, three months on one platform. Growth is for brands scaling in China, six months across two or three platforms. Premium is for brands going all-in, twelve months across four or more platforms. Every tier ships with a written scope of work and a fixed price.</p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 trs-cta__title">Show up every day. Watch the pipeline follow.</h2>
        <div class="min-ctas trs-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .trs-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .trs-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .trs-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .trs-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .trs-hero__eyebrow { display: inline-block; }
  .trs-hero__ctas { margin-top: var(--space-2); }
  .trs-hero__shot { display: block; }
  .trs-hero__shot img { aspect-ratio: 16 / 10; object-position: center top; }

  .trs-active { margin: 0 0 var(--space-4); }

  .trs-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .trs-card__list strong { color: var(--ink); font-weight: 600; }

  .trs-cta__title { margin-inline: auto; }
  .trs-cta__actions { justify-content: center; }
</style>
