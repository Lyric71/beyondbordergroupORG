---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const title = 'Eight agencies';
const description =
  'BearingBridge is eight specialist agencies. West-to-China, China-to-West, and horizontal. Each one stands alone. Most clients start with one and add others as projects grow.';

type Group = 'West to China' | 'China to West' | 'Horizontal';

type AgencyRoute =
  | 'agencies/bearingbridge'
  | 'agencies/theredscroll'
  | 'agencies/chinawebfoundry'
  | 'agencies/compass'
  | 'agencies/beyondbridge'
  | 'agencies/hubstudio'
  | 'agencies/nuvora-studio'
  | 'agencies/bearingbridgeai';

interface Agency {
  slug: string;
  route: AgencyRoute;
  name: string;
  group: Group;
  category: string;
  tagline: string;
  lead: string;
  lanes: { name: string; body: string }[];
  signal?: string;
  visit: { url: string; label: string };
  based: string;
}

const agencies: Agency[] = [
  {
    slug: 'bearingbridge',
    route: 'agencies/bearingbridge',
    name: 'TheChinaPath',
    group: 'West to China',
    category: 'Full-service China agency',
    tagline: 'Enter China. Grow in China. Learn China.',
    lead:
      "Fifteen years inside China's commerce ecosystem. Tmall launches, Douyin storms, ICP rewrites, every algorithm shift in between. We consult, and we run what we recommend.",
    lanes: [
      {
        name: 'Enter',
        body: 'Market entry consulting, branding and localisation, cross-border eCommerce setup on Tmall Global, JD Worldwide and Douyin, and offline distribution.',
      },
      {
        name: 'Grow',
        body: 'Daily store operations, social commerce on Xiaohongshu, Douyin and WeChat, paid media, Chinese website inside the Firewall, PR, events and exhibitions.',
      },
      {
        name: 'Learn',
        body: 'Half-day and full-day masterclasses, multi-day learning expeditions to Shanghai and Shenzhen, and consumer research on demand.',
      },
    ],
    signal: 'Tmall, JD, Douyin, RED, WeChat',
    visit: { url: 'https://bearingbridge.com', label: 'bearingbridge.com' },
    based: 'Shanghai. Hong Kong. Paris.',
  },
  {
    slug: 'theredscroll',
    route: 'agencies/theredscroll',
    name: 'TheRedScroll',
    group: 'West to China',
    category: 'Chinese social media specialist',
    tagline: "We post on China's platforms. Every day. From the ground.",
    lead:
      'China runs on its own platforms. WeChat, Douyin, RedNote, Weibo, and fourteen others. Knowing this from a slide deck is not the same as opening these apps every morning.',
    lanes: [
      {
        name: 'Plan',
        body: 'Strategy, competitor research, content calendars and KPIs tied to business goals. Account setup, verification, naming, eCommerce integration with Tmall, JD and Douyin Shop.',
      },
      {
        name: 'Run',
        body: 'WeChat, Douyin, RedNote and Weibo at the core. Bilibili, Kuaishou, Zhihu and others as add-ons. Native copy, paid media with no markup on ad spend, and verified influencer engagement.',
      },
      {
        name: 'Sustain',
        body: 'WeCom and WeChat CRM, private domain, community and customer service flows. Masterclasses and strategic consulting on every platform we run.',
      },
    ],
    signal: 'Fixed scope. Fixed price. One number per package.',
    visit: { url: 'https://theredscroll.com', label: 'theredscroll.com' },
    based: 'Shanghai. Hong Kong.',
  },
  {
    slug: 'chinawebfoundry',
    route: 'agencies/chinawebfoundry',
    name: 'ChinaWebFoundry',
    group: 'West to China',
    category: 'Web infrastructure for the Chinese internet',
    tagline: 'Websites built for the Chinese internet, not retrofitted to it.',
    lead:
      'A Google Font gets blocked on a random Tuesday and your homepage turns into a mess for everyone in Shanghai. Your team in London does not know until someone complains. We build, host and monitor sites from inside the Firewall so that conversation never has to happen.',
    lanes: [
      {
        name: 'Plan',
        body: "China readiness audits from real browsers in Beijing, Shanghai and Shenzhen. Migration with ICP Bei'an, DNS cutover and a parallel staging environment you can test before you flip the switch.",
      },
      {
        name: 'Build',
        body: 'UX and UI tuned for Chinese readers. WeChat and Alipay checkout, UnionPay, WooCommerce localized for the mainland, and replacements for every blocked Google call inside your stack.',
      },
      {
        name: 'Find',
        body: 'Native Chinese content, Baidu Search Resource Platform submission and tracking, and generative engine optimization for DeepSeek, Doubao, Kimi, Yuanbao and Baidu AI.',
      },
      {
        name: 'Run',
        body: "China hosting on Alibaba Cloud, Tencent Cloud and Huawei Cloud. Hong Kong bridge hosting while Bei'an is processing. Maintenance and uptime monitored from Chinese networks.",
      },
    ],
    signal: 'Baidu held 60.1% of Chinese search in January 2025. Source: StatCounter.',
    visit: { url: 'https://chinawebfoundry.com', label: 'chinawebfoundry.com' },
    based: 'Shanghai. Hangzhou.',
  },
  {
    slug: 'compass',
    route: 'agencies/compass',
    name: 'Compass',
    group: 'West to China',
    category: 'Partner sourcing and vetting',
    tagline: 'Find the right China partner first.',
    lead:
      'A private file of distributors, Tmall TPs, Douyin Partners, and importers we have actually met, vetted, and worked with. The value is the context around the names, the verdicts, and the warm introductions, not access to a CSV.',
    lanes: [
      {
        name: 'Shortlist',
        body: 'Three to five vetted names, briefed in depth, ready to meet. For brands that already know what their distribution should look like. Two to three weeks.',
      },
      {
        name: 'Market map',
        body: 'Fifteen to twenty names mapped by category, channel, and footprint, with a structured comparison and a sequenced shortlist drawn from the names that survive it. Three to six weeks.',
      },
      {
        name: 'Replacement',
        body: 'For brands that already signed with the wrong partner. Same vetting, tighter constraints, contract unwind support, discreet by default.',
      },
    ],
    signal: 'Written deliverable, working session, warm introductions, honest verdicts.',
    visit: { url: 'https://compass.bearingbridge.com', label: 'compass.bearingbridge.com' },
    based: 'Shanghai. Twenty years of on-ground vetting.',
  },
  {
    slug: 'beyondbridge',
    route: 'agencies/beyondbridge',
    name: 'BeyondBridge',
    group: 'China to West',
    category: 'Overseas pipeline for Chinese companies',
    tagline: 'We grow Chinese companies overseas.',
    lead:
      'Most Chinese companies going overseas lose two years before they admit the playbook is broken. We close the gap between a great product and a buyer with one stack and one pipeline.',
    lanes: [
      {
        name: 'Build',
        body: 'Senior consulting on the big calls. Brand strategy built for the markets you are entering, not retrofitted from the China brand. A website that loads fast in Hamburg and Houston, with UX for the Western eye.',
      },
      {
        name: 'Demand',
        body: 'LinkedIn for B2B buyers. SEO and GEO that gets you found on Google and cited by ChatGPT, Perplexity and Claude. Google Ads that bring qualified leads while SEO compounds.',
      },
      {
        name: 'Close',
        body: 'Native sales reps in France, Germany, Italy, the UK, the United States, Australia and Latin America. They take the first call. When the deal is worth a flight, they go shake the buyer’s hand.',
      },
    ],
    signal: 'Paris, Munich, Milan, London, New York, Sydney, São Paulo',
    visit: { url: 'https://beyondbridge.com', label: 'beyondbridge.com' },
    based: 'China HQ. Reps in seven markets.',
  },
  {
    slug: 'bearingbridgeai',
    route: 'agencies/bearingbridgeai',
    name: 'BearingBridge AI',
    group: 'Horizontal',
    category: 'AI adoption consulting',
    tagline: 'AI adoption that survives contact with reality.',
    lead:
      'Senior consulting for companies that want AI running in their operations, not sitting in a slide deck. About a third of the use cases we assess should not be built, and we say so. Every pilot ships with kill criteria agreed before we start. You pay for evidence, not promises.',
    lanes: [
      {
        name: 'Assess',
        body: 'Three to eight weeks, fixed scope. A ranked portfolio of use cases and a roadmap your team can run without us. We tell you where AI does not belong.',
      },
      {
        name: 'Pilot',
        body: 'Six to twelve weeks. Success and kill criteria agreed up front, benchmarked East and West on your own data. We ship only what survives your operations.',
      },
      {
        name: 'Continuum',
        body: 'Fractional AI leadership. Monthly adoption and governance, quarterly steering with your executives. Handover is in the method, never an upsell.',
      },
      {
        name: 'Academy',
        body: 'Executive masterclasses, leadership workshops, and founder-led practitioner training. Your people keep running it after we leave.',
      },
    ],
    signal: 'Qwen, DeepSeek, Kimi, GPT, Claude, Gemini, benchmarked on your data',
    visit: { url: 'https://www.bearingbridge.ai', label: 'bearingbridge.ai' },
    based: 'Hong Kong. Shanghai. Across Asia, the Middle East, and Europe.',
  },
  {
    slug: 'hubstudio',
    route: 'agencies/hubstudio',
    name: 'HubStudio',
    group: 'Horizontal',
    category: 'Production house, AIGC at scale',
    tagline: 'A production house built for what content has become.',
    lead:
      'One global appliance brand watched approval rates triple and cost per asset fall by more than half within six months. That is roughly the gap between the old way of making content and how it has to work now.',
    lanes: [
      {
        name: 'Produce',
        body: 'On-brand visuals and video, priced per asset, from social cutdowns to full films. Live action studio in Shanghai. 3D, CGI and motion. Generated, shot, or hybrid.',
      },
      {
        name: 'Platform',
        body: 'Hub4You, your own content studio on dedicated GPU servers, integrated into your DAM and PIM. Brand-trained models, custom LoRAs, and pipelines built on ComfyUI, Flux, Wan, Veo, Hunyuan.',
      },
      {
        name: 'Direct',
        body: 'Content strategy, brand and visual identity, transcreation by creatives who live inside the target culture, and hands-on training for in-house teams.',
      },
    ],
    signal: 'Used by Mazda, Nescafe, Marriott, Bobbi Brown, and others.',
    visit: { url: 'https://hubstudio.ai', label: 'hubstudio.ai' },
    based: 'Shanghai studio. Global delivery.',
  },
  {
    slug: 'nuvora-studio',
    route: 'agencies/nuvora-studio',
    name: 'Nuvora Studio',
    group: 'Horizontal',
    category: 'LinkedIn-only B2B',
    tagline: 'Your buyers check it. Your hires check it. Your investors check it.',
    lead:
      "With over one billion members, LinkedIn is the world's professional record. We grow your presence on it. Every day. Strategy first, lock-in never.",
    lanes: [
      {
        name: 'Build',
        body: 'LinkedIn content planned, written, and published to drive leads. Executive personal branding for founders, CEOs, and senior leaders. Employee advocacy that turns your team into a content engine.',
      },
      {
        name: 'Convert',
        body: 'LinkedIn advertising tied to revenue, not vanity metrics. Targeting, creative and reporting that route qualified leads into your pipeline. No budget burned on the wrong audience.',
      },
      {
        name: 'Learn',
        body: 'Hands-on training and workshops on algorithm, profile, and content strategy. A full audit of your current LinkedIn presence and the roadmap to grow it.',
      },
    ],
    signal: 'B2B companies anywhere in the world.',
    visit: { url: 'https://nuvora.studio', label: 'nuvora.studio' },
    based: 'Global.',
  },
];

// Canonical display order, shared with the menu, footer and home page.
const agencyOrder = [
  'bearingbridge',
  'beyondbridge',
  'hubstudio',
  'bearingbridgeai',
  'chinawebfoundry',
  'theredscroll',
  'compass',
  'nuvora-studio',
];
agencies.sort((a, b) => agencyOrder.indexOf(a.slug) - agencyOrder.indexOf(b.slug));

const groups: { id: Group; label: string; intro: string; tag: string }[] = [
  {
    id: 'West to China',
    label: 'West to China',
    intro: 'For brands entering or scaling in China.',
    tag: 'min-tag--red',
  },
  {
    id: 'China to West',
    label: 'China to West',
    intro: 'For Chinese companies going overseas.',
    tag: 'min-tag--blue',
  },
  {
    id: 'Horizontal',
    label: 'Horizontal',
    intro: 'For any company, anywhere. AI adoption, content production, and LinkedIn.',
    tag: 'min-tag--green',
  },
];

const groupTag: Record<Group, string> = {
  'West to China': 'min-tag--red',
  'China to West': 'min-tag--blue',
  Horizontal: 'min-tag--green',
};

const stacks = [
  {
    scenario: 'A French skincare brand. Entering China.',
    steps: [
      { slug: 'compass', name: 'Compass', role: 'Choose the right distributor.' },
      { slug: 'chinawebfoundry', name: 'ChinaWebFoundry', role: 'Build the China site, ICP filed.' },
      { slug: 'bearingbridge', name: 'TheChinaPath', role: 'Operate Tmall, run media.' },
      { slug: 'theredscroll', name: 'TheRedScroll', role: 'WeChat, Douyin, RedNote, daily.' },
    ],
  },
  {
    scenario: 'A Chinese robotics company. Going overseas.',
    steps: [
      { slug: 'beyondbridge', name: 'BeyondBridge', role: 'Brand, site, demand, reps in the US and Germany.' },
      { slug: 'hubstudio', name: 'HubStudio', role: 'Content production at scale, on brand.' },
      { slug: 'nuvora-studio', name: 'Nuvora Studio', role: 'LinkedIn for the founder, every day.' },
    ],
  },
];
---

<Layout locale={locale} route="agencies" title={title} description={description}>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <h1 class="min-hero__title" data-reveal>
          Eight specialist agencies.<br />
          <em>One ecosystem.</em>
        </h1>
        <p class="min-hero__lead" data-reveal style="--i: 1">
          Each agency stands alone. Its own brand, its own pricing, its own deliverables. Pick the one that
          matches what you need. Most clients start with one and pull in others as the project expands.
        </p>

        <ul class="ag-logos" aria-label="Agency logos" data-reveal style="--i: 2">
          {agencies.map((a) => (
            <li>
              <a class="min-chip" href={`#${a.slug}`} aria-label={`Jump to ${a.name}`}>
                <AgencyLogo slug={a.slug} name={a.name} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Index by group -->
    <section class="min-sec">
      <div class="min-wrap">
        <div class="min-grid-3">
          {groups.map((g, gi) => (
            <div data-reveal style={`--i: ${gi}`}>
              <span class={`min-tag ${g.tag}`}>{g.label}</span>
              <p class="min-small ag-index__intro">{g.intro}</p>
              <ul class="ag-index__list">
                {agencies
                  .filter((a) => a.group === g.id)
                  .map((a) => (
                    <li>
                      <a href={`#${a.slug}`} class="ag-index__link">
                        <span class="ag-index__name">{a.name}</span>
                        <span class="ag-index__cat">{a.category}</span>
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Agency sections -->
    {agencies.map((a) => (
      <section id={a.slug} class="min-sec min-sec--ruled">
        <div class="min-wrap">
          <header class="ag-head" data-reveal>
            <div class="ag-head__left">
              <AgencyLogo slug={a.slug} name={a.name} class="ag-head__logo" />
              <span class={`min-tag ${groupTag[a.group]} ag-head__group`}>{a.group}, {a.category}</span>
            </div>
            <a class="min-link" href={a.visit.url} target="_blank" rel="noreferrer">{a.visit.label}</a>
          </header>

          <div class="ag-pitch" data-reveal style="--i: 1">
            <h2 class="min-h2">{a.tagline}</h2>
            <p class="min-body">{a.lead}</p>
          </div>

          <div class={`min-grid-${a.lanes.length} ag-lanes`}>
            {a.lanes.map((lane, li) => (
              <div class="min-card" data-reveal style={`--i: ${li + 1}`}>
                <h3 class="min-h3">{lane.name}</h3>
                <p class="min-small">{lane.body}</p>
              </div>
            ))}
          </div>

          <footer class="ag-foot" data-reveal>
            <div class="ag-foot__meta">
              <span class="min-muted"><strong>Based.</strong> {a.based}</span>
              {a.signal && <span class="min-muted ag-foot__signal">{a.signal}</span>}
            </div>
            <a class="min-btn" href={pathFor(a.route, locale)}>Open {a.name}</a>
          </footer>
        </div>
      </section>
    ))}

    <!-- How they fit together -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            One project.<br />
            <em>As many agencies as the work needs.</em>
          </h2>
          <p class="min-lead ag-stacks__lead">
            You do not have to figure out the order. Open the agency that matches your moment. We will tell
            you when it is time to bring another one in, and when you do not need to.
          </p>
        </header>

        <div class="min-grid-2 ag-stacks">
          {stacks.map((stack, si) => (
            <article class="min-card" data-reveal style={`--i: ${si}`}>
              <h3 class="min-h3 ag-stack__scenario">{stack.scenario}</h3>
              <ol class="ag-stack__steps">
                {stack.steps.map((step) => (
                  <li>
                    <a class="ag-stack__step" href={`#${step.slug}`}>
                      <span class="ag-stack__logo-box">
                        <AgencyLogo slug={step.slug} name={step.name} class="ag-stack__logo" />
                      </span>
                      <span class="ag-stack__text">
                        <span class="ag-stack__name">{step.name}</span>
                        <span class="ag-stack__role">{step.role}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>

        <div class="min-ctas" data-reveal>
          <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
          <a class="min-btn min-btn--ghost" href={pathFor('how-we-work', locale)}>How we work</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Hero logo chips */
  .ag-logos {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 176px);
    gap: 8px;
  }
  .ag-logos li { display: contents; }
  .ag-logos .min-chip { height: 52px; }
  .ag-logos :global(.agency-logo) { max-height: 22px; height: auto; width: auto; max-width: 100%; }
  @media (max-width: 900px) {
    .ag-logos { grid-template-columns: repeat(3, minmax(140px, 176px)); }
  }
  @media (max-width: 600px) {
    .ag-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Index by group */
  .ag-index__intro { margin: 0 0 var(--space-3); }
  .ag-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .ag-index__list li { border-bottom: 1px solid var(--line); }
  .ag-index__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .ag-index__name { font-weight: 600; font-size: 0.98rem; color: var(--ink); }
  .ag-index__cat { font-size: 0.78rem; color: var(--muted); }
  .ag-index__link:hover .ag-index__name { text-decoration: underline; }

  /* Agency feature sections */
  .ag-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }
  .ag-head__left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    flex-wrap: wrap;
  }
  .ag-head :global(.ag-head__logo) { height: 26px; width: auto; max-width: 160px; object-fit: contain; }
  .ag-head__group { margin-bottom: 0; }

  .ag-pitch {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-4), 3vw, var(--space-6));
    align-items: start;
    margin-bottom: var(--space-5);
  }
  .ag-pitch .min-h2 { margin-bottom: 0; }
  @media (max-width: 800px) {
    .ag-pitch { grid-template-columns: 1fr; }
  }

  .ag-lanes { margin-bottom: var(--space-5); }
  .ag-lanes .min-card { padding: var(--space-4); }

  .ag-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }
  .ag-foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .ag-foot__meta strong { color: var(--ink); font-weight: 600; margin-right: 4px; }
  .ag-foot__signal { font-style: italic; }

  /* Stacks */
  .ag-stacks__lead { margin-bottom: var(--space-5); }
  .ag-stacks { margin-bottom: var(--space-5); }
  .ag-stack__scenario {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .ag-stack__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .ag-stack__step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-2);
    border-radius: 8px;
    text-decoration: none;
    transition: background 200ms ease;
  }
  .ag-stack__step:hover { background: var(--surface-2); }
  .ag-stack__logo-box {
    display: grid;
    place-items: center;
    width: 56px;
    height: 38px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 5px 7px;
  }
  .ag-stack__logo-box :global(.ag-stack__logo) { max-height: 22px; max-width: 100%; width: auto; object-fit: contain; }
  .ag-stack__text { display: grid; gap: 1px; min-width: 0; }
  .ag-stack__name { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .ag-stack__role { font-size: 0.85rem; line-height: 1.4; color: var(--body); }
</style>
