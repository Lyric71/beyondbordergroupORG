---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/compass' as const;

type ShapeKey = 'shortlist' | 'map' | 'replace';
const shapes: Array<{
  key: ShapeKey;
  title: string;
  meta: string;
  tag: string;
  intro: string;
  image: string;
  imageLabel: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'shortlist',
    title: 'Shortlist',
    meta: '2 to 3 weeks',
    tag: 'min-tag--yellow',
    intro: 'Three to five vetted names, briefed in depth, ready to meet. For brands that already know what their distribution should look like.',
    image: '/images/compass-shortlist.svg',
    imageLabel: 'Editorial. Shortlist dossier with one name surfaced.',
    items: [
      { name: 'Curated names', body: 'Three to five partners that match your category, your stage, and your channel mix.' },
      { name: 'In-depth briefs', body: 'Footprint, brands they have worked with, commercial terms, our view on each.' },
      { name: 'Working session', body: 'Senior people walking through every name. Why this one, why not that one, where we would push in negotiation.' },
      { name: 'Warm introductions', body: 'You walk in with a relationship behind you. You tend to get the senior team, not the pitch team.' },
    ],
  },
  {
    key: 'map',
    title: 'Market map',
    meta: '3 to 6 weeks',
    tag: 'min-tag--green',
    intro: 'Fifteen to twenty names, structured for comparison. For brands still working out what their distribution should look like. Followed by a focused shortlist when you are ready.',
    image: '/images/compass-map.svg',
    imageLabel: 'Editorial. Market map laid out across a long table.',
    items: [
      { name: 'Longlist coverage', body: 'Fifteen to twenty names, mapped by category, channel, and footprint.' },
      { name: 'Structured comparison', body: 'Same categories on every row, so you can compare options on the same axes.' },
      { name: 'Channel logic', body: 'Cross-border versus domestic, Tmall TP versus distributor, B2B versus DTC. We say which fits.' },
      { name: 'Sequenced shortlist', body: 'The most common shape for first-time China entries. Map first, then a focused shortlist drawn from the names that survived it.' },
    ],
  },
  {
    key: 'replace',
    title: 'Replacement',
    meta: 'Contract-dependent',
    tag: 'min-tag--red',
    intro: 'For brands that already signed with the wrong partner. The shortlist work is the same. The constraints are tighter and there is usually a contract to unwind.',
    image: '/images/compass-replacement.svg',
    imageLabel: 'Editorial. Replacement work, contract review, Shanghai.',
    items: [
      { name: 'Replacement shortlist', body: 'Same vetting, same warm introductions, but built around an active operation.' },
      { name: 'Transition planning', body: 'How to move inventory, channels, and content without losing the launch window.' },
      { name: 'Contract unwind support', body: 'We help on the resourcing side. Finding a replacement, comparing options, running the transition.' },
      { name: 'Discreet by default', body: 'No public noise. We have done this enough times to know when to keep quiet.' },
    ],
  },
];

type IconKey = 'doc' | 'session' | 'intro' | 'verdict';
const included: Array<{ icon: IconKey; title: string; body: string }> = [
  {
    icon: 'doc',
    title: 'A written deliverable',
    body: 'Real categories, channels, footprint, commercial terms, the brands they have worked with, and our view on each name.',
  },
  {
    icon: 'session',
    title: 'A working session',
    body: 'A senior operator walks you through the list, name by name, and tells you where we would push in negotiation.',
  },
  {
    icon: 'intro',
    title: 'Warm introductions',
    body: 'We do not sell introductions to strangers. If a name is in Compass, someone here has sat across the table from them.',
  },
  {
    icon: 'verdict',
    title: 'Honest assessments',
    body: 'Who we would recommend without thinking twice, who we would warn you off, and who only fits a very specific kind of brand.',
  },
];

const boundaries: Array<{ action: string; note: string; instead: string }> = [
  {
    action: 'Sell access to the database.',
    note: 'No login, no seat license.',
    instead: 'The value is the context around the rows, and that does not export to a CSV. You get our read on each name, in person.',
  },
  {
    action: 'Run the partnership once it is signed.',
    note: 'Sourcing, not management.',
    instead: 'TheChinaPath does that work separately, when you want it. Two teams, one clean handoff.',
  },
  {
    action: 'Promise outcomes two years out.',
    note: 'No one honest can.',
    instead: 'What we can do is make sure every name on your list earned its place. The rest is yours to run.',
  },
];

const visitUrl = 'https://compass.bearingbridge.com';
const visitLabel = 'Visit Compass';
---

<Layout
  locale={locale}
  route={route}
  title="Compass. Find the right China partner first."
  description="A private database of distributors, Tmall TPs, Douyin Partners and importers we have actually met, vetted, and worked with. Shortlist, market map, or replacement, sourced from twenty years on the ground."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="bc-hero">
          <div>
            <span class="min-chip bc-hero__logo" data-reveal>
              <AgencyLogo slug="compass" name="Compass" />
            </span>
            <span class="min-tag min-tag--green bc-hero__eyebrow" data-reveal style="--i: 1">
              Distributors, Tmall TPs and Douyin partners, twenty years deep
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              A contact list tells you who <em>exists</em>. We tell you who <em>fits</em>.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">
              We did the sourcing already. You do not have to start where most brands do.
            </p>
            <div class="min-ctas bc-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide bc-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/compass-site.webp" alt="The Compass site by BearingBridge: a private database of vetted China distribution and channel partners." width="1440" height="900" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="min-sec" id="track">
      <div class="min-wrap">
        <div class="bc-track" data-reveal>
          <span class="bc-track__num" aria-hidden="true">20</span>
          <div>
            <h2 class="min-h2">Twenty years of meetings, vetted into one private database.</h2>
            <p class="min-body">
              A directory cannot protect you from a wrong-partner mistake. A database built one meeting at a time can. Almost every name in Compass is someone our team has met, briefed, or worked with on a real brand project.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What we do: three shapes -->
    <section class="min-sec min-sec--ruled" id="shapes">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Partner sourcing, in three shapes.
          </h2>
          <p class="min-lead bc-shapes__lead">
            We use Compass to draw you a list of distribution and channel partners worth talking to, validated against what we have seen recently and what we know about your category.
          </p>
        </header>

        {shapes.map((s, i) => (
          <div class={`min-split ${i % 2 === 1 ? 'min-split--reverse' : ''} bc-shape`} data-reveal>
            {i % 2 === 1 ? (
              <>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta bc-shape__meta">{s.meta}</p>
                  <p class="min-body bc-shape__intro">{s.intro}</p>
                  <ul class="bc-shape__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="min-photo bc-shape__photo">
                  <img src={s.image} alt={s.imageLabel} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
              </>
            ) : (
              <>
                <figure class="min-photo bc-shape__photo">
                  <img src={s.image} alt={s.imageLabel} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta bc-shape__meta">{s.meta}</p>
                  <p class="min-body bc-shape__intro">{s.intro}</p>
                  <ul class="bc-shape__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Included, every time -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>
          A list is not worth much if you do not trust the thinking behind it.
        </h2>

        <div class="min-grid-2">
          {included.map((it, i) => (
            <article class="min-card bc-included" data-reveal style={`--i: ${i}`}>
              <span class="bc-included__icon" aria-hidden="true">
                {it.icon === 'doc' && (
                  <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
                    <path d="M7 4.5h10l4 4v15A1.5 1.5 0 0 1 19.5 25h-12A1.5 1.5 0 0 1 6 23.5V6A1.5 1.5 0 0 1 7.5 4.5Z" stroke="currentColor"/>
                    <path d="M17 4.5v4h4" stroke="currentColor"/>
                    <path d="M9.5 13h9M9.5 16.5h9M9.5 20h6" stroke="currentColor"/>
                  </svg>
                )}
                {it.icon === 'session' && (
                  <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
                    <circle cx="10" cy="10" r="3.2" stroke="currentColor"/>
                    <circle cx="19" cy="11.5" r="2.6" stroke="currentColor"/>
                    <path d="M4 22c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor"/>
                    <path d="M16.5 22c0-2.7 2-5 4.5-5 1.5 0 2.8.8 3.5 2" stroke="currentColor"/>
                  </svg>
                )}
                {it.icon === 'intro' && (
                  <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
                    <path d="M3.5 14.5l5-3 4 2.5 6-3.5 6 4" stroke="currentColor"/>
                    <circle cx="3.5" cy="14.5" r="1.7" stroke="currentColor" fill="currentColor"/>
                    <circle cx="8.5" cy="11.5" r="1.7" stroke="currentColor"/>
                    <circle cx="12.5" cy="14" r="1.7" stroke="currentColor"/>
                    <circle cx="18.5" cy="10.5" r="1.7" stroke="currentColor"/>
                    <circle cx="24.5" cy="14.5" r="1.7" stroke="currentColor" fill="currentColor"/>
                  </svg>
                )}
                {it.icon === 'verdict' && (
                  <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
                    <path d="M14 4.5L23 8v6.5c0 4.7-3.6 8.6-9 9.5-5.4-.9-9-4.8-9-9.5V8l9-3.5Z" stroke="currentColor"/>
                    <path d="M10 14.5l3 3 5.5-6" stroke="currentColor"/>
                  </svg>
                )}
              </span>
              <div>
                <h3 class="min-h3">{it.title}</h3>
                <p class="min-small">{it.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Manifesto -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split bc-manifesto">
          <div>
            <h2 class="min-h2 bc-manifesto__title" data-reveal>
              China rewards brands that pick the right partner first.<br />
              It punishes the ones that do not.<br />
              <span class="bc-manifesto__hush">The punishment is rarely loud.</span>
            </h2>

            <div class="bc-cost" data-reveal style="--i: 1">
              <span class="min-tag min-tag--red">What the wrong call costs</span>
              <ul class="bc-cost__list">
                <li class="bc-cost__item">
                  <span class="bc-cost__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/></svg>
                  </span>
                  <span class="min-small"><strong>Eighteen months.</strong> Inventory sits in a warehouse.</span>
                </li>
                <li class="bc-cost__item">
                  <span class="bc-cost__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V8l7-4 7 4v13"/><path d="M9.5 11.5l5 5M14.5 11.5l-5 5"/></svg>
                  </span>
                  <span class="min-small"><strong>The wrong hands.</strong> A flagship run by a team that has never moved your category.</span>
                </li>
                <li class="bc-cost__item">
                  <span class="bc-cost__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="M9 14l6 0"/></svg>
                  </span>
                  <span class="min-small"><strong>Two years.</strong> Your China entry, gone.</span>
                </li>
              </ul>
            </div>

            <p class="min-kicker bc-payoff" data-reveal style="--i: 2">A database built one meeting at a time, over twenty years, can protect you from that.</p>
          </div>

          <figure class="min-photo min-photo--tall bc-manifesto__media" data-reveal style="--i: 1">
            <img src="/images/compass-manifesto.webp" alt="A dim warehouse aisle stacked with unsold inventory boxes" width="1050" height="1050" loading="lazy" decoding="async" />
            <figcaption class="min-muted bc-manifesto__cap">Twenty years on the ground in China.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Boundaries -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Three lines we keep clean.
          </h2>
          <p class="min-lead bc-bounds__lead">
            So you always know what you are paying for, and what you are not.
          </p>
        </header>

        <ol class="bc-bounds__list">
          {boundaries.map((b, i) => (
            <li>
              <article class="min-card bc-bound" data-reveal style={`--i: ${i}`}>
                <div>
                  <span class="min-tag min-tag--red">We don't</span>
                  <h3 class="min-h3 bc-bound__headline">{b.action}</h3>
                  <p class="min-muted bc-bound__note">{b.note}</p>
                </div>
                <div>
                  <span class="min-tag min-tag--green">What we do instead</span>
                  <p class="min-small bc-bound__instead">{b.instead}</p>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 bc-cta__title">
          Find the right China partner first.<br />Before the wrong one finds you.
        </h2>
        <div class="min-ctas bc-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bc-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .bc-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .bc-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .bc-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .bc-hero__eyebrow { display: inline-block; }
  .bc-hero__ctas { margin-top: var(--space-2); }
  .bc-hero__shot { display: block; }
  .bc-hero__shot img { aspect-ratio: 16 / 10; object-position: top center; }

  .bc-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .bc-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .bc-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .bc-track .min-body { margin: 0; }

  .bc-shapes__lead { margin-bottom: var(--space-6); }
  .bc-shape { align-items: start; }
  .bc-shape + .bc-shape { margin-top: var(--space-7); }
  .bc-shape__meta { margin: 0 0 var(--space-3); }
  .bc-shape__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .bc-shape__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .bc-shape__list strong { color: var(--ink); font-weight: 600; }
  .bc-shape__photo { max-width: 440px; width: 100%; }
  .bc-shape__photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .bc-shape__photo { max-width: 100%; }
    .bc-shape__photo img { aspect-ratio: 16 / 9; }
  }

  .bc-included {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .bc-included__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink);
    flex-shrink: 0;
  }
  .bc-included__icon svg { width: 24px; height: 24px; }

  .bc-manifesto { align-items: start; }
  .bc-manifesto__title { max-width: none; }
  .bc-manifesto__hush { color: var(--muted); }
  .bc-cost { margin-top: var(--space-5); }
  .bc-cost__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .bc-cost__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
  }
  .bc-cost__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: #fdebec;
    color: #9f2f2d;
    flex-shrink: 0;
  }
  .bc-cost__icon svg { width: 19px; height: 19px; }
  .bc-cost__item strong { color: var(--ink); font-weight: 600; }
  .bc-payoff { margin-top: var(--space-5); }
  .bc-manifesto__media { max-width: 400px; width: 100%; justify-self: end; }
  .bc-manifesto__media img { object-position: center 40%; }
  .bc-manifesto__cap { padding: var(--space-2) var(--space-3); }
  @media (max-width: 900px) {
    .bc-manifesto__media { justify-self: start; max-width: 100%; }
    .bc-manifesto__media img { aspect-ratio: 16 / 10; }
  }

  .bc-bounds__lead { margin-bottom: var(--space-5); }
  .bc-bounds__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .bc-bound {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(var(--space-4), 4vw, var(--space-6));
    align-items: start;
  }
  @media (max-width: 700px) {
    .bc-bound { grid-template-columns: 1fr; gap: var(--space-3); }
  }
  .bc-bound__headline { margin-bottom: var(--space-2); }
  .bc-bound__note { margin: 0; }
  .bc-bound__instead { margin: 0; }

  .bc-cta__title { margin-inline: auto; }
  .bc-cta__actions { justify-content: center; }
</style>
