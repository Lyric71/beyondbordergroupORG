---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/beyondbridge' as const;

type LaneKey = 'build' | 'demand' | 'close';
const lanes: Array<{
  key: LaneKey;
  title: string;
  tag: string;
  intro: string;
  image: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'build',
    title: 'Build',
    tag: 'min-tag--blue',
    intro: 'The brand a Western buyer will trust, on a site that does not feel translated.',
    image: '/images/bb-bridge-build.webp',
    items: [
      { name: 'Consulting', body: 'Senior counsel for the big calls. Market choice, positioning, pricing, go or no go. Standalone for companies that want the thinking without the doing.' },
      { name: 'Brand Strategy for Overseas', body: 'Built for the markets you are entering, not retrofitted from the China brand.' },
      { name: 'Website', body: 'UX and UI for the Western eye, not the Chinese one. Hosted outside the firewall, fast in Hamburg and Houston.' },
    ],
  },
  {
    key: 'demand',
    title: 'Demand',
    tag: 'min-tag--yellow',
    intro: 'The channels that put you in front of buyers who are already looking.',
    image: '/images/bb-bridge-demand.webp',
    items: [
      { name: 'LinkedIn', body: 'Where Western B2B buyers live. Founder profile, company page, content and outreach.' },
      { name: 'SEO and GEO', body: 'Found on Google, cited by ChatGPT, Perplexity and Claude. Built for buyers searching in English, German, French.' },
      { name: 'Google Ads', body: 'Paid search that brings qualified leads while SEO compounds. Reported in RMB.' },
    ],
  },
  {
    key: 'close',
    title: 'Close',
    tag: 'min-tag--green',
    intro: "Real people in seven markets. They take the first call. When the deal is worth a flight, they go shake the buyer's hand.",
    image: '/images/bb-bridge-sell.webp',
    items: [
      { name: 'External Sales Force', body: 'Native reps in France, Germany, Italy, the UK, the United States, Australia and Latin America. Your team in their market, on your retainer.' },
    ],
  },
];

const visitUrl = 'https://beyondbridge.ai';
const visitLabel = 'Visit beyondbridge.ai';
---

<Layout
  locale={locale}
  route={route}
  title="BeyondBridge. We Grow Chinese Companies Overseas."
  description="We help Chinese companies find Western buyers. Brand, website, LinkedIn, ads, and real sales people in seven countries. One stack. One pipeline."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="bb-hero">
          <div>
            <span class="min-chip bb-hero__logo" data-reveal>
              <AgencyLogo slug="beyondbridge" name="BeyondBridge" />
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 1">
              We grow <em>Chinese companies</em> overseas.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 2">Most Chinese companies going overseas lose two years before they admit the playbook is broken. We close the gap between a great product and a buyer.</p>
            <div class="min-ctas bb-hero__ctas" data-reveal style="--i: 3">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
            </div>
          </div>
          <figure class="min-photo min-photo--wide bb-hero__shot" data-reveal style="--i: 2">
            <img src="/images/bb-site-shot.webp" alt="The BeyondBridge website homepage" width="1440" height="900" loading="eager" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="min-sec" id="track">
      <div class="min-wrap">
        <div class="bb-track" data-reveal>
          <span class="bb-track__num" aria-hidden="true">7</span>
          <div>
            <h2 class="min-h2">Seven cities. One team. One pipeline from your factory to your first signed deal.</h2>
            <p class="min-body">
              We are not consultants who write a deck and disappear. We are operators. Our CEO ran Publicis Commerce in China for years. We build the brand, the site, the LinkedIn presence, the search and the ads. Then we put real people on the ground who pick up the phone, in Paris, Munich, Milan, London, New York, Sydney and São Paulo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- The gap -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <h2 class="min-h2 bb-gap__title" data-reveal>
          Translate the homepage.<br />
          Hire someone in Frankfurt.<br />
          Send the founder out twice a year.<br />
          Wait for a distributor to call.
        </h2>
        <div data-reveal style="--i: 1">
          <p class="min-body bb-gap__p">The call rarely comes.</p>
          <p class="min-body bb-gap__p">The website looks like 2014. The hire quits inside six months. And the factory keeps making great products that the right buyers have never heard of.</p>
          <p class="min-kicker bb-gap__emphasis">That is where companies die. In the gap between a great product and a buyer in Hamburg or Houston who actually picks up the phone.</p>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Seven modules. One pipeline.<br />
            Buy the stack or any module on its own.
          </h2>
          <p class="min-lead bb-services__lead">Quarterly retainer with a setup phase. Pick the lane that fits your moment, or run all three.</p>
        </header>

        {lanes.map((s, i) => (
          <div class={`min-split ${i % 2 === 1 ? 'min-split--reverse' : ''} bb-lane`} data-reveal>
            {i % 2 === 1 ? (
              <>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta bb-lane__count">{s.items.length} {s.items.length === 1 ? 'service' : 'services'}</p>
                  <p class="min-body bb-lane__intro">{s.intro}</p>
                  <ul class="bb-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="min-photo bb-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
              </>
            ) : (
              <>
                <figure class="min-photo bb-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta bb-lane__count">{s.items.length} {s.items.length === 1 ? 'service' : 'services'}</p>
                  <p class="min-body bb-lane__intro">{s.intro}</p>
                  <ul class="bb-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- How we operate -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 bb-operate__title">One stack. One team. One pipeline.</h2>
        <p class="min-body bb-operate__p">From your factory to your first signed deal.</p>
        <p class="min-kicker bb-operate__emphasis">Every quarter you wait, a smaller competitor gets closer to your buyer.</p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 bb-cta__title">Book a call.<br />We will tell you what your first ninety days look like.</h2>
        <div class="min-ctas bb-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bb-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .bb-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .bb-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .bb-hero__logo :global(.agency-logo) { height: 28px; width: auto; }
  .bb-hero__ctas { margin-top: var(--space-2); }
  .bb-hero__shot img { object-position: center top; }

  .bb-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .bb-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .bb-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .bb-track .min-body { margin: 0; }

  .bb-gap__title { max-width: none; }
  .bb-gap__p { margin-bottom: var(--space-3); }
  .bb-gap__emphasis { margin-top: var(--space-4); }

  .bb-services__lead { margin-bottom: var(--space-6); }
  .bb-lane { align-items: start; }
  .bb-lane + .bb-lane { margin-top: var(--space-7); }
  .bb-lane__count { margin: 0 0 var(--space-3); }
  .bb-lane__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .bb-lane__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .bb-lane__list strong { color: var(--ink); font-weight: 600; }
  .bb-lane__photo { max-width: 440px; width: 100%; }
  .bb-lane__photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .bb-lane__photo { max-width: 100%; }
    .bb-lane__photo img { aspect-ratio: 16 / 9; }
  }

  .bb-operate__title { margin-inline: auto; }
  .bb-operate__p { margin: 0 auto var(--space-3); }
  .bb-operate__emphasis { margin: 0 auto; }

  .bb-cta__title { margin-inline: auto; }
  .bb-cta__actions { justify-content: center; }
</style>
