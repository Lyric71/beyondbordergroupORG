---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'en' as const;
const route = 'agencies/hubstudio' as const;

type ServiceKey = 'produce' | 'platform' | 'direct';
const services: Array<{
  key: ServiceKey;
  title: string;
  tag: string;
  intro: string;
  image: string;
  items: { name: string; body: string }[];
}> = [
  {
    key: 'produce',
    title: 'Produce',
    tag: 'min-tag--red',
    intro: 'On-brand visuals, video, and copy. Hundreds of finalized assets a month, generated, shot, or hybrid.',
    image: '/images/hubstudio-produce.webp',
    items: [
      { name: 'Image Production', body: 'On-brand visuals at scale, from $35 a brief to $405 a finalized asset. Multiple variations, full retouching, three rounds of modification. Generated, shot, or hybrid.' },
      { name: 'Short and Long Video', body: 'From $200 per script. Pre-production, post-production, voice over, music, subtitles. Real shoots, generated, or hybrid.' },
      { name: 'Live Action Studio', body: 'Real photo and video shoots when the brief calls for it. Used by Mazda, Nescafe, Marriott, Bobbi Brown, and others.' },
      { name: '3D, CGI, Motion', body: '3D animation, CGI product work, motion design, video branding, voice over, text-to-speech.' },
    ],
  },
  {
    key: 'platform',
    title: 'Platform',
    tag: 'min-tag--blue',
    intro: 'Your own content studio on dedicated GPU infrastructure. Trained on your brand. Run by your team.',
    image: '/images/hubstudio-platform.webp',
    items: [
      { name: 'Hub4You Platform', body: 'A custom content platform deployed on your dedicated GPU servers, integrated into your DAM and PIM. Your team operates it. We train and support. Deployment in weeks.' },
      { name: 'Brand-Trained Models', body: 'Custom LoRAs and fine-tunes per client. Your colors, your style, your products. Locked in and reproducible.' },
      { name: 'Pipelines and Tooling', body: 'Production workflows built on ComfyUI, Flux, Wan, Veo, Hunyuan, and whatever model just dropped last week. Tested in real campaigns, not demos.' },
    ],
  },
  {
    key: 'direct',
    title: 'Direct',
    tag: 'min-tag--yellow',
    intro: 'The creative intelligence layer. Strategy, transcreation, training. The part that cannot be automated.',
    image: '/images/hubstudio-direct.webp',
    items: [
      { name: 'Strategy and Guidelines', body: 'Content strategy, brand positioning, visual identity, campaign creative, AI usage policy, approval workflows.' },
      { name: 'Transcreation', body: 'Multi-market, multi-language, culturally native. Built by creatives who live inside the target culture.' },
      { name: 'Training', body: 'Hands-on workshops for in-house teams on ComfyUI, Flux, Wan, Veo, MidJourney, Gemini.' },
    ],
  },
];

const visitUrl = 'https://hubstudio.ai';
const visitLabel = 'Visit hubstudio.ai';
---

<Layout
  locale={locale}
  route={route}
  title="HubStudio: AI Content Production at Half the Cost"
  description="A China-based production house using AIGC at scale to cut content costs by 60% and ship hundreds of on-brand assets a month for global brands."
>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-wrap--wide">
        <div class="hs-hero">
          <div>
            <span class="min-chip hs-hero__logo" data-reveal>
              <AgencyLogo slug="hubstudio" name="HubStudio" />
            </span>
            <span class="min-tag min-tag--red hs-hero__eyebrow" data-reveal style="--i: 1">
              A Shanghai production house, AIGC at scale
            </span>
            <h1 class="min-hero__title" data-reveal style="--i: 2">
              A production house built for what <em>content</em> has become.
            </h1>
            <p class="min-hero__lead" data-reveal style="--i: 3">A global appliance brand came to us last year with a 22 percent approval rate. Six months later, that rate hit 78 percent. Output multiplied by seven. Cost dropped by 60 percent. That is roughly the gap between the old way of making content and how it has to work now.</p>
            <div class="min-ctas hs-hero__ctas" data-reveal style="--i: 4">
              <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
              <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
            </div>
          </div>
          <a class="min-photo min-photo--wide hs-hero__shot" href={visitUrl} target="_blank" rel="noreferrer" aria-label={visitLabel} data-reveal style="--i: 2">
            <img src="/images/hubstudio-home.webp" alt="hubstudio.ai homepage" width="1440" height="900" loading="eager" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <!-- Track record -->
    <section class="min-sec" id="track">
      <div class="min-wrap">
        <div class="hs-track" data-reveal>
          <span class="hs-track__num" aria-hidden="true">60%</span>
          <div>
            <h2 class="min-h2">Cost per finalized asset, down by more than half. Output multiplied by seven.</h2>
            <p class="min-body">
              Used the right way, AI generation cuts the cost of a finalized asset by half or more. The savings are real and we pass them through to the client. Brands need hundreds of assets a month, sometimes thousands of them, across formats nobody was making five years ago. Traditional studios were never built for any of this. We were. The work has shipped for Mazda, Nescafe, Marriott and Bobbi Brown.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="min-sec min-sec--ruled" id="services">
      <div class="min-wrap">
        <header data-reveal>
          <h2 class="min-h2">
            Produce. Platform. Direct.
          </h2>
          <p class="min-lead hs-services__lead">We are a full production house. We shoot, we direct, we retouch, we edit. We also use AI generation at a level most studios have not reached yet, and that is the part worth talking about.</p>
        </header>

        {services.map((s, i) => (
          <div class={`min-split ${i % 2 === 1 ? 'min-split--reverse' : ''} hs-lane`} data-reveal>
            {i % 2 === 1 ? (
              <>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta hs-lane__count">{s.items.length} services</p>
                  <p class="min-body hs-lane__intro">{s.intro}</p>
                  <ul class="hs-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
                <figure class="min-photo hs-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
              </>
            ) : (
              <>
                <figure class="min-photo hs-lane__photo">
                  <img src={s.image} alt={`${s.title} editorial`} width="1050" height="620" loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span class={`min-tag ${s.tag}`}>{s.title}</span>
                  <p class="min-meta hs-lane__count">{s.items.length} services</p>
                  <p class="min-body hs-lane__intro">{s.intro}</p>
                  <ul class="hs-lane__list">
                    {s.items.map((it) => (
                      <li class="min-small">
                        <strong>{it.name}.</strong> {it.body}
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Two ways to work -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <h2 class="min-h2" data-reveal>Send the brief. Or run the platform.</h2>
        <div class="min-grid-2">
          <article class="min-card" data-reveal>
            <span class="min-tag min-tag--plain">Service</span>
            <h3 class="min-h3">We do it for you.</h3>
            <p class="min-small">
              Send the brief, we deliver the content. Visuals, video, eCom packs, campaign adaptations, transcreation, full photo and video shoots when the brief calls for it. Hundreds of assets a month, on brand, on time.
            </p>
          </article>
          <article class="min-card" data-reveal style="--i: 1">
            <span class="min-tag min-tag--plain">Platform</span>
            <h3 class="min-h3">We build the platform for you.</h3>
            <p class="min-small">
              Hub4You is our custom content platform, deployed on your dedicated GPU servers, integrated into your DAM and PIM. Your team operates it, we train and support. Deployment in weeks.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- How we operate -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow">
        <h2 class="min-h2 hs-operate__title" data-reveal>
          Creative intelligence is the only thing left that matters.<br />
          Culture cannot be briefed.
        </h2>
        <div data-reveal style="--i: 1">
          <p class="min-body hs-operate__p">Anyone can generate a passable image now. The difference between passable and brilliant sits with the humans directing the work.</p>
          <p class="min-kicker hs-operate__emphasis">Three-day turnarounds used to be impossible. Now they are the floor we work from.</p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 hs-cta__title">The production house brands choose<br />when the old way stops working.</h2>
        <div class="min-ctas hs-cta__actions">
          <a class="min-btn" href={visitUrl} target="_blank" rel="noreferrer">{visitLabel}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hs-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 900px) {
    .hs-hero { grid-template-columns: 1fr; gap: var(--space-5); }
  }
  .hs-hero__logo { display: inline-flex; margin-bottom: var(--space-4); }
  .hs-hero__logo :global(.agency-logo) { height: 26px; width: auto; }
  .hs-hero__eyebrow { display: inline-block; }
  .hs-hero__ctas { margin-top: var(--space-2); }
  .hs-hero__shot { display: block; }
  .hs-hero__shot img { aspect-ratio: 16 / 10; object-position: center top; }

  .hs-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(var(--space-5), 5vw, var(--space-7));
    align-items: center;
  }
  @media (max-width: 800px) {
    .hs-track { grid-template-columns: 1fr; gap: var(--space-4); }
  }
  .hs-track__num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(4.5rem, 10vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .hs-track .min-body { margin: 0; }

  .hs-services__lead { margin-bottom: var(--space-6); }
  .hs-lane { align-items: start; }
  .hs-lane + .hs-lane { margin-top: var(--space-7); }
  .hs-lane__count { margin: 0 0 var(--space-3); }
  .hs-lane__intro { margin: 0 0 var(--space-4); font-weight: 550; color: var(--ink); }
  .hs-lane__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .hs-lane__list strong { color: var(--ink); font-weight: 600; }
  .hs-lane__photo { max-width: 440px; width: 100%; }
  .hs-lane__photo img { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .hs-lane__photo { max-width: 100%; }
    .hs-lane__photo img { aspect-ratio: 16 / 9; }
  }

  .hs-operate__title { max-width: none; }
  .hs-operate__p { margin-bottom: var(--space-3); }
  .hs-operate__emphasis { margin-top: var(--space-4); }

  .hs-cta__title { margin-inline: auto; }
  .hs-cta__actions { justify-content: center; }
</style>
