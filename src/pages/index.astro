---
import Layout from '../layouts/Layout.astro';
import AgencyLogo from '../components/AgencyLogo.astro';
import { pathFor, type Route } from '../i18n/ui';

const locale = 'en' as const;
const title = 'AI consulting, cross-border growth, and products we own';
const description = 'AI services, cross-border marketing between China and the West, and AI-powered media and software we own and operate. One group, three practices.';

const linkedinUrl = 'https://www.linkedin.com/in/cyril-d-68835729/';

type Brand = { name: string; logoRoute?: string; icon?: string };

const practices: { key: string; label: string; line: string; brands: Brand[]; href: string; img: string; alt: string }[] = [
  {
    key: 'ai',
    label: 'AI Services',
    line: 'From strategy through production. We benchmark Western and Chinese models side by side, implement on your data, then turn AI into content and pipeline at scale. Intelligence, our platform, lets you watch AI run real tasks before you commit.',
    brands: [
      { name: 'BearingBridge AI', logoRoute: 'agencies/bearingbridgeai' },
      { name: 'Intelligence', icon: '/AgencyLogos/intelligence-icon.png' },
      { name: 'HubStudio', logoRoute: 'agencies/hubstudio' },
      { name: 'Nuvora Studio', logoRoute: 'agencies/nuvora-studio' },
    ],
    href: pathFor('ai-services', locale),
    img: '/images/photo-practice-ai.webp',
    alt: 'Three colleagues reviewing work on a laptop in a bright office.',
  },
  {
    key: 'cb',
    label: 'Cross-Border Marketing',
    line: 'For brands crossing between China and the West, either direction: brand, channels, web, partner sourcing, sales. The track record spans beauty, automotive, food and beverage, hospitality, and home.',
    brands: [
      { name: 'TheChinaPath', logoRoute: 'agencies/bearingbridge' },
      { name: 'BeyondBridge', logoRoute: 'agencies/beyondbridge' },
      { name: 'ChinaWebFoundry', logoRoute: 'agencies/chinawebfoundry' },
      { name: 'TheRedScroll', logoRoute: 'agencies/theredscroll' },
      { name: 'Compass', logoRoute: 'agencies/compass' },
    ],
    href: pathFor('cross-border-marketing', locale),
    img: '/images/photo-practice-cb.webp',
    alt: 'Container port cranes at golden hour.',
  },
  {
    key: 'products',
    label: 'Products',
    line: 'Proof before promises. Media and software we own and run ourselves, starting with BBChien, built on the stack we sell and live in public.',
    brands: [{ name: 'BBChien', logoRoute: 'bbchien' }, { name: 'DeuceLadder' }],
    href: pathFor('products', locale),
    img: '/images/photo-practice-products.webp',
    alt: 'A small dog on a couch next to a person with a laptop.',
  },
];

type HeroBrand = { name: string; href: string; route?: Route; slug?: string; icon?: string };

const heroBrands: HeroBrand[] = [
  { name: 'BearingBridge AI', href: pathFor('agencies/bearingbridgeai', locale), route: 'agencies/bearingbridgeai' },
  { name: 'Intelligence', href: pathFor('ai-services/intelligence', locale), icon: '/AgencyLogos/intelligence-icon.png' },
  { name: 'HubStudio', href: pathFor('agencies/hubstudio', locale), route: 'agencies/hubstudio' },
  { name: 'Nuvora Studio', href: pathFor('agencies/nuvora-studio', locale), route: 'agencies/nuvora-studio' },
  { name: 'TheChinaPath', href: pathFor('agencies/bearingbridge', locale), route: 'agencies/bearingbridge' },
  { name: 'BeyondBridge', href: pathFor('agencies/beyondbridge', locale), route: 'agencies/beyondbridge' },
  { name: 'ChinaWebFoundry', href: pathFor('agencies/chinawebfoundry', locale), route: 'agencies/chinawebfoundry' },
  { name: 'TheRedScroll', href: pathFor('agencies/theredscroll', locale), route: 'agencies/theredscroll' },
  { name: 'Compass', href: pathFor('agencies/compass', locale), route: 'agencies/compass' },
  { name: 'BBChien', href: `${pathFor('products', locale)}#bbchien`, slug: 'bbchien' },
];
---

<Layout locale={locale} route="home" title={title} description={description}>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-center home-hero__inner">
        <h1 class="min-hero__title" data-reveal>One group. Three practices.</h1>
        <p class="min-hero__lead" data-reveal style="--i: 1">
          Three businesses under one roof: AI consulting and production, cross-border growth between China
          and the West, and products we own.
        </p>
        <div class="min-ctas home-hero__ctas" data-reveal style="--i: 2">
          <a class="min-btn" href="#practices">Pick your practice</a>
          <a class="min-btn min-btn--ghost" href={pathFor('contact', locale)}>Book a call</a>
        </div>
        <ul class="home-logos" aria-label="The BearingBridge brands" data-reveal style="--i: 3">
          {heroBrands.map((b) => (
            <li>
              <a class="min-chip" href={b.href} aria-label={b.name}>
                {b.route ? (
                  <AgencyLogo route={b.route} name={b.name} />
                ) : b.slug ? (
                  <AgencyLogo slug={b.slug} name={b.name} />
                ) : (
                  <>
                    <img class="min-chip__icon" src={b.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />
                    <span class="min-chip__name">{b.name}</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Practices -->
    <section class="min-sec" id="practices">
      <div class="min-wrap">
        <div class="min-grid-3">
          {practices.map((p, i) => (
            <a class="min-card home-practice" href={p.href} data-reveal style={`--i: ${i}`}>
              <figure class="min-photo min-photo--wide">
                <img
                  src={p.img}
                  alt={p.alt}
                  width="1050"
                  height="620"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
              <h2 class="home-practice__title">{p.label}</h2>
              <p class="min-small">{p.line}</p>
              <span class="home-practice__brands">
                {p.brands.map((b) => (
                  <span class="min-pill">
                    {b.logoRoute ? (
                      <AgencyLogo route={b.logoRoute} name={b.name} />
                    ) : (
                      <>
                        {b.icon && <img class="min-pill__icon" src={b.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />}
                        {b.name}
                      </>
                    )}
                  </span>
                ))}
              </span>
              <span class="min-link home-practice__open">Open</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- The group teaser -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split" data-reveal>
          <figure class="min-photo">
            <img
              src="/images/photo-workstation.webp"
              alt="A person working at a desk with two monitors in a bright office."
              width="1050"
              height="620"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <span class="min-tag min-tag--blue">The group</span>
            <h2 class="min-h2">AI changed the agency job. We rebuilt the group around it.</h2>
            <p class="min-body min-split__body">
              There is no AI department at BearingBridge, because there is no non-AI department. Every brief
              in the group, a Tmall flagship launch or a LinkedIn program, runs on the same stack we sell,
              and our teams benchmark Western and Chinese models against each other month after month. Work
              is priced on outcomes and volume, not headcount. The judgment stays human. That part we do not
              hand to a machine.
            </p>
            <a class="min-link" href={pathFor('the-group', locale)}>Read about the group</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split min-split--reverse" data-reveal>
          <div>
            <span class="min-tag min-tag--yellow">One operator</span>
            <h2 class="min-h2">One operator. Europe and North Asia.</h2>
            <p class="min-body min-split__body">
              The group is founded and led by Cyril Drouin. Digital, eCommerce, brand: his work has run
              across Europe and North Asia, on both sides of the border this group is named after. Former
              Chief Digital and eCommerce Officer for Publicis North Asia. Founder of BysoftChina.
            </p>
            <a class="min-btn" href={linkedinUrl} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
          </div>
          <a class="min-photo home-portrait" href={linkedinUrl} target="_blank" rel="noreferrer" aria-label="Cyril Drouin on LinkedIn">
            <img
              src="/Team/CyrilDrouin.jpg"
              alt="Cyril Drouin, founder of BearingBridge."
              width="1905"
              height="2560"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </section>

    <!-- Same stack -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap">
        <div class="min-split min-split--reverse" data-reveal>
          <div>
            <span class="min-tag min-tag--green">The stack</span>
            <h2 class="min-h2">Same stack. Three uses.</h2>
            <p class="min-body min-split__body">
              The stack is everything we build in the AI practice: the tools, the agents, the publishing systems.
              The cross-border practice runs it between China and the West, two markets that expose weak work
              quickly. The products then prove it in public, on businesses we own outright, so what we learn in
              one practice moves straight into the other two.
            </p>
          </div>
          <figure class="min-card home-diagram">
            <svg class="stack-diagram" viewBox="0 0 520 390" role="img" aria-label="One stack cycling through three practices: AI Services builds it, Cross-Border Marketing runs it, Products prove it.">
              <defs>
                <marker id="loop-arrow" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto">
                  <path d="M0 0 L7 3.5 L0 7 Z" fill="#787774"></path>
                </marker>
              </defs>

              <circle cx="260" cy="200" r="145" fill="none" stroke="#eaeaea" stroke-width="1.5" stroke-dasharray="2.5 7"></circle>

              <path d="M382.9 123.2 A145 145 0 0 1 389.2 134.2" fill="none" stroke="#787774" stroke-width="1.5" marker-end="url(#loop-arrow)"></path>
              <path d="M270.1 344.7 A145 145 0 0 1 249.9 344.7" fill="none" stroke="#787774" stroke-width="1.5" marker-end="url(#loop-arrow)"></path>
              <path d="M132 131.9 A145 145 0 0 1 138.4 121.1" fill="none" stroke="#787774" stroke-width="1.5" marker-end="url(#loop-arrow)"></path>

              <circle cx="260" cy="200" r="52" fill="#ffffff" stroke="#eaeaea"></circle>
              <text x="260" y="205" text-anchor="middle" class="stack-diagram__hub">The stack</text>

              <g>
                <rect x="184" y="30" width="152" height="50" rx="8" fill="#ffffff" stroke="#eaeaea"></rect>
                <text x="260" y="51" text-anchor="middle" class="stack-diagram__name">AI Services</text>
                <text x="260" y="68" text-anchor="middle" class="stack-diagram__verb">builds it</text>
              </g>
              <g>
                <rect x="309.6" y="247.5" width="152" height="50" rx="8" fill="#ffffff" stroke="#eaeaea"></rect>
                <text x="385.6" y="268.5" text-anchor="middle" class="stack-diagram__name">Cross-Border</text>
                <text x="385.6" y="285.5" text-anchor="middle" class="stack-diagram__verb">runs it</text>
              </g>
              <g>
                <rect x="58.4" y="247.5" width="152" height="50" rx="8" fill="#ffffff" stroke="#eaeaea"></rect>
                <text x="134.4" y="268.5" text-anchor="middle" class="stack-diagram__name">Products</text>
                <text x="134.4" y="285.5" text-anchor="middle" class="stack-diagram__verb">proves it</text>
              </g>
            </svg>
          </figure>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="min-sec min-sec--ruled">
      <div class="min-wrap min-narrow min-center" data-reveal>
        <h2 class="min-h2 home-cta__title">Tell us what you are building.</h2>
        <p class="min-body home-cta__body">
          Thirty minutes on a call, no deck. We will tell you which practice, and which team inside it, is
          the right place to start, or whether you should start with more than one.
        </p>
        <a class="min-btn" href={pathFor('contact', locale)}>Book a call</a>
        <p class="min-muted home-cta__meta">
          Shanghai. Hong Kong. Singapore. Paris. Hangzhou. Reps in the US, UK, Germany, France.
          Working in English, French, Spanish, German, and Chinese.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .home-hero__ctas { justify-content: center; margin-bottom: var(--space-6); }
  .home-logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 150px);
    justify-content: center;
    gap: 8px;
  }
  .home-logos li { display: contents; }
  @media (max-width: 900px) {
    .home-logos { grid-template-columns: repeat(3, minmax(110px, 150px)); }
  }
  @media (max-width: 600px) {
    .home-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
  }

  .home-practice__title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.45rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .home-practice__brands {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .home-practice__open { margin-top: auto; align-self: flex-start; }

  .home-portrait { max-width: 300px; margin-inline: auto; }
  .home-portrait img { aspect-ratio: 4 / 5; object-position: center top; }

  .home-diagram {
    margin: 0;
    max-width: 460px;
    margin-inline: auto;
    padding: var(--space-4);
    width: 100%;
  }
  .stack-diagram { display: block; width: 100%; height: auto; }
  .stack-diagram text { font-family: var(--font-sans); }
  .stack-diagram__hub { font-size: 15px; font-weight: 600; fill: var(--ink); letter-spacing: -0.01em; }
  .stack-diagram__name { font-size: 13px; font-weight: 600; fill: var(--ink); }
  .stack-diagram__verb { font-size: 11px; fill: var(--muted); }

  .home-cta__title { margin-inline: auto; }
  .home-cta__body { margin: 0 auto var(--space-5); }
  .home-cta__meta { margin: var(--space-5) auto 0; max-width: 52ch; }
</style>
