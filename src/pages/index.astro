---
import Layout from '../layouts/Layout.astro';
import AgencyLogo from '../components/AgencyLogo.astro';
import { pathFor } from '../i18n/ui';

const locale = 'en' as const;
const title = 'One group, three practices';
const description = 'AI services, cross-border marketing between China and the West, and AI-powered media and software we own and operate. One group, three practices.';

const linkedinUrl = 'https://www.linkedin.com/in/cyril-d-68835729/';

type Brand = { name: string; logoRoute?: string; icon?: string };

const practices: { key: string; label: string; line: string; brands: Brand[]; href: string; img: string }[] = [
  {
    key: 'ai',
    label: 'AI Services',
    line: 'Strategy through production, evidence over hype.',
    brands: [
      { name: 'BearingBridge AI', logoRoute: 'agencies/bearingbridgeai' },
      { name: 'Intelligence', icon: '/AgencyLogos/intelligence-icon.png' },
      { name: 'HubStudio', logoRoute: 'agencies/hubstudio' },
      { name: 'Nuvora Studio', logoRoute: 'agencies/nuvora-studio' },
    ],
    href: pathFor('ai-services', locale),
    img: '/images/practice-ai.webp',
  },
  {
    key: 'cb',
    label: 'Cross-Border Marketing',
    line: 'Brands carried between China and the West, both ways.',
    brands: [
      { name: 'TheChinaPath', logoRoute: 'agencies/bearingbridge' },
      { name: 'BeyondBridge', logoRoute: 'agencies/beyondbridge' },
      { name: 'ChinaWebFoundry', logoRoute: 'agencies/chinawebfoundry' },
      { name: 'TheRedScroll', logoRoute: 'agencies/theredscroll' },
      { name: 'Compass', logoRoute: 'agencies/compass' },
    ],
    href: pathFor('cross-border-marketing', locale),
    img: '/images/practice-crossborder.webp',
  },
  {
    key: 'products',
    label: 'Products',
    line: 'Media and software we own and run ourselves.',
    brands: [{ name: 'BBChien', logoRoute: 'bbchien' }, { name: 'DeuceLadder' }],
    href: pathFor('products', locale),
    img: '/images/practice-products.webp',
  },
];
---

<Layout locale={locale} route="home" title={title} description={description}>
  <section class="tri-hero">
    <div class="container tri-hero__intro">
      <span class="eyebrow">BearingBridge</span>
      <h1 class="tri-hero__title balance">One group. Three practices.</h1>
      <p class="tri-hero__lead">
        We run three businesses under one roof. AI consulting and production. Cross-border growth between
        China and the West. And a portfolio of products we own and operate.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#practices">Pick your practice</a>
        <a class="btn btn--ghost" href={pathFor('contact', locale)}>Talk to us</a>
      </div>
      <p class="tri-hero__cite">Shanghai. Hong Kong. Singapore. Paris. Hangzhou. Reps in the US, UK, Germany, France.</p>
    </div>

    <div class="tri-hero__panels">
      {practices.map((p, i) => (
        <a class={`tri-panel tri-panel--${p.key}`} href={p.href} style={`--panel-i: ${i}`}>
          <img class="tri-panel__img" src={p.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          <span class="tri-panel__scrim" aria-hidden="true"></span>
          <span class="tri-panel__content">
            <span class="tri-panel__name">{p.label}</span>
            <span class="tri-panel__line">{p.line}</span>
            <span class="tri-panel__brands">
              {p.brands.map((b) => (
                <span class="tri-panel__brand">
                  {b.logoRoute ? (
                    <AgencyLogo route={b.logoRoute} name={b.name} />
                  ) : (
                    <>
                      {b.icon && <img class="tri-panel__brand-icon" src={b.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />}
                      {b.name}
                    </>
                  )}
                </span>
              ))}
            </span>
            <span class="tri-panel__cta">
              Open
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="practices">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">The practices</span>
        <h2 class="balance">Pick the one you need.</h2>
        <p class="lead">
          Each practice stands on its own, and most clients start with just one. Not sure which?
          <a href={pathFor('contact', locale)}>Talk to us</a> and we will point you the right way.
        </p>
      </header>

      <div class="grid-3 practice-cards">
        <a class="card practice-card" href={pathFor('ai-services', locale)}>
          <h3>AI Services</h3>
          <p>
            For companies adopting AI, wherever they sell. We take you from strategy through production.
            We benchmark Western and Chinese models side by side and implement on your data, then turn AI
            into content and pipeline at scale. Intelligence, our platform, lets you watch AI run real
            tasks before you commit.
          </p>
          <span class="practice-card__brands">
            <span class="practice-card__brand"><AgencyLogo route="agencies/bearingbridgeai" name="BearingBridge AI" /></span>
            <span class="practice-card__brand practice-card__brand--text">
              <img class="practice-card__brand-icon" src="/AgencyLogos/intelligence-icon.png" alt="" width="96" height="96" loading="lazy" decoding="async" />
              Intelligence
            </span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/hubstudio" name="HubStudio" /></span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/nuvora-studio" name="Nuvora Studio" /></span>
          </span>
          <span class="btn btn--ghost" style="margin-top: auto;">Open AI Services</span>
        </a>

        <a class="card practice-card" href={pathFor('cross-border-marketing', locale)}>
          <h3>Cross-Border Marketing</h3>
          <p>
            For brands crossing between China and the West, either direction. We carry brands, products,
            and services across: brand, channels, web, partner sourcing, sales. Track record spans beauty,
            automotive, food and beverage, hospitality, and home.
          </p>
          <span class="practice-card__brands">
            <span class="practice-card__brand"><AgencyLogo route="agencies/bearingbridge" name="TheChinaPath" /></span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/beyondbridge" name="BeyondBridge" /></span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/chinawebfoundry" name="ChinaWebFoundry" /></span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/theredscroll" name="TheRedScroll" /></span>
            <span class="practice-card__brand"><AgencyLogo route="agencies/compass" name="Compass" /></span>
          </span>
          <span class="btn btn--ghost" style="margin-top: auto;">Open Cross-Border Marketing</span>
        </a>

        <a class="card practice-card" href={pathFor('products', locale)}>
          <h3>Products</h3>
          <p>
            Proof before promises. Media and software we own and run ourselves, starting with BBChien,
            built on the stack we sell and live in public.
          </p>
          <span class="practice-card__brands">
            <span class="practice-card__brand"><AgencyLogo slug="bbchien" name="BBChien" /></span>
            <span class="practice-card__brand practice-card__brand--text">DeuceLadder</span>
            <span class="practice-card__brand practice-card__brand--text">more in build</span>
          </span>
          <span class="btn btn--ghost" style="margin-top: auto;">Open Products</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="split split--text-first">
        <div>
          <span class="eyebrow eyebrow--on-dark">Who is behind this</span>
          <h2 class="balance">One operator. Europe and North Asia.</h2>
          <p class="lead">
            The group is founded and led by Cyril Drouin. Digital, eCommerce, brand: his work has run
            across Europe and North Asia, on both sides of the border this group is named after. Former
            Chief Digital and eCommerce Officer for Publicis North Asia. Founder of BysoftChina.
          </p>
          <a class="btn btn--ghost-light" href={linkedinUrl} target="_blank" rel="noreferrer">Connect on LinkedIn</a>
        </div>
        <div>
          <a class="founder-portrait" href={linkedinUrl} target="_blank" rel="noreferrer" aria-label="Cyril Drouin on LinkedIn">
            <img
              src="/Team/CyrilDrouin.jpg"
              alt="Cyril Drouin, founder of BearingBridge."
              width="1905"
              height="2560"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <span class="eyebrow">The logic</span>
      <p class="transition-line">Three businesses, one reason they sit together.</p>
      <h2 class="balance">Same stack. Three uses.</h2>
      <p class="lead">
        The stack is everything we build in the AI practice: the tools, the agents, the publishing systems.
        The cross-border practice runs it between China and the West, two markets that expose weak work
        quickly. The products then prove it in public, on businesses we own outright, so what we learn in
        one practice moves straight into the other two.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--narrow center">
      <h2 class="balance">Tell us what you are building.</h2>
      <p class="lead" style="margin-inline: auto;">
        Thirty minutes on a call, no deck. We will tell you which practice, and which team inside it, is
        the right place to start, or whether you should start with more than one.
      </p>
      <div class="btn-row" style="justify-content: center; margin-top: var(--space-5);">
        <a class="btn btn--primary" href={pathFor('contact', locale)}>Book a call</a>
      </div>
      <p class="home-cta__meta">
        Shanghai. Hong Kong. Singapore. Paris. Hangzhou. Reps in the US, UK, Germany, France.
        Working in English, French, Spanish, German, and Chinese.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Tri-panel hero ---------- */
  .tri-hero {
    background: var(--bbg-ink, #0f172a);
    color: #fff;
    padding-top: calc(var(--space-8, 6rem) + 40px);
    padding-bottom: 0;
  }
  .tri-hero__intro {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
  }
  .tri-hero__intro .eyebrow {
    color: rgba(255, 255, 255, 0.65);
  }
  .tri-hero__title {
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 1.05;
    margin: 0;
  }
  .tri-hero__lead {
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }
  .tri-hero__cite {
    font-size: var(--fs-small, 0.875rem);
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.02em;
    margin: 0;
  }
  .tri-hero__panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .tri-panel {
    position: relative;
    display: block;
    min-height: 380px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
  }
  .tri-panel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease, ease);
  }
  .tri-panel:hover .tri-panel__img { transform: scale(1.04); }
  .tri-panel__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 15, 30, 0.25) 0%, rgba(10, 15, 30, 0.82) 100%);
    transition: background 0.4s var(--ease, ease);
  }
  .tri-panel:hover .tri-panel__scrim {
    background: linear-gradient(180deg, rgba(10, 15, 30, 0.15) 0%, rgba(10, 15, 30, 0.88) 100%);
  }
  .tri-panel__content {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-5, 2rem);
  }
  .tri-panel__name {
    font-family: var(--font-display, inherit);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .tri-panel__line {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.45;
  }
  .tri-panel__brands {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .tri-panel__brand {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #1a2438;
  }
  .tri-panel__brand :global(.agency-logo) {
    height: 14px;
    width: auto;
    max-width: 110px;
  }
  .tri-panel__brand-icon {
    width: 13px;
    height: 13px;
    margin-right: 5px;
  }
  .practice-card__brand-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
  }
  .tri-panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-2, 0.5rem);
    font-size: var(--fs-small, 0.875rem);
    font-weight: 600;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.25s var(--ease, ease), gap 0.25s var(--ease, ease);
  }
  .tri-panel:hover .tri-panel__cta { opacity: 1; gap: 10px; }

  @media (max-width: 900px) {
    .tri-hero__panels { grid-template-columns: 1fr; }
    .tri-panel { min-height: 240px; }
  }

  /* ---------- Practice cards ---------- */
  .practice-card h3 {
    margin-bottom: var(--space-2);
  }
  .practice-card__brands {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-3) 0;
  }
  .practice-card__brand {
    display: inline-flex;
    align-items: center;
  }
  .practice-card__brand :global(.agency-logo) {
    height: 20px;
    width: auto;
    max-width: 130px;
  }
  .practice-card__brand--text {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
  }

  .transition-line {
    margin-bottom: var(--space-3);
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
  }

  .home-cta__meta {
    margin-top: var(--space-5);
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
  }
</style>
