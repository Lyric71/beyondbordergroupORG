---
import Layout from '../../layouts/Layout.astro';
import AgencyLogo from '../../components/AgencyLogo.astro';
import { pathFor } from '../../i18n/ui';

const locale = 'fr' as const;
const title = 'Les deux flux';
const description = "Un pont, deux directions. Toute la chaîne pour aborder la Chine ou y changer d'échelle, et le pipeline complet qui mène les marques chinoises vers l'Occident.";

const inboundReq = [
  {
    icon: 'badge',
    h: 'Une marque qui affiche sa qualité à un public chinois',
    body: "Les gages de confiance passent au premier plan : certifications, logos de partenaires, caution de tiers. Ce qu'un œil occidental trouve surchargé, le marché chinois y voit un signe de sérieux.",
    pill: 'La densité fait la qualité',
  },
  {
    icon: 'channels',
    h: 'Les canaux qu\'utilisent réellement les consommateurs chinois',
    body: "WeChat installe la confiance, RedNote alimente la présélection, Douyin déclenche la découverte, Weibo donne la portée. À chacun son format, à chacun son équipe.",
    pill: 'Quatre dispositifs, pas un',
  },
  {
    icon: 'server',
    h: 'Une infrastructure web conçue derrière le Firewall',
    body: "Hébergement sous licence ICP chez Aliyun, Tencent ou Huawei. Un site que Baidu sait indexer. Le mobile d'abord, par nécessité et non par effet de mode.",
    pill: 'Plus de 95 % de trafic mobile',
  },
  {
    icon: 'search',
    h: 'Une visibilité sur les moteurs qu\'interrogent les acheteurs chinois',
    body: "Baidu garde plus de la moitié du marché. Google tombe sous les trois pour cent. Et les moins de 35 ans désertent la recherche classique pour les IA : DeepSeek, Doubao, Kimi, Yuanbao.",
    pill: 'Baidu > 50 % · Google < 3 %',
  },
  {
    icon: 'cart',
    h: "Le commerce là où l'achat se conclut vraiment",
    body: "Tmall, JD, Douyin Shop, RED, sans oublier le commerce social sur WeChat. Ici, vente en ligne et réseaux sociaux ne font qu'une seule surface, pas deux parcours séparés.",
    pill: 'Le social, c\'est le commerce',
  },
];

const inboundAgencies = [
  {
    name: 'TheChinaPath',
    role: "L'opérateur intégré",
    body: "Vingt ans sur le terrain. Image de marque, e-commerce, distribution. Une seule équipe aux commandes.",
    route: 'agencies/bearingbridge' as const,
  },
  {
    name: 'TheRedScroll',
    role: 'Le spécialiste des réseaux sociaux',
    body: "WeChat, Douyin, RedNote, Weibo et quatorze autres plateformes. Périmètre fixe, tarif fixe, mise en route en deux semaines.",
    route: 'agencies/theredscroll' as const,
  },
  {
    name: 'ChinaWebFoundry',
    role: "Le spécialiste de l'infrastructure web",
    body: "Hébergement sous licence ICP, référencement Baidu, ergonomie pensée pour le mobile, optimisation pour les moteurs IA chinois.",
    route: 'agencies/chinawebfoundry' as const,
  },
  {
    name: 'Compass',
    role: 'Le vivier de distributeurs et de TP',
    body: "Un vivier privé de distributeurs, de partenaires Tmall (TP) et de Douyin Partners, tous qualifiés.",
    route: 'agencies/compass' as const,
  },
  {
    name: 'HubStudio',
    role: 'Le moteur de production de contenu Chine',
    body: "Une production taillée pour les audiences chinoises, au rythme qu'imposent RedNote, Douyin et WeChat.",
    route: 'agencies/hubstudio' as const,
  },
];

const outboundReq = [
  {
    icon: 'badge',
    h: "Une marque que les acheteurs occidentaux reconnaissent",
    body: "Pas une marque traduite du chinois. Des noms qui passent, des promesses qui sonnent juste, une identité visuelle qui tient aussi bien à Francfort qu'à Chicago, sans astérisque.",
    pill: 'Conçue, pas traduite',
  },
  {
    icon: 'channels',
    h: 'Une présence sur LinkedIn',
    body: "En Occident, l'acheteur B2B passe par LinkedIn avant même le premier appel. Profil vide, appel annulé. La confiance va aux entreprises dont les dirigeants prennent la parole.",
    pill: '82 % font confiance aux dirigeants qui publient',
  },
  {
    icon: 'monitor',
    h: "Un site pensé pour l'œil occidental",
    body: "Épuré, aéré, une seule action par page. Hébergé hors de Chine. Et rapide : trois secondes de chargement, et vous perdez plus d'un visiteur sur deux.",
    pill: '3 s = -50 % de visiteurs',
  },
  {
    icon: 'search',
    h: 'Une visibilité sur les moteurs occidentaux',
    body: "Un bon classement sur Google, et des citations dans ChatGPT, Perplexity et Gemini. Vos concurrents tiennent déjà ces réponses.",
    pill: 'Google + ChatGPT + IA',
  },
  {
    icon: 'megaphone',
    h: 'Des annonces en première page',
    body: "Google Ads pour occuper la première page le temps que le référencement naturel s'installe. Des pages d'atterrissage pensées pour l'Occident, jamais traduites. Les bons mots-clés, le bon pays.",
    pill: 'Première page, dès le premier jour',
  },
  {
    icon: 'globe',
    h: 'Des commerciaux dans le bon fuseau horaire',
    body: "Un acheteur allemand écrit à 10 h, heure de Berlin. À Shenzhen, il fait nuit. Le temps que le bureau rouvre, trois concurrents ont déjà répondu.",
    pill: 'La première réponse l\'emporte',
  },
];

---

<Layout locale={locale} route="two-flows" title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero__bg" aria-hidden="true">
      <svg viewBox="0 0 1600 760" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="page-cable" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0%" stop-color="#269ada" stop-opacity="0.95" />
            <stop offset="50%" stop-color="#f4f1e6" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0.95" />
          </linearGradient>
          <radialGradient id="page-glow-w" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#269ada" stop-opacity="0.30" />
            <stop offset="100%" stop-color="#269ada" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="page-glow-e" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c8102e" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0" />
          </radialGradient>
        </defs>

        <ellipse cx="280" cy="500" rx="560" ry="220" fill="url(#page-glow-w)" />
        <ellipse cx="1320" cy="500" rx="560" ry="220" fill="url(#page-glow-e)" />

        <line x1="0" y1="500" x2="1600" y2="500" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
        <line x1="0" y1="518" x2="1600" y2="518" stroke="rgba(255,255,255,0.04)" stroke-width="1" />
        <line x1="0" y1="538" x2="1600" y2="538" stroke="rgba(255,255,255,0.025)" stroke-width="1" />

        <path class="page-hero__cable" d="M 220 500 Q 800 110 1380 500" fill="none" stroke="url(#page-cable)" stroke-width="2" stroke-linecap="round" />

        <g stroke="rgba(255,255,255,0.18)" stroke-width="1">
          <line x1="320" y1="500" x2="320" y2="396" />
          <line x1="440" y1="500" x2="440" y2="320" />
          <line x1="560" y1="500" x2="560" y2="262" />
          <line x1="680" y1="500" x2="680" y2="222" />
          <line x1="800" y1="500" x2="800" y2="208" />
          <line x1="920" y1="500" x2="920" y2="222" />
          <line x1="1040" y1="500" x2="1040" y2="262" />
          <line x1="1160" y1="500" x2="1160" y2="320" />
          <line x1="1280" y1="500" x2="1280" y2="396" />
        </g>

        <g>
          <line x1="220" y1="240" x2="220" y2="500" stroke="rgba(38,154,218,0.55)" stroke-width="2" />
          <line x1="1380" y1="240" x2="1380" y2="500" stroke="rgba(200,16,46,0.55)" stroke-width="2" />
          <circle class="page-hero__dot page-hero__dot--w" cx="220" cy="500" r="5" fill="#269ada" />
          <circle class="page-hero__dot page-hero__dot--e" cx="1380" cy="500" r="5" fill="#c8102e" />
        </g>

        <text x="220" y="555" text-anchor="middle" fill="rgba(38,154,218,0.85)" font-family="Inter, sans-serif" font-size="12" letter-spacing="3">OCCIDENT</text>
        <text x="1380" y="555" text-anchor="middle" fill="rgba(200,16,46,0.85)" font-family="Inter, sans-serif" font-size="12" letter-spacing="3">CHINE</text>
      </svg>
    </div>
    <div class="page-hero__scrim" aria-hidden="true"></div>
    <div class="container page-hero__content">
      <span class="eyebrow eyebrow--on-dark eyebrow--rule">Deux directions</span>
      <h1 class="page-hero__title balance">
        Un seul pont. <span class="page-hero__accent">Deux flux.</span>
      </h1>
      <p class="page-hero__lead">
        Quel que soit le sens de la traversée, nous avons déjà fait le travail sur les deux rives. Choisissez celle d'où vous partez.
      </p>
      <div class="page-hero__jumps">
        <a class="page-hero__jump" href="#inbound">
          <span class="page-hero__jump-name">Entrant</span>
          <span class="page-hero__jump-meta">Occident vers Chine</span>
        </a>
        <a class="page-hero__jump page-hero__jump--alt" href="#outbound">
          <span class="page-hero__jump-name">Sortant</span>
          <span class="page-hero__jump-meta">Chine vers Occident</span>
        </a>
      </div>
    </div>
  </section>

  <section id="inbound" class="entry-hero entry-hero--inbound">
    <div class="entry-hero__bg" aria-hidden="true">
      <svg viewBox="0 0 1600 720" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
        <defs>
          <radialGradient id="entry-glow-w" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#269ada" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#269ada" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="entry-glow-e" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c8102e" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0" />
          </radialGradient>
          <pattern id="entry-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1.5" fill="rgba(255,255,255,0.10)" />
          </pattern>
          <linearGradient id="entry-stream" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0%" stop-color="#269ada" stop-opacity="0" />
            <stop offset="50%" stop-color="#269ada" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0" />
          </linearGradient>
        </defs>

        <ellipse cx="220" cy="380" rx="540" ry="240" fill="url(#entry-glow-w)" />
        <ellipse cx="1380" cy="380" rx="540" ry="240" fill="url(#entry-glow-e)" />

        <rect x="0" y="0" width="1600" height="720" fill="url(#entry-grid)" />

        <g class="entry-hero__nodes" stroke="rgba(255,255,255,0.18)" fill="none" stroke-width="1">
          <circle cx="900" cy="180" r="3" fill="rgba(38,154,218,0.9)" stroke="none" />
          <circle cx="1080" cy="260" r="3" fill="rgba(255,255,255,0.6)" stroke="none" />
          <circle cx="1240" cy="200" r="3" fill="rgba(200,16,46,0.9)" stroke="none" />
          <circle cx="1140" cy="380" r="3" fill="rgba(255,255,255,0.6)" stroke="none" />
          <circle cx="980" cy="340" r="3" fill="rgba(38,154,218,0.7)" stroke="none" />
          <circle cx="1320" cy="320" r="3" fill="rgba(255,255,255,0.5)" stroke="none" />
          <line x1="900" y1="180" x2="1080" y2="260" />
          <line x1="1080" y1="260" x2="1240" y2="200" />
          <line x1="1080" y1="260" x2="1140" y2="380" />
          <line x1="980" y1="340" x2="1140" y2="380" />
          <line x1="1140" y1="380" x2="1320" y2="320" />
        </g>

        <path class="entry-hero__stream" d="M 80 420 Q 800 280 1520 420" fill="none" stroke="url(#entry-stream)" stroke-width="2" stroke-linecap="round" />
      </svg>
    </div>
    <div class="entry-hero__scrim" aria-hidden="true"></div>
    <div class="container entry-hero__content">
      <span class="eyebrow eyebrow--on-dark eyebrow--rule">Flux 1 · Entrant · Occident vers Chine</span>
      <h2 class="entry-hero__title balance">
        Vous avez une marque. La Chine compte 1,1 milliard d'internautes. Combler la distance n'est pas affaire de traduction.
      </h2>
      <p class="entry-hero__lead">
        L'internet chinois roule sur ses propres rails : d'autres plateformes, d'autres moteurs de recherche, une autre infrastructure, une autre densité de contenu, d'autres signaux d'achat. Nous y travaillons depuis vingt ans.
      </p>
      <div class="entry-hero__chips">
        <span class="entry-hero__chip">WeChat</span>
        <span class="entry-hero__chip">RedNote</span>
        <span class="entry-hero__chip">Douyin</span>
        <span class="entry-hero__chip">Weibo</span>
        <span class="entry-hero__chip">Tmall</span>
        <span class="entry-hero__chip">JD</span>
        <span class="entry-hero__chip">Baidu</span>
        <span class="entry-hero__chip">DeepSeek</span>
      </div>
    </div>
  </section>

  <section class="section req-section">
    <div class="req-section__bg" aria-hidden="true">
      <span class="req-section__blob req-section__blob--w"></span>
      <span class="req-section__blob req-section__blob--e"></span>
    </div>
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Ce qu'il faut vraiment réunir</span>
        <h2 class="balance">Cinq surfaces. Un seul internet chinois.</h2>
        <p class="lead">Aborder la Chine, c'est mener cinq métiers de front. Chacun a sa logique, son tempo, et sa sanction dès qu'on se trompe.</p>
      </header>

      <ol class="req-grid" role="list">
        {inboundReq.map((r, i) => (
          <li class="req-card" style={`--i: ${i};`}>
            <div class="req-card__inner">
              <span class="req-card__icon" aria-hidden="true">
                {r.icon === 'badge' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 4l3 5 6 1-4 4 1 6-6-3-6 3 1-6-4-4 6-1 3-5z" />
                  </svg>
                )}
                {r.icon === 'channels' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="6" width="10" height="10" rx="2" />
                    <rect x="18" y="6" width="10" height="10" rx="2" />
                    <rect x="4" y="18" width="10" height="10" rx="2" />
                    <rect x="18" y="18" width="10" height="10" rx="2" />
                  </svg>
                )}
                {r.icon === 'server' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="6" width="22" height="8" rx="2" />
                    <rect x="5" y="18" width="22" height="8" rx="2" />
                    <circle cx="9" cy="10" r="0.8" fill="currentColor" />
                    <circle cx="9" cy="22" r="0.8" fill="currentColor" />
                    <line x1="13" y1="10" x2="22" y2="10" />
                    <line x1="13" y1="22" x2="22" y2="22" />
                  </svg>
                )}
                {r.icon === 'search' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="14" cy="14" r="8" />
                    <line x1="20" y1="20" x2="27" y2="27" />
                    <path d="M10 14 L13 17 L18 12" />
                  </svg>
                )}
                {r.icon === 'cart' && (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 7h3l3 14h12l3-10H10" />
                    <circle cx="13" cy="26" r="1.6" />
                    <circle cx="23" cy="26" r="1.6" />
                  </svg>
                )}
              </span>
              <h3 class="req-card__title">{r.h}</h3>
              <p class="req-card__body">{r.body}</p>
              <span class="req-card__pill">{r.pill}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt agency-section">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Cinq spécialistes. Un seul flux.</span>
        <h2 class="balance">Prenez toute la chaîne, ou seulement le maillon.</h2>
        <p class="lead">Cinq équipes indépendantes couvrent le flux entrant de bout en bout. Une, deux ou les cinq, à votre main. Elles partagent la même colonne vertébrale.</p>
      </header>
      <div class="agency-rail" data-stagger>
        {inboundAgencies.map((a, i) => (
          <a class="agency-tile" href={pathFor(a.route, locale)} style={`--i: ${i};`}>
            <span class="agency-tile__logo">
              <AgencyLogo route={a.route} name={a.name} class="agency-card-logo" />
            </span>
            <span class="agency-tile__role">{a.role}</span>
            <h3 class="agency-tile__name">{a.name}</h3>
            <p class="agency-tile__body">{a.body}</p>
            <span class="agency-tile__cta">Visiter
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section openings-section">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Par où commencent nos clients</span>
        <h2 class="balance">Six points d'entrée habituels.</h2>
        <p class="lead">La plupart des projets tiennent d'abord en une phrase. Choisissez celle qui ressemble le plus à la vôtre.</p>
      </header>
      <div class="openings" data-stagger>
        <a class="opening" href={pathFor('agencies/chinawebfoundry', locale)} style="--i: 0;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">J'ai simplement besoin d'un site chinois qui fonctionne vraiment.</p>
          <div class="opening__answer">
            <span class="opening__by">ChinaWebFoundry</span>
            <span class="opening__line">Migration en six semaines, licence ICP déposée, site indexable par Baidu.</span>
          </div>
        </a>
        <a class="opening" href={pathFor('agencies/theredscroll', locale)} style="--i: 1;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">Nous devons être présents sur RedNote et Douyin sous quatre-vingt-dix jours.</p>
          <div class="opening__answer">
            <span class="opening__by">TheRedScroll</span>
            <span class="opening__line">Mise en route en deux semaines, premiers contenus en ligne sous quinze jours.</span>
          </div>
        </a>
        <a class="opening" href={pathFor('agencies/bearingbridge', locale)} style="--i: 2;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">Il nous faut tout : la marque, les canaux, l'e-commerce, les KOL.</p>
          <div class="opening__answer">
            <span class="opening__by">TheChinaPath</span>
            <span class="opening__line">Une entrée intégrée, adossée à vingt ans de pratique.</span>
          </div>
        </a>
        <a class="opening" href={pathFor('agencies/compass', locale)} style="--i: 3;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">Nous cherchons un distributeur en Chine, et vite.</p>
          <div class="opening__answer">
            <span class="opening__by">Compass</span>
            <span class="opening__line">Une présélection qualifiée de distributeurs et de partenaires Tmall en quelques jours, pas en quelques mois.</span>
          </div>
        </a>
        <a class="opening" href={pathFor('agencies/hubstudio', locale)} style="--i: 4;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">Notre contenu ne parle pas au public chinois.</p>
          <div class="opening__answer">
            <span class="opening__by">HubStudio</span>
            <span class="opening__line">Un contenu repensé pour les lecteurs chinois, au rythme qu'imposent les canaux.</span>
          </div>
        </a>
        <a class="opening opening--cta" href={pathFor('contact', locale)} style="--i: 5;">
          <span class="opening__quote-mark" aria-hidden="true">&#8220;</span>
          <p class="opening__quote">Je ne sais pas par où commencer.</p>
          <div class="opening__answer">
            <span class="opening__by">Prendre rendez-vous</span>
            <span class="opening__line">Trente minutes. Nous vous disons quelle agence engager et à quoi ressemblent les premiers quatre-vingt-dix jours.</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="outbound" class="entry-hero entry-hero--outbound">
    <div class="entry-hero__bg" aria-hidden="true">
      <svg viewBox="0 0 1600 720" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
        <defs>
          <radialGradient id="out-glow-e" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c8102e" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="out-glow-w" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#269ada" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#269ada" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="out-stream" x1="1" x2="0" y1="0" y2="0">
            <stop offset="0%" stop-color="#c8102e" stop-opacity="0" />
            <stop offset="50%" stop-color="#f4f1e6" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#269ada" stop-opacity="0" />
          </linearGradient>
        </defs>

        <ellipse cx="1380" cy="380" rx="540" ry="240" fill="url(#out-glow-e)" />
        <ellipse cx="220" cy="380" rx="540" ry="240" fill="url(#out-glow-w)" />

        <g class="entry-hero__lines" stroke="rgba(255,255,255,0.06)" stroke-width="1">
          <line x1="0" y1="180" x2="1600" y2="180" />
          <line x1="0" y1="260" x2="1600" y2="260" />
