---
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import '../styles/minimal.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoSchema from '../components/SeoSchema.astro';
import { type Locale, type Route, t, htmlLang, pathFor } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description?: string;
}

const { locale, route, title, description } = Astro.props;
const ui = t(locale);
const fullTitle = `${title} | ${ui.meta.siteName}`;
const siteOrigin = Astro.site ?? new URL('https://www.bearingbridge.com');
const canonical = new URL(pathFor(route, locale), siteOrigin).toString();
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <SeoSchema locale={locale} route={route} title={title} site={Astro.site} />
  </head>
  <body>
    <a href="#main" class="skip-link">{ui.meta.skipToContent}</a>
    <SiteHeader locale={locale} current={route} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} current={route} />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
