---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoSchema from '../components/SeoSchema.astro';
import { type Locale, type Route, t, htmlLang, pathFor } from '../i18n/ui';

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description?: string;
}

const { locale, route, title, description } = Astro.props;
const ui = t(locale);
const fullTitle = `${title} | ${ui.meta.siteName}`;
const siteOrigin = Astro.site ?? new URL('https://www.bearingbridge.com');
const abs = (loc: Locale) => new URL(pathFor(route, loc), siteOrigin).toString();
const canonical = abs(locale);
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="fr" href={abs('fr')} />
    <link rel="alternate" hreflang="zh-CN" href={abs('zh')} />
    <link rel="alternate" hreflang="es" href={abs('es')} />
    <link rel="alternate" hreflang="de" href={abs('de')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <title>{fullTitle}</title>
    <SeoSchema locale={locale} route={route} title={title} site={Astro.site} />
  </head>
  <body>
    <a href="#main" class="skip-link">{ui.meta.skipToContent}</a>
    <SiteHeader locale={locale} current={route} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} current={route} />
  </body>
</html>
