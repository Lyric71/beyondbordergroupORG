---
import Layout from '../layouts/Layout.astro';
import { pathFor, type Locale } from '../i18n/ui';

interface ThanksCopy {
  title: string;
  description: string;
  heading: string;
  lead: string;
  sub: string;
  primaryCta: string;
  secondaryCta: string;
}

interface Props {
  locale: Locale;
  copy: ThanksCopy;
}

const { locale, copy } = Astro.props;
---

<Layout locale={locale} route="contact" title={copy.title} description={copy.description}>
  <div class="min">
    <section class="min-hero thanks-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap min-narrow min-center">
        <span class="thanks-badge" aria-hidden="true" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7" />
          </svg>
        </span>
        <h1 class="min-hero__title" data-reveal style="--i: 1">{copy.heading}</h1>
        <p class="min-hero__lead" data-reveal style="--i: 2">{copy.lead}</p>
        <p class="min-muted thanks-sub" data-reveal style="--i: 3">{copy.sub}</p>
        <div class="min-ctas thanks-actions" data-reveal style="--i: 4">
          <a class="min-btn" href={pathFor('home', locale)}>{copy.primaryCta}</a>
          <a class="min-btn min-btn--ghost" href={pathFor('agencies', locale)}>{copy.secondaryCta}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .thanks-hero {
    padding: clamp(6rem, 16vh, 9rem) 0 clamp(5rem, 12vh, 7.5rem);
  }
  .thanks-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #edf3ec;
    color: #346538;
    border: 1px solid #d5e2d3;
    margin-bottom: var(--space-5);
  }
  .thanks-badge svg { width: 28px; height: 28px; }
  .thanks-sub { margin-top: var(--space-3); }
  .thanks-actions {
    margin-top: var(--space-5);
    justify-content: center;
  }
</style>
