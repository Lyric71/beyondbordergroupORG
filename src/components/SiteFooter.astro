---
import { type Locale, pathFor, t } from '../i18n/ui';

interface Props {
  locale: Locale;
  current?: string;
}

const { locale } = Astro.props;
const ui = t(locale);

const aiServices = [
  { href: pathFor('agencies/bearingbridgeai', locale), label: 'BearingBridge AI' },
  { href: pathFor('ai-services/intelligence', locale), label: 'Intelligence' },
  { href: pathFor('agencies/hubstudio', locale), label: 'HubStudio' },
  { href: pathFor('agencies/nuvora-studio', locale), label: 'Nuvora Studio' },
];

const crossBorder = [
  { href: pathFor('agencies/bearingbridge', locale), label: 'TheChinaPath' },
  { href: pathFor('agencies/beyondbridge', locale), label: 'BeyondBridge' },
  { href: pathFor('agencies/chinawebfoundry', locale), label: 'ChinaWebFoundry' },
  { href: pathFor('agencies/theredscroll', locale), label: 'TheRedScroll' },
  { href: pathFor('agencies/compass', locale), label: 'Compass' },
  { href: pathFor('two-flows', locale), label: 'Two flows' },
  { href: pathFor('bridge', locale), label: 'The bridge' },
];

const products = [
  { href: `${pathFor('products', locale)}#bbchien`, label: 'BBChien' },
  { href: `${pathFor('products', locale)}#deuceladder`, label: 'DeuceLadder' },
];

const group = [
  { href: pathFor('the-group', locale), label: 'About us' },
  { href: pathFor('how-we-work', locale), label: 'How we work' },
  { href: pathFor('contact', locale), label: ui.nav.contact },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__brand-line">BearingBridge</p>
        <p>One group. Three practices.</p>
        <div class="site-footer__practices">
          <a href={pathFor('ai-services', locale)}>AI Services</a>
          <a href={pathFor('cross-border-marketing', locale)}>Cross-Border Marketing</a>
          <a href={pathFor('products', locale)}>Products</a>
        </div>
      </div>
      <div>
        <h4><a class="site-footer__col-link" href={pathFor('ai-services', locale)}>AI Services</a></h4>
        <ul class="site-footer__links">
          {aiServices.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4><a class="site-footer__col-link" href={pathFor('cross-border-marketing', locale)}>Cross-Border Marketing</a></h4>
        <ul class="site-footer__links">
          {crossBorder.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4><a class="site-footer__col-link" href={pathFor('products', locale)}>Products</a></h4>
        <ul class="site-footer__links">
          {products.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
        <h4 class="site-footer__group-head">The group</h4>
        <ul class="site-footer__links">
          {group.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>{ui.footer.offices}</span>
      <span>
        <a href={pathFor('privacy', 'en')}>{ui.footer.privacy}</a>
        <a href={pathFor('terms', 'en')}>{ui.footer.terms}</a>
        <a href={pathFor('cookies', 'en')}>{ui.footer.cookies}</a>
        {ui.footer.rights}
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer__practices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }
  .site-footer__practices a {
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    opacity: 0.85;
  }
  .site-footer__practices a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }

  .site-footer__col-link {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__col-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .site-footer__group-head { margin-top: var(--space-4); }
</style>
