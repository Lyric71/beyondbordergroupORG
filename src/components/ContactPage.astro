---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../i18n/ui';

interface ContactCopy {
  title: string;
  description: string;
  heroTitle: string;
  heroLead: string;
  emailTitle: string;
  emailNote: string;
  officesTitle: string;
  officeHQ: string;
  officeHK: string;
  officeParis: string;
  officesNote: string;
  directTitle: string;
  formHeading: string;
  labelName: string;
  labelEmail: string;
  labelPhone: string;
  labelWebsite: string;
  labelCompany: string;
  labelBrief: string;
  briefPlaceholder: string;
  captchaLabel: string;
  captchaPrompt: string;
  submit: string;
  sending: string;
  formHint: string;
  errMissing: string;
  errCaptchaClient: string;
  statusSending: string;
  errNetwork: string;
  errGeneric: string;
}

interface Props {
  locale: Locale;
  copy: ContactCopy;
}

const { locale, copy } = Astro.props;

const a = Math.floor(Math.random() * 8) + 2;
const b = Math.floor(Math.random() * 8) + 2;
const captchaQuestion = `${a} + ${b}`;
---

<Layout locale={locale} route="contact" title={copy.title} description={copy.description}>
  <div class="min">
    <!-- Hero -->
    <section class="min-hero">
      <div class="min-glow" aria-hidden="true"></div>
      <div class="min-wrap">
        <h1 class="min-hero__title" data-reveal>{copy.heroTitle}</h1>
        <p class="min-hero__lead" data-reveal style="--i: 1">{copy.heroLead}</p>
      </div>
    </section>

    <!-- Form + info -->
    <section class="min-sec">
      <div class="min-wrap">
        <div class="contact-grid">
          <div class="min-card contact-card" data-reveal>
            <h2 class="min-h3 contact-form-heading">{copy.formHeading}</h2>

            <form
              id="contact-form"
              class="contact-form"
              method="post"
              action="/api/contact"
              novalidate
              data-locale={locale}
              data-err-missing={copy.errMissing}
              data-status-sending={copy.statusSending}
              data-err-network={copy.errNetwork}
              data-err-generic={copy.errGeneric}
              data-sending-label={copy.sending}
            >
              <input type="hidden" name="locale" value={locale} />

              <div class="contact-row">
                <div class="min-field">
                  <label for="name">{copy.labelName} <span class="req">*</span></label>
                  <input id="name" name="name" type="text" autocomplete="name" required />
                </div>
                <div class="min-field">
                  <label for="email">{copy.labelEmail} <span class="req">*</span></label>
                  <input id="email" name="email" type="email" autocomplete="email" required />
                </div>
              </div>
              <div class="contact-row">
                <div class="min-field">
                  <label for="phone">{copy.labelPhone}</label>
                  <input id="phone" name="phone" type="tel" autocomplete="tel" />
                </div>
                <div class="min-field">
                  <label for="website">{copy.labelWebsite} <span class="req">*</span></label>
                  <input id="website" name="website" type="url" placeholder="https://" required />
                </div>
              </div>
              <div class="min-field">
                <label for="company">{copy.labelCompany} <span class="req">*</span></label>
                <input id="company" name="company" type="text" autocomplete="organization" required />
              </div>
              <div class="min-field">
                <label for="brief">{copy.labelBrief} <span class="req">*</span></label>
                <textarea id="brief" name="brief" rows="5" placeholder={copy.briefPlaceholder} required></textarea>
              </div>

              <div class="hp-field" aria-hidden="true">
                <label for="hp-website-2">Leave this field empty</label>
                <input id="hp-website-2" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <div class="contact-captcha">
                <span class="min-meta contact-captcha__label">{copy.captchaLabel}</span>
                <div class="contact-captcha__row">
                  <span class="contact-captcha__question" set:html={copy.captchaPrompt.replace('{q}', `<strong>${captchaQuestion}</strong>`)}></span>
                  <input
                    id="captcha-answer"
                    name="captcha_answer"
                    type="text"
                    inputmode="numeric"
                    pattern="-?[0-9]+"
                    autocomplete="off"
                    required
                    aria-label="Captcha"
                    class="min-input contact-captcha__input"
                  />
                  <input type="hidden" name="captcha_question" value={captchaQuestion} />
                </div>
              </div>

              <p id="contact-status" class="contact-status" role="status" aria-live="polite" hidden></p>

              <div class="contact-actions">
                <button id="contact-submit" class="min-btn" type="submit">{copy.submit}</button>
                <p class="min-muted contact-hint">{copy.formHint}</p>
              </div>
            </form>
          </div>

          <aside class="contact-info">
            <figure class="min-photo min-photo--wide" data-reveal>
              <img
                src="/images/photo-contact.webp"
                alt="A bright office corner with a desk and phone."
                width="1050"
                height="620"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="contact-info__block" data-reveal style="--i: 1">
              <h2 class="min-meta contact-info__title">{copy.emailTitle}</h2>
              <p class="min-small"><a href="mailto:hello@bearingbridge.com">hello@bearingbridge.com</a></p>
              <p class="min-muted">{copy.emailNote}</p>
            </div>

            <div class="contact-info__block" data-reveal style="--i: 2">
              <h2 class="min-meta contact-info__title">{copy.officesTitle}</h2>
              <p class="min-small" set:html={copy.officeHQ}></p>
              <p class="min-small" set:html={copy.officeHK}></p>
              <p class="min-small" set:html={copy.officeParis}></p>
              <p class="min-muted">{copy.officesNote}</p>
            </div>

            <div class="contact-info__block" data-reveal style="--i: 3">
              <h2 class="min-meta contact-info__title">{copy.directTitle}</h2>
              <ul class="contact-links">
                <li><a href="https://thechinapath.com/contact" target="_blank" rel="noreferrer">TheChinaPath</a></li>
                <li><a href="https://theredscroll.com/contact" target="_blank" rel="noreferrer">TheRedScroll</a></li>
                <li><a href="https://chinawebfoundry.com/contact" target="_blank" rel="noreferrer">ChinaWebFoundry</a></li>
                <li><a href="https://compass.bearingbridge.com/contact" target="_blank" rel="noreferrer">Compass</a></li>
                <li><a href="https://beyondbridge.ai/contact" target="_blank" rel="noreferrer">BeyondBridge</a></li>
                <li><a href="https://hubstudio.ai/contact" target="_blank" rel="noreferrer">HubStudio</a></li>
                <li><a href="https://nuvora.studio/contact" target="_blank" rel="noreferrer">Nuvora Studio</a></li>
                <li><a href="https://www.bearingbridge.ai/contact" target="_blank" rel="noreferrer">BearingBridge AI</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLParagraphElement | null;
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && status && submit) {
    const locale = form.dataset.locale ?? 'en';
    const msgMissing = form.dataset.errMissing ?? 'Please add your name and email so we can reach you.';
    const msgSending = form.dataset.statusSending ?? 'Sending your message…';
    const msgNetwork = form.dataset.errNetwork ?? 'Network error. Please check your connection and try again.';
    const msgGeneric = form.dataset.errGeneric ?? 'Something went wrong. Please try again.';
    const sendingLabel = form.dataset.sendingLabel ?? 'Sending…';
    const thankYouPath = locale === 'en' ? '/thank-you/' : `/${locale}/thank-you/`;

    const setStatus = (message: string, tone: 'info' | 'success' | 'error') => {
      status.hidden = false;
      status.textContent = message;
      status.dataset.tone = tone;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const payload: Record<string, string> = {};
      for (const [key, value] of data.entries()) {
        if (typeof value === 'string') payload[key] = value;
      }

      if (!payload.name || !payload.email) {
        setStatus(msgMissing, 'error');
        return;
      }

      submit.disabled = true;
      const submitLabel = submit.querySelector('.pill-cta__label') ?? submit;
      const originalLabel = submitLabel.textContent;
      submitLabel.textContent = sendingLabel;
      setStatus(msgSending, 'info');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = (await response.json().catch(() => ({}))) as { error?: string };

        if (!response.ok) {
          setStatus(result.error || msgGeneric, 'error');
          submit.disabled = false;
          submitLabel.textContent = originalLabel;
          return;
        }

        window.location.href = thankYouPath;
      } catch {
        setStatus(msgNetwork, 'error');
        submit.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(var(--space-5), 4vw, var(--space-7));
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .contact-card { padding: clamp(var(--space-5), 3vw, var(--space-6)); }
  .contact-form-heading { margin-bottom: var(--space-4); }

  .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-4);
  }
  @media (max-width: 600px) {
    .contact-row { grid-template-columns: 1fr; }
  }

  .req { color: #9f2f2d; }

  .hp-field {
    position: absolute !important;
    left: -10000px !important;
    top: auto !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }

  .contact-captcha {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .contact-captcha__row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .contact-captcha__question { font-size: 0.95rem; color: var(--body); }
  .contact-captcha__question strong {
    display: inline-block;
    padding: 2px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
  }
  .contact-captcha__input {
    flex: 0 1 auto;
    min-width: 90px;
    max-width: 140px;
  }

  .contact-status {
    margin: var(--space-4) 0 0;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .contact-status[data-tone='info']    { background: var(--surface-2); color: var(--body); border: 1px solid var(--line); }
  .contact-status[data-tone='success'] { background: #edf3ec; color: #346538; border: 1px solid #d5e2d3; }
  .contact-status[data-tone='error']   { background: #fdebec; color: #9f2f2d; border: 1px solid #f3d2d3; }

  .contact-actions {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .contact-hint { font-size: 0.82rem; }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .contact-info__title { margin-bottom: var(--space-2); }
  .contact-info__block p { margin-bottom: 4px; }
  .contact-info__block p:last-child { margin-bottom: 0; }
  .contact-info__block a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    transition: border-color 200ms ease;
  }
  .contact-info__block a:hover { border-color: var(--ink); }
  .contact-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 18px;
    font-size: 0.92rem;
  }
  @media (max-width: 480px) {
    .contact-links { grid-template-columns: 1fr; }
  }
</style>
