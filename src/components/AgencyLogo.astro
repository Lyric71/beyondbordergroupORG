---
interface Props {
  slug?: string;
  route?: string;
  name: string;
  class?: string;
}

const { slug, route, name, class: className = '' } = Astro.props;

const resolvedSlug = slug ?? (route ? route.split('/').pop() ?? '' : '');

const logos: Record<string, string> = {
  bearingbridge: '/images/thechinapath-horizontal.png',
  beyondbridge: '/AgencyLogos/beyondbridge-logo.png',
  hubstudio: '/AgencyLogos/hubstudio-logo.png',
  chinawebfoundry: '/AgencyLogos/Logo-ChinaWebFoundry-transparent.png',
  'nuvora-studio': '/AgencyLogos/nuvora-studio-logo.webp',
  theredscroll: '/AgencyLogos/theredscroll-logo.svg',
  bearingbridgeai: '/AgencyLogos/BearingBridgeAI-horizontal.svg',
  bbchien: '/AgencyLogos/bbchien-lockup-color.svg',
};

const src = logos[resolvedSlug];
---

{src && (
  <img
    src={src}
    alt={`${name} logo`}
    class={`agency-logo agency-logo--${resolvedSlug} ${className}`}
    loading="lazy"
    decoding="async"
  />
)}

<style>
  .agency-logo {
    display: block;
    object-fit: contain;
    max-width: 100%;
    height: auto;
  }
</style>
