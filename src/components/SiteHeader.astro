---
import { type Locale, type Route, pathFor, t } from '../i18n/ui';
import AgencyLogo from './AgencyLogo.astro';

interface Props {
  locale: Locale;
  current?: string;
}

const { locale, current } = Astro.props;
const ui = t(locale);

type MegaItem = { href: string; title: string; desc: string; logoRoute?: string; icon?: string };

const aiItems: MegaItem[] = [
  { href: pathFor('agencies/bearingbridgeai', locale), title: 'BearingBridge AI', desc: 'AI consulting, evidence over hype.', logoRoute: 'agencies/bearingbridgeai' },
  { href: pathFor('ai-services/intelligence', locale), title: 'Intelligence', desc: 'Our platform, AI at work.', icon: '/AgencyLogos/intelligence-icon.png' },
  { href: pathFor('agencies/hubstudio', locale), title: 'HubStudio', desc: 'Content production at scale.', logoRoute: 'agencies/hubstudio' },
  { href: pathFor('agencies/nuvora-studio', locale), title: 'Nuvora Studio', desc: 'LinkedIn-only B2B.', logoRoute: 'agencies/nuvora-studio' },
];

const cbItems: MegaItem[] = [
  { href: pathFor('agencies/bearingbridge', locale), title: 'TheChinaPath', desc: 'Full-service China entry.', logoRoute: 'agencies/bearingbridge' },
  { href: pathFor('agencies/beyondbridge', locale), title: 'BeyondBridge', desc: 'Chinese brands, Western pipeline.', logoRoute: 'agencies/beyondbridge' },
  { href: pathFor('agencies/chinawebfoundry', locale), title: 'ChinaWebFoundry', desc: 'Websites built for China.', logoRoute: 'agencies/chinawebfoundry' },
  { href: pathFor('agencies/theredscroll', locale), title: 'TheRedScroll', desc: 'Chinese social media.', logoRoute: 'agencies/theredscroll' },
  { href: pathFor('agencies/compass', locale), title: 'Compass', desc: 'Vetted China distributors and TPs.', logoRoute: 'agencies/compass' },
];

const cbAsideItems: MegaItem[] = [
  { href: pathFor('two-flows', locale), title: 'Two flows', desc: 'One bridge, two directions.' },
  { href: pathFor('bridge', locale), title: ui.nav.bridge, desc: ui.nav.bridgeItemDesc },
];

const productItems: MegaItem[] = [
  { href: `${pathFor('products', locale)}#bbchien`, title: 'BBChien', desc: 'Independent French dog media.', logoRoute: 'bbchien' },
  { href: `${pathFor('products', locale)}#deuceladder`, title: 'DeuceLadder', desc: 'In build.' },
];

const groupItems: MegaItem[] = [
  { href: pathFor('the-group', locale), title: 'About us', desc: 'One operator, three practices, one stack.' },
  { href: pathFor('how-we-work', locale), title: ui.nav.howWeWork, desc: ui.nav.howWeWorkItemDesc },
];

const megas: { key: string; label: string; route: Route; lead: string; meta: string; footNote: string; items: MegaItem[]; asideLabel?: string; asideItems?: MegaItem[] }[] = [
  {
    key: 'ai',
    label: 'AI Services',
    route: 'ai-services',
    lead: 'Three teams and one platform. Evidence over hype, Western and Chinese models benchmarked.',
    meta: 'Strategy through production',
    footNote: 'Every team takes clients directly.',
    items: aiItems,
  },
  {
    key: 'cb',
    label: 'Cross-Border Marketing',
    route: 'cross-border-marketing',
    lead: 'Five specialists carrying brands between China and the West, both ways.',
    meta: 'Both directions, every day',
    footNote: 'Every agency takes clients directly.',
    items: cbItems,
    asideLabel: 'The thinking',
    asideItems: cbAsideItems,
  },
  {
    key: 'products',
    label: 'Products',
    route: 'products',
    lead: 'Media and software we own and operate, on the same stack we sell.',
    meta: 'Proof before promises',
    footNote: 'Built and run by the group.',
    items: productItems,
  },
  {
    key: 'group',
    label: 'The group',
    route: 'the-group',
    lead: 'Who is behind the three practices, and how a project actually runs.',
    meta: 'One group, three practices',
    footNote: 'Start with the practice you need.',
    items: groupItems,
  },
];

const activeMega = (key: string): boolean => {
  if (!current) return false;
  if (key === 'ai') return current === 'ai-services' || current.startsWith('ai-services/') || ['agencies/bearingbridgeai', 'agencies/hubstudio', 'agencies/nuvora-studio'].includes(current);
  if (key === 'cb') return current === 'cross-border-marketing' || current === 'agencies' || current === 'bridge' || current === 'two-flows' || ['agencies/bearingbridge', 'agencies/beyondbridge', 'agencies/chinawebfoundry', 'agencies/theredscroll', 'agencies/compass'].includes(current);
  if (key === 'products') return current === 'products';
  if (key === 'group') return current === 'the-group' || current === 'how-we-work';
  return false;
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={pathFor('home', locale)} class="brand" aria-label="BearingBridge">
      <img
        src="/Logo BearingBridge - Horizontal.svg"
        alt="BearingBridge"
        class="brand__logo"
        width="3552"
        height="563"
      />
    </a>

    <nav class="nav-primary" aria-label="Primary">
      <ul class="nav-primary__list">
        {megas.map((m) => (
          <li class="nav-item nav-item--mega">
            <a class="nav-primary__link" href={pathFor(m.route, locale)} aria-haspopup="true" aria-current={activeMega(m.key) ? 'page' : undefined}>
              {m.label}
              <svg class="nav-chev" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 4.5l3 3 3-3" />
              </svg>
            </a>
            <div class="mega" role="menu" aria-label={m.label}>
              <div class="container mega__grid">
                <div class="mega__lead">
                  <div class="mega__lead-text">
                    <h3>{m.label}</h3>
                    <p>{m.lead}</p>
                  </div>
                  <span class="mega__lead-meta">{m.meta}</span>
                </div>
                <div class={`mega__body${m.asideItems ? ' mega__body--split' : ''}`}>
                <div class="mega__items">
                  {m.items.map((item, i) => (
                    <a class={`mega-item${item.logoRoute || item.icon ? ' mega-item--with-logo' : ''}`} href={item.href} style={`--i: ${i}`}>
                      {item.logoRoute ? (
                        <span class="mega-item__logo">
                          <AgencyLogo route={item.logoRoute} name={item.title} />
                        </span>
                      ) : item.icon ? (
                        <span class="mega-item__logo mega-item__logo--lockup">
                          <img class="mega-item__brand-icon" src={item.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />
                          <span class="mega-item__lockup-name">{item.title}</span>
                        </span>
                      ) : (
                        <span class="mega-item__title">{item.title}</span>
                      )}
                      <span class="mega-item__desc">{item.desc}</span>
                      <svg class="mega-item__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 8h10" />
                        <path d="M9 4l4 4-4 4" />
                      </svg>
                    </a>
                  ))}
                </div>
                {m.asideItems && (
                  <aside class="mega__aside">
                    <span class="mega__aside-label">{m.asideLabel}</span>
                    {m.asideItems.map((item) => (
                      <a class="mega-aside-link" href={item.href}>
                        <span class="mega-aside-link__title">
                          {item.title}
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 8h10" />
                            <path d="M9 4l4 4-4 4" />
                          </svg>
                        </span>
                        <span class="mega-aside-link__desc">{item.desc}</span>
                      </a>
                    ))}
                  </aside>
                )}
                </div>
                <div class="mega__footer">
                  <span>{m.footNote}</span>
                  <a class="mega__footer-link" href={pathFor(m.route, locale)}>
                    Open {m.label}
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 8h10" />
                      <path d="M9 4l4 4-4 4" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-right">
      <a href={pathFor('contact', locale)} class="btn btn--primary btn--sm nav-right__cta">{ui.nav.contact}</a>
      <button
        type="button"
        class="nav-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
    </div>
  </div>

  <div class="site-header__progress" aria-hidden="true"></div>
</header>

<nav id="mobile-menu" class="nav-mobile" aria-label="Mobile" hidden>
    <div class="container nav-mobile__inner">
      <ul class="nav-mobile__list">
        {megas.map((m, gi) => (
          <li class="nav-mobile__section" style={`--i: ${gi}`}>
            <span class="nav-mobile__group">{m.label}</span>
            <ul class="nav-mobile__sublist">
              {m.key !== 'group' && (
                <li><a class="nav-mobile__link" href={pathFor(m.route, locale)}>Open {m.label}</a></li>
              )}
              {[...m.items, ...(m.asideItems ?? [])].map((item) => (
                <li>
                  <a class={`nav-mobile__link${item.logoRoute ? ' nav-mobile__link--with-logo' : ''}`} href={item.href}>
                    {item.logoRoute && (
                      <span class="nav-mobile__logo"><AgencyLogo route={item.logoRoute} name={item.title} /></span>
                    )}
                    <span>{item.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}

        <li style="--i: 4">
          <a class="nav-mobile__link nav-mobile__link--cta btn btn--primary" href={pathFor('contact', locale)}>{ui.nav.contact}</a>
        </li>
      </ul>
    </div>
  </nav>

<div class="site-overlay" aria-hidden="true"></div>

<style>
  .mega-item__logo--lockup {
    gap: 10px;
  }
  .mega-item__brand-icon {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .mega-item__lockup-name {
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--bbg-ink);
    white-space: nowrap;
  }
</style>

<script>
  const headerEl = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');

  // Header scroll state — glass intensity, compact mode, scroll-progress var
  if (headerEl) {
    let ticking = false;
    const updateScroll = () => {
      const y = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, y / docHeight)) : 0;
      headerEl.classList.toggle('is-scrolled', y > 8);
      headerEl.style.setProperty('--scroll-progress', String(progress));
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateScroll);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateScroll();
  }

  // Cursor spotlight on every mega card
  document.querySelectorAll<HTMLElement>('.mega-item').forEach((card) => {
    card.addEventListener('mousemove', (event) => {
      const rect = card.getBoundingClientRect();
      const mx = ((event.clientX - rect.left) / rect.width) * 100;
      const my = ((event.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mx', `${mx}%`);
      card.style.setProperty('--my', `${my}%`);
    });
  });

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('is-open', open);
      menu.toggleAttribute('hidden', !open);
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    // Close on link tap inside the drawer
    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('a')) setOpen(false);
    });

    // Close on Escape
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close if window resizes back to desktop
    const mq = window.matchMedia('(min-width: 1025px)');
    mq.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
